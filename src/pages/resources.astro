---
/**
 * /resources (English) — curated reading and citations.
 *
 * Build-time fetch from the wwwGroLabs Supabase project via the shared
 * helper in src/lib/resources-data.ts. The Spanish mirror lives at
 * /es/resources.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import {
  fetchResourceGroups,
  localizedTitle,
  ctaForCategory,
} from '../lib/resources-data';

const groups = await fetchResourceGroups();
const locale = 'en' as const;
---

<BaseLayout
  title="Resources | GroLabs"
  description="The books, articles, and citations that shape how GroLabs thinks about catalog, search, and conversion."
>
  {/* No `reveal` here: this is the page's whole body and on mobile the
      single-column grid is ~21,000px tall, so its max intersection ratio
      (~0.04) never crosses the reveal observer's 0.15 threshold — the
      section would stay at opacity 0 and the page renders blank. */}
  <section class="relative mt-2xl py-2xl bg-canvas overflow-hidden">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Resources
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-xl">
        The reading list
      </h2>

      {
        groups.length === 0 ? (
          <p class="text-secondary-fixed-dim italic">
            New resources are on the way — check back soon.
          </p>
        ) : (
          groups.map(({ category, items }) => (
            <div class="mb-2xl">
              <div class="resource-grid">
                {items.map((item) => (
                  <article class="resource-card">
                    {item.featured_image ? (
                      <a
                        href={item.external_url ?? '#'}
                        target={item.external_url ? '_blank' : undefined}
                        rel={item.external_url ? 'noopener noreferrer sponsored' : undefined}
                        class="resource-card-image-link"
                      >
                        <img
                          src={item.featured_image}
                          alt={localizedTitle(item, locale)}
                          class="resource-card-image"
                          loading="lazy"
                        />
                      </a>
                    ) : (
                      <div class="resource-card-image resource-card-image--placeholder" aria-hidden="true">
                        <span>{category.icon ?? '·'}</span>
                      </div>
                    )}
                    <div class="resource-card-body">
                      <h4 class="resource-card-title">{localizedTitle(item, locale)}</h4>
                      {item.author && (
                        <p class="resource-card-author">{item.author}</p>
                      )}
                      <div class="resource-card-meta">
                        {item.year && <span>{item.year}</span>}
                        {item.rating != null && (
                          <span class="resource-card-rating">★ {Number(item.rating).toFixed(1)}</span>
                        )}
                      </div>
                      {item.external_url && (
                        <a
                          href={item.external_url}
                          target="_blank"
                          rel="noopener noreferrer sponsored"
                          class="resource-card-link"
                        >
                          {ctaForCategory(category.slug, locale)} →
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>

<style is:global>
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 16px;
  }
  @media (min-width: 640px) {
    .resource-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .resource-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .resource-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .resource-card {
    background: #131316;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .resource-card:hover {
    border-color: rgba(250, 225, 148, 0.25);
    transform: translateY(-2px);
  }

  .resource-card-image-link {
    display: block;
    line-height: 0;
  }
  .resource-card-image {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: #0e0e11;
    display: block;
  }
  .resource-card-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(250, 225, 148, 0.35);
    font-size: 48px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .resource-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .resource-card-title {
    color: #EDEAE0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  .resource-card-author {
    color: rgba(237, 234, 224, 0.6);
    font-size: 13px;
    margin: 0;
  }
  .resource-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: rgba(237, 234, 224, 0.45);
    letter-spacing: 0.05em;
    margin-top: 4px;
  }
  .resource-card-rating {
    color: rgba(250, 225, 148, 0.7);
  }
  .resource-card-link {
    margin-top: auto;
    padding-top: 12px;
    color: #fae194;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 180ms;
  }
  .resource-card-link:hover {
    color: #ffffff;
  }
</style>
