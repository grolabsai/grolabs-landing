  <script is:inline>
    // Load the desktop or the simplified mobile animation per viewport, and
    // size the iframe to whichever one reports its height.
    (function () {
      var frame = document.querySelector('.rre-frame');
      if (!frame) return;
      var mq = window.matchMedia('(max-width: 1000px)');
      var current = null;
      function pick() {
        var want = mq.matches ? frame.dataset.srcMobile : frame.dataset.srcDesktop;
        if (want !== current) { current = want; frame.style.height = ''; frame.src = want; }
      }
      pick();
      if (mq.addEventListener) mq.addEventListener('change', pick);
      else if (mq.addListener) mq.addListener(pick);
      window.addEventListener('message', function (e) {
        var d = e.data;
        if (d && d.type === 'rre-height' && typeof d.height === 'number') {
          // grow-only: settle to the tallest state once, then stay put so the
          // page below doesn't reflow as the table empties/refills each loop.
          var h = Math.max(320, d.height);
          var cur = parseInt(frame.style.height, 10) || 0;
          if (h > cur) frame.style.height = h + 'px';
        }
      });
      // Play when the iframe scrolls into the REAL viewport. The animation
      // can't reliably self-start: an IntersectionObserver inside an iframe
      // measures against the iframe's own viewport on iOS, which made it
      // play on page load instead of on sight.
      var playSent = false;
      function sendPlay() {
        if (frame.contentWindow) frame.contentWindow.postMessage({ type: 'rre-play' }, '*');
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting && !playSent) { playSent = true; sendPlay(); io.disconnect(); }
          });
        }, { threshold: 0.15 });
        io.observe(frame);
      } else {
        playSent = true;
        frame.addEventListener('load', sendPlay);
      }
      // If the iframe (re)loads after the trigger fired — lazy load finishing
      // late, or the desktop/mobile src swap — start the fresh document too.
      frame.addEventListener('load', function () {
        if (playSent) setTimeout(sendPlay, 60);
      });

      // Replay button → tell the animation iframe to restart from the beginning.
      var replay = document.querySelector('[data-rre-replay]');
      if (replay) replay.addEventListener('click', function () {
        if (frame.contentWindow) frame.contentWindow.postMessage({ type: 'rre-replay' }, '*');
      });
    })();
  </script>

