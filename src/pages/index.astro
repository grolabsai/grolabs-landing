---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeakCard from '../components/LeakCard.astro';
import SearchDemo from '../components/SearchDemo.astro';
import SearchCopyHelper from '../components/SearchCopyHelper.astro';
import HowWeDoItDiagram from '../components/HowWeDoItDiagram.astro';
import EquationCard from '../components/EquationCard.astro';
import CapabilityCard from '../components/CapabilityCard.astro';
import FunnelStageRow from '../components/FunnelStageRow.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout>
  <!-- Hero Section. Height is content-driven (no viewport-relative min-h)
       so the stats section below sits at a fixed page offset regardless
       of how tall the browser window is. -->
  <section
    class="relative px-margin-mobile md:px-margin-desktop pt-3xl pb-2xl overflow-hidden flex flex-col items-center text-center"
  >
    <div id="particles-container"></div>

    <div class="relative z-10 max-w-5xl reveal active">
      <h1
        class="font-marker text-page-title-mobile md:text-hero text-white leading-tight drop-shadow-2xl"
      >
        Recover <span class="text-primary">lost revenue</span><br />
        &amp;<br />
        <span class="text-[0.92em]"><span class="text-primary">grow</span> your business</span><br />
        <span class="font-typewriter text-white text-[0.4em]">
          without paying for more traffic
        </span>
      </h1>

      <div class="flex flex-wrap justify-center gap-md mt-xl">
        <a href="mailto:hello@grolabs.ai" class="hero-btn hero-btn--primary hero-btn--text-only shimmer-btn">
          Start a conversation
        </a>
      </div>
    </div>
  </section>

  <!-- Yellow band that the stats cards straddle. -->
  <div class="hero-stats-band"></div>

  <!-- Leak Numbers Section — cards pulled up over the yellow glow band.
       The .stats-section-surface wraps the grid so the 5 cards read as
       one distinct element rather than floating loose on the canvas. -->
  <section class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop stats-overlap">
    <div class="stats-section-surface">
    <div class="grid grid-cols-1 md:grid-cols-6 lg:grid-cols-12 gap-lg">
      <LeakCard
        variant="featured"
        title="Internal site search"
        statValue="2–3×"
        icon="search"
        description={`&ldquo;Users who search convert 2&ndash;3&times; more often than those who don't&mdash;<span class="text-primary">if they find what they want</span>.&rdquo;`}
      />
      <LeakCard
        title="SEO"
        statValue="53%"
        icon="search"
        description="More than half of all organic traffic is lost to poor catalog data. SEO optimization results will always be limited by the info provided by the product catalog."
      />
      <LeakCard
        title="Cart abandonment"
        statValue="70%"
        icon="shopping_cart"
        description="Cart abandonment is largely due to registration that requires email and password."
      />
      <LeakCard
        title="Returns"
        statValue="17–20%"
        icon="arrow_back"
        description="Revenue lost to returns caused by imprecise results from keyword searches."
      />
      <LeakCard
        variant="emerging"
        title="AEO"
        statValue="25%"
        icon="search"
        description={`AI-agent-powered answers will increase 25% by the end of 2026 &mdash; the SEO of the modern era of <span class="text-primary">ChatGPT</span>, <span class="text-primary">Claude</span>, <span class="text-primary">Gemini</span>, etc.`}
      />
    </div>
    <!-- Footer note — deliberately subtle. No surface, no border,
         no icon chip; just an info glyph + dimmer copy that spans the
         full width of the stats surface for anyone curious enough to
         read it. -->
    <div class="reveal mt-xl flex items-start gap-md group cursor-default">
      <span class="material-symbols-outlined icon-inline-sm text-primary flex-shrink-0 mt-1">info</span>
      <div>
        <h4 class="font-label-caps text-label-caps text-zinc-500 group-hover:text-white transition-colors mb-1">A NOTE ON THESE NUMBERS</h4>
        <p class="font-mono text-meta-sm text-zinc-600 group-hover:text-white transition-colors leading-tight">
          These benchmarks represent industry averages for mid-market merchants. While your specific
          "leakage" may vary, the compound effect of solving just two of these points often results
          in a 15–20% immediate lift in Net Revenue.
        </p>
      </div>
    </div>
    </div>
  </section>

  <!-- Revenue equation section. Background is canvas-deeper (~4% darker
       than canvas) so it reads as a distinct section via tonal step,
       not a hard divider line. mt-3xl + py-3xl give ~320 px from the
       previous section's last element to this section's title — twice
       the original 2xl breathing room, per design feedback. -->
  <section id="revenue-equation" class="relative mt-3xl py-3xl bg-canvas-deeper overflow-hidden">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <!-- Title block — left-aligned to match the other section headers
           (Funnel benchmark, AI-assisted modules, etc.). -->
      <div class="mb-2xl">
        <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
          Revenue uplift
        </span>
        <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-md">
          More money in your pocket
        </h2>
        <p class="text-zinc-400 max-w-xl text-lg leading-relaxed">
          Either increase traffic or increase conversion, right?
          <span class="text-primary">We specialize in conversion.</span>
        </p>
      </div>

      <!-- Equation row — Traffic + Conversion flex 50/50, Revenue fixed
           narrow. All three stretch to the tallest card's height. -->
      <div
        id="equation-container"
        class="flex items-stretch gap-6 w-full transition-all duration-700 ease-out"
      >
        <EquationCard icon="groups" label="Traffic">
          <p>We don't run your ads or generate leads, but we will:</p>
          <ul>
            <li>More <span class="text-primary">SEO</span> traffic, from richer product data.</li>
            <li>More <span class="text-primary">AI agent referrals</span>, from making your store agent-ready.</li>
          </ul>
        </EquationCard>
        <div class="equation-operator">×</div>
        <EquationCard icon="percent" label="Conversion">
          <p>We lift conversion at the three points where it usually breaks:</p>
          <ul>
            <li><span class="text-primary">Search</span> that finds what customers actually asked for.</li>
            <li><span class="text-primary">Catalog</span> data rich enough to make search work — managed for you, not by you.</li>
            <li><span class="text-primary">Checkout</span> without the account-creation wall.</li>
          </ul>
        </EquationCard>
        <div class="equation-operator">=</div>
        <EquationCard size="compact" icon="attach_money" label="Revenue">
          <p>It's a bit more complicated than this, but we'll simplify it for illustration purposes.</p>
        </EquationCard>
      </div>
    </div>
  </section>

  <!-- Funnel Benchmark / Revenue leaks. Sits on the lighter canvas bg
       so it alternates with the canvas-deeper Revenue uplift section
       above and the canvas-deeper How section below. Inner blocks
       (scenario + funnel) go canvas-deeper to invert the contrast. -->
  <section class="relative mt-2xl py-2xl bg-canvas overflow-hidden reveal">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="mb-xs grid grid-cols-1 lg:grid-cols-2 gap-xl items-start">
      <div>
        <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
          Conversion Funnel
        </span>
        <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-md">Revenue leaks</h2>
        <p class="text-body-lg text-secondary-fixed-dim">
          We have identified the most likely causes of lost revenue at each stage. These are
          general e-commerce standard percentages, but you can change the values in order to
          assess your particular situation.
        </p>
      </div>
      <div class="bg-canvas-deeper border border-white/5 rounded-xl p-xl">
        <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
          Scenario
        </span>
        <p class="text-body-lg text-secondary-fixed-dim leading-relaxed">
          The funnel below uses the numbers most of our customers walk in with:
          <span class="text-primary">5,000 monthly sessions</span> at a
          <span class="text-primary">$100 AOV</span>. Catalog managed in Excel or the
          WooCommerce admin. Default search. Standard email-and-password checkout.
          GA4 installed, but never monitored.
        </p>
      </div>
    </div>
    <div class="bg-canvas-deeper border border-white/5 p-md md:p-xl rounded-xl mb-xl flex flex-col overflow-hidden">
      <div id="funnel-root" class="w-full overflow-x-auto"></div>

      <div class="mt-md flex gap-xl items-stretch">
        <table class="text-left text-body-sm flex-shrink-0">
          <thead>
            <tr class="border-b border-white/10">
              <th class="py-md pr-xl font-label-caps text-zinc-400 text-meta-sm leading-tight align-bottom">
                FUNNEL<br />STAGE
              </th>
              <th class="py-md pr-xl font-label-caps text-error-red text-meta-sm leading-tight align-bottom text-left">
                LOST<br />REVENUE
              </th>
              <th class="py-md pr-xl font-label-caps text-white text-meta-sm leading-tight align-bottom text-left">
                RECOVERY<br />POTENTIAL
              </th>
              <th class="py-md font-label-caps text-success-emerald text-meta-sm leading-tight align-bottom text-left">
                RECOVERY<br />POTENTIAL
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-zinc-200">
            {/* recoveryAmount values are placeholders until the scenario math (sessions × AOV × recovery %) is finalized. */}
            <FunnelStageRow stageId="search"   icon="search"         label="Search"        loss="65%" recovery="+25%" recoveryAmount="+$1,250" />
            <FunnelStageRow stageId="browsing" icon="grid_view"      label="Browsing"      loss="75%" recovery="+30%" recoveryAmount="+$1,500" />
            <FunnelStageRow stageId="pdp"      icon="description"    label="Product page"  loss="80%" recovery="+25%" recoveryAmount="+$1,250" />
            <FunnelStageRow stageId="cart"     icon="shopping_cart"  label="Cart"          loss="70%" recovery="+20%" recoveryAmount="+$1,000" />
            <FunnelStageRow stageId="checkout" icon="payments"       label="Checkout"      loss="17%" recovery="+7%"  recoveryAmount="+$350"   />
          </tbody>
        </table>

        <div id="funnel-info" class="funnel-info flex-1">
          <div class="funnel-info-default">
            <span class="material-symbols-outlined">touch_app</span>
            <span>Hover any stage to see what typically causes drop-offs there.</span>
          </div>
          <div class="funnel-info-content">
            <div class="funnel-info-eyebrow">
              <span class="material-symbols-outlined" data-info-icon>info</span>
              <span>Drop-off drivers</span>
            </div>
            <div class="funnel-info-title" data-info-title></div>
            <div class="funnel-info-body" data-info-body></div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- Section spacing standard (use these on every new full-width section):
         bg-canvas (lighter):       mt-2xl py-2xl  → mt blends with body bg
                                                     (canvas), so mt + py read
                                                     as ~160px of continuous
                                                     canvas around content.
         bg-canvas-deeper (darker): mt-2xl py-3xl  → mt is canvas (different
                                                     from section bg), so only
                                                     py counts as "in-section"
                                                     space. py-3xl ≈ 160px
                                                     matches the lighter
                                                     section's perceived feel.
       Keep this calibration so all sections look balanced regardless of bg. -->

  <!-- How we do it. The architectural insight: search and catalog are
       one problem, monitored by an AI agent. Opener → diagram → closing
       paragraph + bullet list. -->
  <section class="relative mt-2xl py-3xl bg-canvas-deeper overflow-hidden reveal">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        How we do it?
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-lg">
        Optimize catalog &amp; search engine
      </h2>

      <!-- Two-column lede with a vertical divider in the middle. -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-xl items-start mb-2xl">
        <p class="text-secondary-fixed-dim text-body-md leading-relaxed">
          Most stores tackle discoverability customizing the search engine
          and enhancing product data separately.
        </p>
        <p class="text-primary text-body-lg leading-relaxed md:border-l md:border-white/10 md:pl-xl">
          GroLabs combines both into a single optimization layer.
        </p>
      </div>

      <HowWeDoItDiagram />
    </div>
  </section>

  <!-- Entrepreneurs' Priority / Grow a company. Two-column layout
       where the LEFT column carries the entire section header +
       narrative; the RIGHT column hosts the phone-notification SVG
       starting at the same top edge so the phone visually aligns with
       the eyebrow. -->
  <section class="relative mt-2xl py-2xl bg-canvas overflow-hidden reveal">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-xl items-start">
        <!-- LEFT: eyebrow + title + Gerber quote + monitoring paragraph +
             new no-news / if-needed line -->
        <div class="text-secondary-fixed-dim text-body-md leading-relaxed">
          <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
            Entrepreneurs' Priority
          </span>
          <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-xl">
            Grow a company
          </h2>

          <blockquote class="border-l border-primary/30 pl-md mb-xl">
            <p class="text-white text-body-lg italic leading-snug mb-sm">
              &ldquo;Most entrepreneurs fail because they're working
              <span class="text-primary font-medium not-italic">in their business</span>
              rather than
              <span class="text-primary font-medium not-italic">on their business</span>.&rdquo;
            </p>
            <footer class="text-body-sm text-zinc-500 not-italic">
              — Michael Gerber, <cite class="not-italic">The E-Myth Revisited</cite>
            </footer>
          </blockquote>

          <p class="mb-md">
            Monitoring funnels. Hunting leaks. Reading GA4 at midnight. Every
            hour you spend in the dashboard is an hour you're not spending on
            the company — on the strategy, the team, the next product, the
            partnerships only you can build.
          </p>

          <p>
            <span class="text-primary font-medium">No news = good news.</span>
            <span class="text-white">If something requires your attention, we'll let you know.</span>
          </p>
        </div>

        <!-- RIGHT: phone notification mockup. align-self-start (default
             via items-start on the grid) so the top of the phone lines
             up with the eyebrow on the left. max-width caps the
             rendered phone size so the SVG doesn't dominate at wide
             viewports. -->
        <div class="flex justify-center lg:justify-end">
          <img
            src={`${base}/agent-notification.svg`}
            alt="GroLabs push notification: Hello Peter, I'm afraid traffic dropped 6% yesterday. With a More info link."
            class="w-full max-w-[180px] h-auto"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Try it out / Attribute Match Visibility. Live Meilisearch demo
       against the `demo` index — 4 snack bars with a deliberate
       data-quality gradient (3/3, 2/3, 1/3, 0/3 matches against the
       gluten-free + sugar-free + dairy-free trio). The 0/3 product is
       the punchline: it IS all three things, but the merchant never
       tagged it, so search can't surface it by attribute. -->
  <section class="relative mt-2xl py-3xl bg-canvas-deeper overflow-hidden reveal">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Try it out
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-lg">
        Attribute Match Visibility
      </h2>

      <!-- Copy-to-clipboard helper. Sits between the title and the
           two-column grid so the action ("copy these criteria") reads
           as part of the section intro, and the "↓ paste into the
           search box" feedback points naturally at the panel below. -->
      <SearchCopyHelper />

      <!-- Two-column layout: search panel on the left (wider), narrative
           paragraph on the right (narrower). Stacks on mobile. -->
      <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-xl items-start">
        <SearchDemo />

        <div class="text-secondary-fixed-dim text-body-md leading-relaxed">
          <p>
            Search only finds what your catalog says is there. Three of these
            four bars match the dietary keywords above; the fourth qualifies on
            every count but was never tagged — so Meilisearch can't see it.
          </p>
          <p class="mt-md">
            That last row is the GroLabs sales pitch in one line: catalog
            quality is the ceiling on search quality. We fix the ceiling.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* AI-assisted modules / Tech stack — HIDDEN per latest spec. The
      capability card set is preserved below inside `false && (…)` so
      the markup is intact for when we bring this back; nothing renders
      to the page until that guard flips to true (or gets removed). */}
  {false && (
  <section class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop mt-3xl relative reveal">
    <div class="mb-2xl">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Tech stack
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-md">AI-assisted modules</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md">
      <CapabilityCard
        icon="inventory_2"
        title="Product catalog enhancement"
        description="Audit every product for missing attributes, weak descriptions, and broken images. AI-generated copy and metadata match your brand voice while respecting category rules. Continuous quality scoring surfaces problems before customers ever notice them."
      />
      <CapabilityCard
        icon="search_check"
        title="Enhanced search"
        description="Synonym expansion, typo tolerance, and brand-aware ranking out of the box. Merchandisers promote stock, new arrivals, and sale items with inline boost rules. Sub-50 ms response times even on catalogs north of one million products."
      />
      <CapabilityCard
        icon="bolt"
        title="Fast checkout"
        description="One-tap checkout that remembers shipping, payment, and address. The average flow collapses from seven form fields to a single confirm screen. Mobile abandonment falls 40–60% in the first week of release."
      />
      <CapabilityCard
        icon="auto_awesome"
        title="Agentic search"
        description="AI agents understand shopper intent, not just keywords. Conversational follow-ups progressively refine the result set. Every answer plugs into your catalog so the recommendations reflect your store's actual stock and brand voice."
      />
      <CapabilityCard
        icon="monitoring"
        title="Traffic monitor"
        description="Daily GA4 snapshots with anomaly detection on every traffic source. Alerts fire the moment a channel, campaign, or geo deviates from your baseline. One dashboard ties sessions, conversions, and revenue back to the funnel that produced them."
      />
      <CapabilityCard
        icon="person_search"
        title="User analytics tracking"
        description="First-party event capture for clicks, searches, filters, and conversions — all stored in your stack. Per-shopper journeys show the full path before a purchase, not just last-click. Anonymized cohort exports feed retargeting, lookalike, and loyalty models."
      />
      <CapabilityCard icon="track_changes" title="Diagnose · Fix · Verify">
        <div>
          <span class="font-button-text text-zinc-200">Diagnose.</span>
          Pinpoint where revenue is leaking with funnel data + analytics — no more vague hunches.
        </div>
        <div>
          <span class="font-button-text text-zinc-200">Fix.</span>
          Apply a targeted change at the specific stage that's losing customers.
        </div>
        <div>
          <span class="font-button-text text-zinc-200">Verify.</span>
          Re-measure within hours; the loop reopens automatically if the fix didn't hold.
        </div>
      </CapabilityCard>
      <CapabilityCard
        icon="notifications_active"
        title="Automated monitoring &amp; alerts"
        description="Real-time anomaly detection across every funnel stage and traffic source. Alerts route to Slack, email, or your incident tool of choice within seconds of a deviation. Threshold rules tune per stage, channel, device, and geo segment."
      />
      <CapabilityCard
        icon="smart_toy"
        title="AI catalog &amp; pricing"
        description="AI proposes product copy, attribute fills, and category mappings — you approve before anything ships. Pricing rules adapt to competitor moves and inventory levels in real time. Manual overrides on every recommendation; never autopilot without you."
      />
    </div>
  </section>
  )}

</BaseLayout>
