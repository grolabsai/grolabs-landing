      <script is:inline define:vars={{ bookingUrl }}>
        (function() {
        let mounted = false;

        function buildEmbedUrl(base) {
          const d = new Date();
          const yyyy = d.getFullYear();
          const mm = String(d.getMonth() + 1).padStart(2, '0');
          const dd = String(d.getDate()).padStart(2, '0');
          const sep = base.includes('?') ? '&' : '?';
          return base
            + sep
            + 'background_color=131316'    // dark widget bg — contrasts with the yellow section
            + '&text_color=EDEAE0'          // cream/white body text
            + '&primary_color=fae194'       // brand yellow for accents + buttons
            + '&hide_event_type_details=1'
            + '&hide_landing_page_details=1'
            + '&hide_gdpr_banner=1'
            + `&month=${yyyy}-${mm}`
            + `&date=${yyyy}-${mm}-${dd}`;
        }

        function mountWidget() {
          const section = document.getElementById('booking-embed');
          const mount = document.getElementById('booking-mount');
          if (!section || !mount) return;
          section.hidden = false;
          if (!mounted && window.Calendly && Calendly.initInlineWidget) {
            Calendly.initInlineWidget({
              url: buildEmbedUrl(bookingUrl),
              parentElement: mount,
            });
            mounted = true;
          }
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.addEventListener('click', function (e) {
          const link = e.target.closest('[data-booking-cta]');
          if (!link) return;
          if (!window.Calendly || !Calendly.initInlineWidget) return;
          e.preventDefault();
          mountWidget();
        });

        // Calendly posts an `iframe_height` event whenever its content
        // reflows. Mirror that height into the mount, capped at
        // MAX_EMBED_HEIGHT so trailing whitespace stays clipped.
        window.addEventListener('message', function (e) {
          if (!e || !e.data || typeof e.origin !== 'string') return;
          if (!e.origin.endsWith('.calendly.com') && e.origin !== 'https://calendly.com') return;
          const data = e.data;
          const evt = (data && data.event) || '';
          const height =
            (data.payload && (data.payload.height || data.payload.iframeHeight)) ||
            data.height ||
            data.iframeHeight;
          if (!height || typeof height !== 'number') return;
          if (!/iframe.?height|page_height|resize/i.test(evt) && !data.height) return;
          const mount = document.getElementById('booking-mount');
          if (!mount) return;
          const MAX_EMBED_HEIGHT = 760;
          mount.style.height = Math.min(height, MAX_EMBED_HEIGHT) + 'px';
