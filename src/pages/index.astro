---
/**
 * GroLabs landing — English homepage.
 *
 * ⚠️ Design tokens (colors, fonts, sizes, spacing, components) come
 * from docs/STYLEGUIDE.md. Read it before introducing any new visual
 * choice. Visual mirror: docs/style-guide.html.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchDemo from '../components/SearchDemo.astro';
import SearchCopyHelper from '../components/SearchCopyHelper.astro';
import DiagnosticWidget from '../components/DiagnosticWidget.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Gate the whole video section (heading + player) on the env var so an
// unconfigured environment never renders an empty titled section.
const hasVideo = !!import.meta.env.PUBLIC_CF_STREAM_URL;

/**
 * Booking provider toggle. Flip `provider` between 'cal' and 'calendly'
 * to swap embeds without removing either's code path. The unused
 * provider's script + click handler are gated behind a conditional
 * below, so only one is shipped to the browser at a time.
 */
const provider = 'cal' as 'cal' | 'calendly';

// Calendly config — preserved intact for easy revert (set provider above).
const calendlyUrl =
  import.meta.env.PUBLIC_BOOKING_URL ||
  'https://calendly.com/grolabs-15min-free-growth-assesment/30min';

// Cal.com config.
const calLink = 'tuncho-granados-uibzst/15min';
const calUrl = `https://cal.com/${calLink}`;

// CTA's href — used as both the visible link and a graceful fallback
// for visitors with JS disabled (or before embed.js finishes loading).
const bookingUrl = provider === 'cal' ? calUrl : calendlyUrl;
const bookingIsExternal = bookingUrl.startsWith('http');
---

<BaseLayout>
  {/* Page-level JSON-LD: Service + FAQPage. Service describes the
      Growth Assessment Call as a bookable offering (with the Cal.com
      URL as a potentialAction). FAQPage marks up each stat card as
      a Question/Answer pair so answer engines can quote them with
      attribution. */}
  <Fragment slot="head-extra">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Growth Assessment Call",
      "description": "Free 15-minute growth assessment call. We walk through your storefront together and point out the biggest revenue leaks at the search, product page, and checkout stages.",
      "provider": { "@type": "Organization", "name": "GroLabs", "url": "https://grolabs.ai" },
      "areaServed": "Worldwide",
      "serviceType": "E-commerce growth consultation",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
      "potentialAction": {
        "@type": "ReserveAction",
        "target": "https://cal.com/tuncho-granados-uibzst/15min",
        "result": { "@type": "Reservation", "name": "Growth Assessment Call" }
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does site search lift conversion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Users who search on a storefront convert 2–3× more often than visitors who don't search — but only if they find what they want. Site search drives a measurable conversion uplift when paired with rich catalog data and a search engine that understands shopper intent."
          }
        },
        {
          "@type": "Question",
          "name": "How much revenue do product pages lose to drop-off?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "14–23% of product page visits end without an add-to-cart on mid-market e-commerce stores. The most common causes are missing product details (sizing, materials, compatibility) and unclear primary imagery — both of which can be addressed at the catalog layer."
          }
        },
        {
          "@type": "Question",
          "name": "How many returns are caused by mismatched expectations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "19–24% of returns on mid-market e-commerce stores trace to mismatched expectations — the product itself was fine, but the shopper expected something different than what arrived. The root cause is usually incomplete product data and discovery issues that surface the wrong product to the wrong shopper."
          }
        }
      ]
    })} />
  </Fragment>

  {/* Header-anchored CTAs. Hidden by default; an IntersectionObserver
      at the bottom of this page reveals them when the hero CTA row
      scrolls out of view. Same Book primary + Contact ghost pair as
      the hero. */}
  <Fragment slot="header-ctas">
    <div id="header-ctas" class="header-ctas" hidden>
      <a
        href="https://cal.com/tuncho-granados-uibzst/15min"
        class="header-cta header-cta--primary cta-button-style"
        target="_blank"
        rel="noopener noreferrer"
        data-booking-cta
      >
        <span class="hidden md:inline">Book growth assessment call</span>
        <span class="md:hidden">Book call</span>
      </a>
      <a
        href="mailto:growth@grolabs.ai"
        class="header-cta header-cta--ghost"
      >
        Contact
      </a>
    </div>
  </Fragment>

  <!-- Hero + Stats (v2) — merged into one viewport. Left column carries
       the headline / tagline / lede / CTAs; right column shows the three
       stat cards. The SEO and AEO cards from v1 have been pulled into a
       separate (future) section and are no longer in the hero. -->
  <section class="hero-v2 relative px-margin-mobile md:px-margin-desktop pt-2xl pb-2xl md:pt-3xl md:pb-3xl overflow-hidden">
    <div id="particles-container"></div>

    <div class="hero-v2-grid max-w-page mx-auto relative z-10 reveal active">
      <div class="hero-v2-copy">
        <h1 class="hero-v2-headline">
          <span class="hero-v2-line">Recover lost revenue</span>
          <span class="hero-v2-line"><span class="hero-v2-amp">&amp;</span> grow your business</span>
        </h1>
        <p class="hero-v2-tagline">Without paying for more traffic</p>
        <p class="hero-v2-lede">
          Yes, it's possible!<br />
          We will help you recover lost revenue and increase sales without paying for more traffic.
        </p>
        <div class="hero-v2-ctas" data-hero-ctas>
          <div class="hero-v2-cta-stack">
            <a
              href={bookingUrl}
              class="hero-v2-btn hero-v2-btn--primary cta-button-style"
              target="_blank"
              rel="noopener noreferrer"
              data-booking-cta
            >
              Book growth assessment call
            </a>
            <span class="hero-v2-cta-note">Free 15-minute call</span>
          </div>
          <button type="button" class="hero-v2-btn hero-v2-btn--video" data-watch-video>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            Watch Video
          </button>
        </div>
      </div>

      <div class="hero-v2-stage">
        <article class="hero-v2-card hero-v2-card--featured">
          <div class="hero-v2-stat">2&ndash;3&times;</div>
          <h3 class="hero-v2-card-title">Search conversion uplift with catalog &amp; search optimization</h3>
          <p class="hero-v2-card-body">
            Users who search convert 2&ndash;3&times; more often than those who don't&mdash;<br>
            <span class="hero-v2-highlight">if they find what they want</span>.
          </p>
        </article>
        <article class="hero-v2-card">
          <div class="hero-v2-stat">14&ndash;23%</div>
          <h3 class="hero-v2-card-title">Product page drop-off</h3>
          <p class="hero-v2-card-body">Shoppers leave product pages without adding to cart due to missing details and unclear information.</p>
        </article>
        <article class="hero-v2-card">
          <div class="hero-v2-stat">19&ndash;24%</div>
          <h3 class="hero-v2-card-title">Returns of perfect products</h3>
          <p class="hero-v2-card-body">Returns linked to mismatched expectations caused by incomplete product data and discovery issues.</p>
        </article>

        {/* Citation under the stat cards. Lives INSIDE .hero-v2-stage
            so it aligns with the cards' left edge, not the hero copy
            column. The "Source" pill + popover will come back once
            specific source URLs are available. */}
        <p class="hero-v2-sources-text">Industry Benchmark — Mid-market e-commerce</p>
      </div>
    </div>
  </section>

  {/* Video — Cloudflare Stream embed, directly below the hero. Carries
      the dark canvas (bg-canvas-deeper) the hidden Revenue-leaks section
      used to own, so the hero→dark alternation rhythm is preserved while
      that section is parked. The whole section (heading included) is
      gated on PUBLIC_CF_STREAM_URL so an unconfigured environment never
      shows an empty titled section. */}
  {hasVideo && (
    <section class="relative py-2xl md:py-3xl px-margin-mobile md:px-margin-desktop bg-canvas-deeper overflow-hidden reveal">
      <div class="max-w-page mx-auto">
        <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-lg block">
          Explainer video
        </span>
        <VideoEmbed
          iframeId="gl-stream-video"
          title="What are revenue leaks?"
        />
      </div>
    </section>
  )}

  <!-- Booking embed — Calendly's inline widget themed yellow + dark to
       match the inverted footer. Hidden by default; revealed when the
       hero CTA is clicked (see the inline script at the bottom of this
       page). The hero CTA also still carries an `href` + target="_blank"
       so the page degrades to "open Calendly in a new tab" if JS fails. -->
  <section id="booking-embed" hidden class="bg-primary pt-xl pb-md md:pt-2xl px-margin-mobile md:px-margin-desktop">
    <div class="max-w-page mx-auto">
      <p class="text-zinc-900 text-body-lg leading-relaxed mb-lg text-center">
        Select the most convenient date and time for our call.
      </p>
      {/* Mount shared by both providers. Cal.com's embed.js auto-resizes
          the iframe to its content, so it just needs a starting
          min-height; Calendly's iframe requires an explicit fixed
          height + overflow:hidden so trailing whitespace gets clipped. */}
      <div
        id="booking-mount"
        style={
          provider === 'cal'
            ? 'min-width:320px; min-height:600px; width:100%;'
            : 'min-width:320px; height:760px; width:100%; overflow:hidden;'
        }
      ></div>
    </div>
  </section>

  <style is:global>
    /* ─────────── Hero v2 — merged hero + stats ─────────── */
    .hero-v2-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 96px;
      align-items: center;
    }
    @media (max-width: 1100px) {
      .hero-v2-grid { grid-template-columns: 1fr; gap: 56px; }
    }

    .hero-v2-headline {
      margin: 0 0 14px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .hero-v2-line {
      font-family: "Permanent Marker", cursive;
      font-weight: 400;
      color: #EDEAE0;
      font-size: clamp(36px, 3.9vw, 54px);
      line-height: 1;
      letter-spacing: 0.005em;
      white-space: nowrap;
    }
    .hero-v2-amp {
      font-size: 0.75em;
      margin-right: 0.08em;
      position: relative; top: -0.02em;
    }

    .hero-v2-tagline {
      font-family: monospace;
      color: #fae194;
      font-size: clamp(12px, 1.4vw, 18px);   /* -2pt again vs prior 14/16/20 clamp */
      line-height: 1.4;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 14px 0 56px;
      white-space: nowrap;
    }

    .hero-v2-lede {
      font-family: "Hanken Grotesk", sans-serif;
      font-size: 20px;
      line-height: 1.55;
      /* Bone-white — was rgba(…, 0.6) which read as gray on the dark
         hero. Solid bone gives the lede the same weight as the rest of
         the hero copy so it reads as primary, not auxiliary. */
      color: #EDEAE0;
      margin: 0 0 32px;
      max-width: 580px;
    }

    /* CTA row — top-align so the Contact ghost sits flush with the top
       of the Book button rather than centering against the (Book + note)
       stack. align-items on the parent + align-self on the ghost is
       belt-and-suspenders so flex-wrap or browser defaults can't push
       the ghost down. */
    .hero-v2-ctas { display: flex; gap: 14px; align-items: flex-start; flex-wrap: wrap; }
    .hero-v2-cta-stack { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 6px; }
    .hero-v2-btn--ghost { align-self: flex-start; }
    .hero-v2-cta-note {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #71717a; /* zinc-500 */
    }
    .hero-v2-btn {
      font-family: "Hanken Grotesk", sans-serif;
      font-weight: 600;
      font-size: 15px;
      padding: 14px 28px;
      border-radius: 8px;
      border: 1px solid transparent;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
      transition: transform .15s, box-shadow .2s, background .2s, color .2s, border-color .2s;
    }
    .hero-v2-btn--primary {
      color: #1A1A1A;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.35),
        0 8px 24px -4px rgba(250,225,148,0.35);
    }

    /* ─────────── Call-to-action button style ───────────
       Reusable yellow gradient (light at top → deeper at bottom).
       Add this class anywhere the primary Book CTA appears so the
       gradient stays visually consistent across the page. The button's
       size/padding/border/shadow live on the host class (.hero-v2-btn,
       .header-cta, etc.); this class only sets the gradient background. */
    .cta-button-style {
      background: linear-gradient(180deg, #fbe9a8 0%, #fae194 55%, #f0d770 100%);
    }
    .hero-v2-btn--primary:hover { transform: translateY(-1px); }
    .hero-v2-btn--ghost {
      background: transparent;
      color: rgba(237, 234, 224, 0.55);
      border-color: rgba(237, 234, 224, 0.35);
    }
    .hero-v2-btn--ghost:hover {
      color: rgba(237, 234, 224, 0.9);
      border-color: rgba(237, 234, 224, 0.6);
    }
    /* "Watch Video" — yellow outline + yellow text, transparent fill.
       Sibling to the primary Book CTA in the hero. */
    .hero-v2-btn--video {
      align-self: flex-start;
      background: transparent;
      color: #fae194;
      border-color: #fae194;
      cursor: pointer;
    }
    .hero-v2-btn--video:hover {
      transform: translateY(-1px);
      background: rgba(250, 225, 148, 0.08);
    }

    /* ─────────── Cards ─────────── */
    .hero-v2-stage {
      width: 100%;
      max-width: 720px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-left: auto;
    }
    .hero-v2-card {
      background: #1c1d24;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 16px;
      padding: 28px;
      box-shadow:
        0 1px 0 rgba(255,255,255,0.05) inset,
        0 2px 4px rgba(0,0,0,0.5),
        0 30px 60px -12px rgba(0,0,0,0.65),
        0 60px 120px -24px rgba(0,0,0,0.55);
    }
    .hero-v2-card--featured { grid-column: 1 / -1; }

    .hero-v2-stat {
      font-family: "Permanent Marker", cursive;
      color: #EDEAE0;
      line-height: 1;
      font-size: 34px;
      margin-bottom: 16px;
    }
    .hero-v2-card-title {
      font-family: monospace;
      color: #fae194;
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 0 0 16px;
      white-space: nowrap;
    }
    .hero-v2-card-body {
      font-family: "Hanken Grotesk", sans-serif;
      color: rgba(237, 234, 224, 0.6);
      font-size: 16px;
      line-height: 1.6;
      margin: 0;
    }
    /* Intentional exception: featured card body runs at 20px. */
    .hero-v2-card--featured .hero-v2-card-body { font-size: 20px; }
    /*
      .hero-v2-highlight — hand-drawn marker.
      Yellow rectangle SVG runs through an feTurbulence + feDisplacementMap
      filter so the edges look like a real brush stroke, not a clean CSS box.
      The #fae194 fill is URL-encoded as %23fae194 because background-image
      data URLs treat # as a fragment boundary.
      box-decoration-break: clone makes multi-line wraps re-paint per line
      so the marker shape stays intentional instead of stretching across
      the line break.
    */
    .hero-v2-highlight {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 40' preserveAspectRatio='none'><defs><filter id='r' x='-5%25' y='-25%25' width='110%25' height='150%25'><feTurbulence type='fractalNoise' baseFrequency='0.045 0.13' numOctaves='2' seed='4'/><feDisplacementMap in='SourceGraphic' scale='5'/></filter></defs><rect x='3' y='6' width='194' height='28' fill='%23fae194' filter='url(%23r)' opacity='0.95'/></svg>");
      background-repeat: no-repeat;
      background-size: 100% 110%;
      background-position: center 52%;
      color: #000000;
      padding: 2px 10px 3px 10px;
      font-weight: 500;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      white-space: nowrap;
    }

    /* Citation line below the three stat cards. Lives inside
       .hero-v2-stage and spans both grid columns, so it aligns with
       the cards' left edge. The Source pill + popover that lived
       here was removed pending real citation URLs; see the markup. */
    .hero-v2-sources-text {
      grid-column: 1 / -1;
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #71717a; /* zinc-500 */
      text-align: left;
      line-height: 1.4;
    }

    @media (max-width: 720px) {
      .hero-v2-stage { grid-template-columns: 1fr; }
      .hero-v2-card--featured { grid-column: auto; }
      .hero-v2-card-title { white-space: normal; }
    }

    /* ─────────── Revenue Leaks — equation card (right column) ──────────
       Same lifted-card treatment as the hero cards: lighter fill on the
       darker section bg + soft drop shadow + 1px inner top highlight. */
    .leak-equation-card {
      background: #1c1d24;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 16px;
      padding: 28px 32px;
      box-shadow:
        0 1px 0 rgba(255,255,255,0.05) inset,
        0 2px 4px rgba(0,0,0,0.5),
        0 30px 60px -12px rgba(0,0,0,0.65),
        0 60px 120px -24px rgba(0,0,0,0.55);
      display: flex;
      flex-direction: column;
      gap: 24px;
      align-self: start;
    }
    .leak-equation {
      display: flex;
      align-items: center;
      gap: 14px;
      font-family: "Permanent Marker", cursive;
      font-weight: 400;
      font-size: 28px;
      color: #EDEAE0;
      text-transform: uppercase;
      line-height: 1.1;
      flex-wrap: wrap;
    }
    .leak-equation-body {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }
    .leak-equation-fraction {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    /* Desktop renders inline: title = fraction × 100, all on one row.
       Mobile (≤768px) breaks the title to its own row and right-aligns
       the equation body underneath for legibility. */
    @media (max-width: 768px) {
      .leak-equation { font-size: 22px; }
      .leak-equation-title { flex: 1 0 100%; }
      .leak-equation-body { margin-left: auto; }
    }
    .leak-equation-num {
      border-bottom: 1px solid rgba(237, 234, 224, 0.6);
      padding: 0 8px 4px;
      white-space: nowrap;
    }
    .leak-equation-den {
      padding-top: 0;
      white-space: nowrap;
    }
    .leak-equation-key {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 0;
    }
    .leak-equation-row {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 16px;
      align-items: baseline;
    }
    .leak-equation-row dt {
      font-family: monospace;
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #fae194;
      font-weight: 400;
    }
    .leak-equation-row dd {
      font-family: monospace;
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #FFFFFF;
      margin: 0;
    }

    /* ─────────── Mobile funnel — vertical 2-col table ──────────
       Replaces the wide SVG funnel on <md viewports. Static (no hover),
       top→bottom. Left column: yellow icon + white stage name. Right
       column: red leak % + uppercase cause label. */
    .funnel-mobile {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    @media (min-width: 768px) {
      .funnel-mobile { display: none !important; }
    }
    .funnel-mobile-row {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: #1c1d24;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 12px;
    }
    .funnel-mobile-stage {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .funnel-mobile-icon {
      color: #fae194;
      font-size: 22px;
      font-variation-settings: 'opsz' 24, 'wght' 400, 'FILL' 0, 'GRAD' 0;
      flex-shrink: 0;
    }
    .funnel-mobile-name {
      font-family: "Hanken Grotesk", sans-serif;
      font-weight: 600;
      font-size: 15px;
      color: #FFFFFF;
    }
    .funnel-mobile-leak {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      gap: 2px;
    }
    .funnel-mobile-pct {
      font-family: "Permanent Marker", cursive;
      font-size: 20px;
      color: #EDEAE0;
      line-height: 1;
    }
    .funnel-mobile-label {
      font-family: monospace;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #a85050;
      line-height: 1.3;
    }

    /* ─────────── Desktop funnel — static HTML ───────────
       Row of 6 stage cards + drop columns underneath + a red leak bar
       with leak % and cause per stage. No interactivity, no SVG, no JS.
       Hidden below md so the existing .funnel-mobile vertical list
       takes over on small screens. */
    .funnel-desktop { display: none; }
    @media (min-width: 768px) {
      .funnel-desktop { display: flex; flex-direction: column; }
    }
    .funnel-stages-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 16px;
    }
    .funnel-stage-card {
      background: #1c1d24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 20px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.05) inset,
        0 2px 4px rgba(0, 0, 0, 0.5),
        0 30px 60px -12px rgba(0, 0, 0, 0.65),
        0 60px 120px -24px rgba(0, 0, 0, 0.55);
    }
    .funnel-stage-icon {
      color: #fae194;
