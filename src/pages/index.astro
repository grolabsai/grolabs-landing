---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchDemo from '../components/SearchDemo.astro';
import SearchCopyHelper from '../components/SearchCopyHelper.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * Booking URL for the hero's "Book Growth Assessment Call" CTA.
 * Defaults to the live Calendly booking page so the button works
 * out-of-the-box in any environment (prod, preview, fresh checkout).
 * Override with PUBLIC_BOOKING_URL in `.env` (or in the Vercel project
 * env settings) if we ever switch providers without redeploying code.
 */
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || 'https://calendly.com/grolabs/15min-free-growth-assesment';
const bookingIsExternal = bookingUrl.startsWith('http');
// When the booking URL is a Calendly link, the page loads Calendly's
// widget script so clicking the CTA opens an inline popup instead of
// navigating away. Falls back to the regular new-tab link if the
// script fails to load or JS is disabled.
const bookingIsCalendly = bookingUrl.includes('calendly.com');
---

<BaseLayout>
  <!-- Hero + Stats (v2) — merged into one viewport. Left column carries
       the headline / tagline / lede / CTAs; right column shows the three
       stat cards. The SEO and AEO cards from v1 have been pulled into a
       separate (future) section and are no longer in the hero. -->
  <section class="hero-v2 relative px-margin-mobile md:px-margin-desktop pt-3xl pb-3xl overflow-hidden">
    <div id="particles-container"></div>

    <div class="hero-v2-grid max-w-page mx-auto relative z-10 reveal active">
      <div class="hero-v2-copy">
        <h1 class="hero-v2-headline">
          <span class="hero-v2-line">Recover lost revenue</span>
          <span class="hero-v2-line"><span class="hero-v2-amp">&amp;</span> grow your business</span>
        </h1>
        <p class="hero-v2-tagline">Without paying for more traffic</p>
        <p class="hero-v2-lede">
          Yes, it's possible. We will help you recover lost revenue and increase
          sales without paying for more traffic.
        </p>
        <div class="hero-v2-ctas">
          <a
            href={bookingUrl}
            class="hero-v2-btn hero-v2-btn--primary"
            target={bookingIsExternal && !bookingIsCalendly ? '_blank' : undefined}
            rel={bookingIsExternal && !bookingIsCalendly ? 'noopener noreferrer' : undefined}
            data-calendly-url={bookingIsCalendly ? bookingUrl : undefined}
          >
            Book Growth Assessment Call
          </a>
          <a href="mailto:growth@grolabs.ai" class="hero-v2-btn hero-v2-btn--ghost">
            Contact
          </a>
        </div>
      </div>

      <div class="hero-v2-stage">
        <article class="hero-v2-card hero-v2-card--featured">
          <div class="hero-v2-stat">2&ndash;3&times;</div>
          <h3 class="hero-v2-card-title">Search conversion uplift with catalog &amp; search optimization</h3>
          <p class="hero-v2-card-body">
            Users who search convert 2&ndash;3&times; more often than those who don't&mdash;<br>
            <span class="hero-v2-highlight">if they find what they want</span>.
          </p>
        </article>
        <article class="hero-v2-card">
          <div class="hero-v2-stat">14&ndash;23%</div>
          <h3 class="hero-v2-card-title">Product page drop-off</h3>
          <p class="hero-v2-card-body">Shoppers leave product pages without adding to cart due to missing details and unclear information.</p>
        </article>
        <article class="hero-v2-card">
          <div class="hero-v2-stat">19&ndash;24%</div>
          <h3 class="hero-v2-card-title">Returns of perfect products</h3>
          <p class="hero-v2-card-body">Returns linked to mismatched expectations caused by incomplete product data and discovery issues.</p>
        </article>
      </div>
    </div>
  </section>

  <style is:global>
    /* ─────────── Hero v2 — merged hero + stats ─────────── */
    .hero-v2-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 96px;
      align-items: center;
    }
    @media (max-width: 1100px) {
      .hero-v2-grid { grid-template-columns: 1fr; gap: 56px; }
    }

    .hero-v2-headline {
      margin: 0 0 14px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .hero-v2-line {
      font-family: "Permanent Marker", cursive;
      font-weight: 400;
      color: #fff;
      font-size: clamp(36px, 3.9vw, 54px);
      line-height: 1;
      letter-spacing: 0.005em;
      white-space: nowrap;
    }
    .hero-v2-amp {
      font-size: 0.75em;
      margin-right: 0.08em;
      position: relative; top: -0.02em;
    }

    .hero-v2-tagline {
      font-family: monospace;
      color: #fae194;
      font-size: clamp(16px, 1.8vw, 22px);
      line-height: 1.4;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 14px 0 56px;
      white-space: nowrap;
    }

    .hero-v2-lede {
      font-family: "Hanken Grotesk", sans-serif;
      font-size: 20px;
      line-height: 1.55;
      color: rgba(237, 234, 224, 0.6);
      margin: 0 0 32px;
      max-width: 580px;
    }

    .hero-v2-ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
    .hero-v2-btn {
      font-family: "Hanken Grotesk", sans-serif;
      font-weight: 600;
      font-size: 15px;
      padding: 14px 28px;
      border-radius: 8px;
      border: 1px solid transparent;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
      transition: transform .15s, box-shadow .2s, background .2s, color .2s, border-color .2s;
    }
    .hero-v2-btn--primary {
      color: #1A1A1A;
      background: #fae194;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.35),
        0 8px 24px -4px rgba(250,225,148,0.35);
    }
    .hero-v2-btn--primary:hover { transform: translateY(-1px); }
    .hero-v2-btn--ghost {
      background: transparent;
      color: rgba(237, 234, 224, 0.55);
      border-color: rgba(237, 234, 224, 0.35);
    }
    .hero-v2-btn--ghost:hover {
      color: rgba(237, 234, 224, 0.9);
      border-color: rgba(237, 234, 224, 0.6);
    }

    /* ─────────── Cards ─────────── */
    .hero-v2-stage {
      width: 100%;
      max-width: 720px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-left: auto;
    }
    .hero-v2-card {
      background: #1c1d24;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 16px;
      padding: 28px;
      box-shadow:
        0 1px 0 rgba(255,255,255,0.05) inset,
        0 2px 4px rgba(0,0,0,0.5),
        0 30px 60px -12px rgba(0,0,0,0.65),
        0 60px 120px -24px rgba(0,0,0,0.55);
    }
    .hero-v2-card--featured { grid-column: 1 / -1; }

    .hero-v2-stat {
      font-family: "Permanent Marker", cursive;
      color: #fff;
      line-height: 1;
      font-size: 34px;
      margin-bottom: 16px;
    }
    .hero-v2-card-title {
      font-family: monospace;
      color: #fae194;
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 0 0 16px;
      white-space: nowrap;
    }
    .hero-v2-card-body {
      font-family: "Hanken Grotesk", sans-serif;
      color: rgba(237, 234, 224, 0.6);
      font-size: 16px;
      line-height: 1.6;
      margin: 0;
    }
    /* Intentional exception: featured card body runs at 20px. */
    .hero-v2-card--featured .hero-v2-card-body { font-size: 20px; }
    .hero-v2-highlight { color: #fff; white-space: nowrap; }

    @media (max-width: 720px) {
      .hero-v2-stage { grid-template-columns: 1fr; }
      .hero-v2-card--featured { grid-column: auto; }
      .hero-v2-card-title { white-space: normal; }
    }
  </style>

  <!-- Funnel Benchmark / Revenue leaks. Dark section per the v2
       alternation (hero light → leaks dark → grow light → try it out
       dark). Inner flow-simulator wrapper inverts to the lighter
       canvas bg so the embedded block still reads as distinct. -->
  <section class="relative mt-2xl py-3xl bg-canvas-deeper overflow-hidden reveal">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="mb-xs">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Conversion Funnel
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-md">Revenue leaks</h2>
      <p class="text-body-lg text-secondary-fixed-dim max-w-3xl">
        We have identified the most likely causes of lost revenue at each stage. These are
        general e-commerce standard percentages, but you can change the values in order to
        assess your particular situation.
      </p>
    </div>
    <div class="bg-canvas border border-white/5 p-md md:p-xl rounded-xl mb-xl flex flex-col overflow-hidden">
      <div id="funnel-root" data-locale="en" class="w-full overflow-x-auto"></div>

      <div class="mt-md flex gap-xl items-stretch">
        <div id="funnel-info" class="funnel-info flex-1">
          <div class="funnel-info-default">
            <span class="material-symbols-outlined">touch_app</span>
            <span>Hover any stage to see what typically causes drop-offs there.</span>
          </div>
          <div class="funnel-info-content">
            <div class="funnel-info-eyebrow">
              <span class="material-symbols-outlined" data-info-icon>info</span>
              <span>Drop-off drivers</span>
            </div>
            <div class="funnel-info-title" data-info-title></div>
            <div class="funnel-info-body" data-info-body></div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- Section spacing standard (use these on every new full-width section):
         bg-canvas (lighter):       mt-2xl py-2xl  → mt blends with body bg
                                                     (canvas), so mt + py read
                                                     as ~160px of continuous
                                                     canvas around content.
         bg-canvas-deeper (darker): mt-2xl py-3xl  → mt is canvas (different
                                                     from section bg), so only
                                                     py counts as "in-section"
                                                     space. py-3xl ≈ 160px
                                                     matches the lighter
                                                     section's perceived feel.
       Keep this calibration so all sections look balanced regardless of bg. -->

  <!-- Entrepreneurs' Priority / Grow a company. Two-column layout
       where the LEFT column carries the entire section header +
       narrative; the RIGHT column hosts the phone-notification SVG
       starting at the same top edge so the phone visually aligns with
       the eyebrow. -->
  <section class="relative mt-2xl py-2xl bg-canvas overflow-hidden reveal">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-xl items-start">
        <!-- LEFT: eyebrow + title + Gerber quote + monitoring paragraph +
             new no-news / if-needed line -->
        <div class="text-secondary-fixed-dim text-body-md leading-relaxed">
          <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
            Entrepreneurs' Priority
          </span>
          <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-xl">
            Grow a company
          </h2>

          <blockquote class="border-l border-primary/30 pl-md mb-xl">
            <p class="text-white text-body-lg italic leading-snug mb-sm">
              &ldquo;Most entrepreneurs fail because they're working
              <span class="text-primary font-medium not-italic">in their business</span>
              rather than
              <span class="text-primary font-medium not-italic">on their business</span>.&rdquo;
            </p>
            <footer class="text-body-sm text-zinc-500 not-italic">
              — Michael Gerber, <cite class="not-italic">The E-Myth Revisited</cite>
            </footer>
          </blockquote>

          <p class="mb-md">
            Monitoring funnels. Hunting leaks. Reading GA4 at midnight. Every
            hour you spend in the dashboard is an hour you're not spending on
            the company — on the strategy, the team, the next product, the
            partnerships only you can build.
          </p>

          <p>
            <span class="text-primary font-medium">No news = good news.</span>
            <span class="text-white">If something requires your attention, we'll let you know.</span>
          </p>
        </div>

        <!-- RIGHT: phone notification mockup. align-self-start (default
             via items-start on the grid) so the top of the phone lines
             up with the eyebrow on the left. max-width caps the
             rendered phone size so the SVG doesn't dominate at wide
             viewports. -->
        <div class="flex justify-center lg:justify-end">
          <img
            src={`${base}/agent-notification.svg`}
            alt="GroLabs push notification: Hello Peter, I'm afraid traffic dropped 6% yesterday. With a More info link."
            class="w-full max-w-[180px] h-auto"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Try it out / Attribute Match Visibility. Live Meilisearch demo
       against the `demo` index — 4 snack bars with a deliberate
       data-quality gradient (3/3, 2/3, 1/3, 0/3 matches against the
       gluten-free + sugar-free + dairy-free trio). The 0/3 product is
       the punchline: it IS all three things, but the merchant never
       tagged it, so search can't surface it by attribute. -->
  <section class="relative mt-2xl py-3xl bg-canvas-deeper overflow-hidden reveal">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Try it out
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-lg">
        Search Demo
      </h2>

      <!-- Copy-to-clipboard helper. Sits between the title and the
           two-column grid so the action ("copy these criteria") reads
           as part of the section intro, and the "↓ paste into the
           search box" feedback points naturally at the panel below. -->
      <SearchCopyHelper />

      <!-- Two-column layout: search panel on the left (wider), feature
           list on the right (narrower). Stacks on mobile. -->
      <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-xl items-start">
        <SearchDemo />

        <!-- Yellow-icon feature list. Material Symbols stand in for
             bullet glyphs; text on the right of each icon. The
             "Attribute match visibility" item carries an extra
             yellow sub-label ("Reduces returns") spelling out the
             outcome. -->
        <ul class="space-y-md">
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">bolt</span>
            <div class="text-white text-body-md leading-relaxed">
              Lightning-fast results
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">check_box</span>
            <div class="text-body-md leading-relaxed">
              <div class="text-white">Attribute match visibility</div>
              <div class="text-primary font-mono text-xs uppercase tracking-[0.18em] mt-1">Reduces returns</div>
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">person</span>
            <div class="text-white text-body-md leading-relaxed">
              Personalized results
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">record_voice_over</span>
            <div class="text-white text-body-md leading-relaxed">
              Semantic search
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">location_on</span>
            <div class="text-white text-body-md leading-relaxed">
              Geo-search
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">spellcheck</span>
            <div class="text-white text-body-md leading-relaxed">
              Typo tolerance &amp; synonyms
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {bookingIsCalendly && (
    <>
      {/* Calendly popup widget — loaded async so it doesn't block the
          critical path. The click handler below intercepts clicks on any
          `[data-calendly-url]` element; if Calendly hasn't loaded yet,
          the default link navigation kicks in as a graceful fallback. */}
      <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
      <script async src="https://assets.calendly.com/assets/external/widget.js"></script>
      <script is:inline>
        document.addEventListener('click', function (e) {
          const link = e.target.closest('[data-calendly-url]');
          if (!link) return;
          const url = link.getAttribute('data-calendly-url');
          if (window.Calendly && url) {
            e.preventDefault();
            window.Calendly.initPopupWidget({ url });
          }
        });
      </script>
    </>
  )}


</BaseLayout>
