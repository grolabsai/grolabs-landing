       Keep this calibration so all sections look balanced regardless of bg. -->

  <!-- Free diagnostic — Prospectos widget. Lives between "Revenue leaks"
       (problem framing) and "Search Demo" (solution preview). The
       diagnostic IS the proof that we can identify revenue leaks in
       any storefront, not just talk about them. Posts to Scout's public
       diagnostic API; redirects to the report on Scout when done. -->
  <!-- Hidden by request — re-enable when ready. -->
  <section class="relative py-2xl md:py-3xl px-margin-mobile md:px-margin-desktop bg-canvas-deeper overflow-hidden reveal hidden">
    <div class="max-w-page mx-auto">
      <DiagnosticWidget locale="en" />
    </div>
  </section>

  <!-- Try it out / Attribute Match Visibility. Live Meilisearch demo
       against the `demo` index — 4 snack bars with a deliberate
       data-quality gradient (3/3, 2/3, 1/3, 0/3 matches against the
       gluten-free + sugar-free + dairy-free trio). The 0/3 product is
       the punchline: it IS all three things, but the merchant never
       tagged it, so search can't surface it by attribute.
       Sits on the lighter canvas bg so the search panel inside it can
       use the floating-card shadow treatment from the hero. -->
  <!-- Search Demo section hidden for now (per request). Remove `hidden` to restore. -->
  <section class="hidden relative py-xl md:py-2xl px-margin-mobile md:px-margin-desktop bg-canvas overflow-hidden reveal">
    <div class="max-w-page mx-auto">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Try it out
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-lg md:mb-[48px]">
        Search Demo
      </h2>

      <!-- Copy-to-clipboard helper. Sits between the title and the
           two-column grid so the action ("copy these criteria") reads
           as part of the section intro, and the "↓ paste into the
           search box" feedback points naturally at the panel below. -->
      <SearchCopyHelper />

      <!-- Two-column layout: search panel on the left (wider), feature
           list on the right (narrower). Stacks on mobile. -->
      <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-xl items-start">
        <SearchDemo />

        <!-- Yellow-icon feature list. Material Symbols stand in for
             bullet glyphs; text on the right of each icon. The
             "Attribute match visibility" item carries an extra
             yellow sub-label ("Reduces returns") spelling out the
             outcome. -->
        <ul class="grid grid-cols-2 gap-md lg:grid-cols-1">
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">bolt</span>
            <div class="text-white text-body-md leading-relaxed">
              Lightning-fast results
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">check_box</span>
            <div class="text-body-md leading-relaxed">
              <div class="text-white">Attribute match visibility</div>
              <div class="text-primary font-mono text-xs uppercase tracking-[0.18em] mt-1">Reduces returns</div>
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">person</span>
            <div class="text-white text-body-md leading-relaxed">
              Personalized results
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">record_voice_over</span>
            <div class="text-white text-body-md leading-relaxed">
              Semantic search
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">location_on</span>
            <div class="text-white text-body-md leading-relaxed">
              Geo-search
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">spellcheck</span>
            <div class="text-white text-body-md leading-relaxed">
              Typo tolerance &amp; synonyms
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Entrepreneurs' Priority / Grow a company. Section header + lede,
       then the animated traffic-monitoring dashboard at FULL section
       width (iframe, transparent so the yellow band shows through;
       auto-plays once on scroll), with a Replay control on the lower
       right below it. -->
  {/* No `reveal` here: this section is tall (~1100px) and the reveal
      observer needs 15% visible + a 1.2s fade — on mobile that reads as a
      huge dead gap after the RRE section. The dashboard iframe has its
      own entrance animation anyway. */}
  <section class="relative py-xl md:py-3xl px-margin-mobile md:px-margin-desktop bg-primary overflow-hidden">
    <div class="max-w-page mx-auto">
      <!-- Eyebrow + title + lede on the yellow surface. -->
      <span class="font-mono tracking-[0.2em] text-xs uppercase mb-4 block text-black font-bold">
        Entrepreneurs' Priority
      </span>
      <h2 class="font-marker uppercase text-black text-3xl md:text-5xl mb-md">
        Grow a company
      </h2>
      <p class="text-black/60 text-body-md md:text-body-lg leading-relaxed mb-lg md:mb-[48px]">
        Business insights, delivered on a need-to-know basis.<br />
        We monitor the signals behind the scenes and notify you only when action is required.
      </p>

      <div class="td-frame-wrap">
        <iframe
          class="td-frame"
          src={`${base}/anim/traffic-dashboard.html`}
          title="Traffic monitoring dashboard — live animation"
          loading="lazy"
          scrolling="no"
        ></iframe>
        <div class="td-replay-row">
          <button type="button" class="td-replay-btn" data-td-replay aria-label="Replay animation">↻ Replay</button>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    /* 3/4 of the section width, centered; full width once the layout
       stacks on smaller screens. */
    .td-frame-wrap { width: 75%; margin: 0 auto; }
    @media (max-width: 1023px) { .td-frame-wrap { width: 100%; } }
    .td-frame {
      width: 100%;
      height: 820px;            /* initial; resized to content via postMessage */
      border: 0;
      display: block;
      background: transparent;   /* transparent → the yellow band shows through */
      color-scheme: light;
    }
    /* Mobile shows one dashboard block (+ the email ending), so the
       fallback height is much shorter; JS resizes to the exact content. */
    @media (max-width: 1023px) { .td-frame { height: 500px; } }
    .td-replay-row { display: flex; justify-content: flex-end; margin-top: 12px; }
    .td-replay-btn {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      color: rgba(0,0,0,0.5);
      background: transparent;
      border: 1px solid rgba(0,0,0,0.25);
      border-radius: 6px;
      padding: 6px 12px;
      cursor: pointer;
      transition: color .15s, border-color .15s;
    }
    .td-replay-btn:hover { color: rgba(0,0,0,0.8); border-color: rgba(0,0,0,0.5); }
  </style>

  <script is:inline>
    // Size the traffic-dashboard iframe to its reported content height,
    // and wire the Replay control.
    (function () {
      var frame = document.querySelector('.td-frame');
      if (!frame) return;
      window.addEventListener('message', function (e) {
        var d = e.data;
        if (d && d.type === 'td-height' && typeof d.height === 'number') {
          frame.style.height = Math.max(320, d.height) + 'px';
        }
      });
      var replay = document.querySelector('[data-td-replay]');
      if (replay) replay.addEventListener('click', function () {
        if (frame.contentWindow) frame.contentWindow.postMessage({ type: 'td-replay' }, '*');
      });
    })();
  </script>

  {provider === 'calendly' && (
    <>
      {/* Calendly inline embed — loaded on demand when the hero CTA is
          clicked. The widget URL carries theme colors so Calendly's own
          calendar renders dark-with-light-text inside our yellow
          section. Today's date is computed at click time so the picker
          lands on the time-slot view for today regardless of when the
          page was last built. If JS fails, the CTA's href + target=_blank
          still opens Calendly in a new tab as a graceful fallback. */}
      <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
      <script async src="https://assets.calendly.com/assets/external/widget.js"></script>
      <script is:inline define:vars={{ bookingUrl }}>
        (function() {
        let mounted = false;

        function buildEmbedUrl(base) {
          const d = new Date();
          const yyyy = d.getFullYear();
          const mm = String(d.getMonth() + 1).padStart(2, '0');
          const dd = String(d.getDate()).padStart(2, '0');
          const sep = base.includes('?') ? '&' : '?';
          return base
            + sep
            + 'background_color=131316'    // dark widget bg — contrasts with the yellow section
            + '&text_color=EDEAE0'          // cream/white body text
            + '&primary_color=fae194'       // brand yellow for accents + buttons
            + '&hide_event_type_details=1'
            + '&hide_landing_page_details=1'
            + '&hide_gdpr_banner=1'
            + `&month=${yyyy}-${mm}`
            + `&date=${yyyy}-${mm}-${dd}`;
        }

        function mountWidget() {
          const section = document.getElementById('booking-embed');
          const mount = document.getElementById('booking-mount');
          if (!section || !mount) return;
          section.hidden = false;
          if (!mounted && window.Calendly && Calendly.initInlineWidget) {
            Calendly.initInlineWidget({
              url: buildEmbedUrl(bookingUrl),
              parentElement: mount,
            });
            mounted = true;
          }
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.addEventListener('click', function (e) {
          const link = e.target.closest('[data-booking-cta]');
          if (!link) return;
          if (!window.Calendly || !Calendly.initInlineWidget) return;
          e.preventDefault();
          mountWidget();
        });

        // Calendly posts an `iframe_height` event whenever its content
        // reflows. Mirror that height into the mount, capped at
        // MAX_EMBED_HEIGHT so trailing whitespace stays clipped.
        window.addEventListener('message', function (e) {
          if (!e || !e.data || typeof e.origin !== 'string') return;
          if (!e.origin.endsWith('.calendly.com') && e.origin !== 'https://calendly.com') return;
          const data = e.data;
          const evt = (data && data.event) || '';
          const height =
            (data.payload && (data.payload.height || data.payload.iframeHeight)) ||
            data.height ||
            data.iframeHeight;
          if (!height || typeof height !== 'number') return;
          if (!/iframe.?height|page_height|resize/i.test(evt) && !data.height) return;
          const mount = document.getElementById('booking-mount');
          if (!mount) return;
          const MAX_EMBED_HEIGHT = 760;
          mount.style.height = Math.min(height, MAX_EMBED_HEIGHT) + 'px';
        });
        })();
      </script>
    </>
  )}

  {provider === 'cal' && (
    <script is:inline define:vars={{ calLink }}>
      (function() {
      // Cal.com embed.js loader (their canonical snippet, lightly
      // formatted). Queues calls until embed.js is loaded.
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else {
              p(cal, ar);
            }
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      Cal("init", "booking", { origin: "https://cal.com" });

      let mounted = false;

      function mountWidget() {
        const section = document.getElementById('booking-embed');
        if (!section) return;
        section.hidden = false;
        if (!mounted) {
          const d = new Date();
          const yyyy = d.getFullYear();
          const mm = String(d.getMonth() + 1).padStart(2, '0');
          const dd = String(d.getDate()).padStart(2, '0');
          Cal.ns.booking("inline", {
            elementOrSelector: "#booking-mount",
            calLink: `${calLink}?date=${yyyy}-${mm}-${dd}`,
            config: { layout: "month_view" },
          });
          Cal.ns.booking("ui", {
            theme: "dark",
            hideEventTypeDetails: true,
            layout: "month_view",
            styles: { branding: { brandColor: "#fae194" } },
          });
          mounted = true;
        }
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      document.addEventListener('click', function (e) {
        const link = e.target.closest('[data-booking-cta]');
        if (!link) return;
        if (!window.Cal) return;
        e.preventDefault();
        mountWidget();
      });
      })();
    </script>
  )}

  {/* Reveal the header CTAs as soon as the hero CTA row scrolls past
      the top of the viewport, and hide them again when it scrolls back
      in. Keeps a Book CTA anchored to the header from any scroll
      position. */}
  <script is:inline>
    (function () {
      const heroCtas = document.querySelector('[data-hero-ctas]');
      const headerCtas = document.getElementById('header-ctas');
      if (!heroCtas || !headerCtas) return;
      const observer = new IntersectionObserver(
        function (entries) {
          headerCtas.hidden = entries[0].isIntersecting;
        },
        { threshold: 0 }
      );
      observer.observe(heroCtas);
    })();
  </script>

</BaseLayout>
