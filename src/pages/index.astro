---
/**
 * GroLabs landing — English homepage.
 *
 * ⚠️ Design tokens (colors, fonts, sizes, spacing, components) come
 * from docs/STYLEGUIDE.md. Read it before introducing any new visual
 * choice. Visual mirror: docs/style-guide.html.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchDemo from '../components/SearchDemo.astro';
import SearchCopyHelper from '../components/SearchCopyHelper.astro';
import DiagnosticWidget from '../components/DiagnosticWidget.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Gate the whole video section (heading + player) on the env var so an
// unconfigured environment never renders an empty titled section.
const hasVideo = !!import.meta.env.PUBLIC_CF_STREAM_URL;

// Explainer-video section hidden per request. Flip back to true to restore it.
const showExplainerVideo = false;

/**
 * Booking provider toggle. Flip `provider` between 'cal' and 'calendly'
 * to swap embeds without removing either's code path. The unused
 * provider's script + click handler are gated behind a conditional
 * below, so only one is shipped to the browser at a time.
 */
const provider = 'cal' as 'cal' | 'calendly';

// Calendly config — preserved intact for easy revert (set provider above).
const calendlyUrl =
  import.meta.env.PUBLIC_BOOKING_URL ||
  'https://calendly.com/grolabs-15min-free-growth-assesment/30min';

// Cal.com config.
const calLink = 'tuncho-granados-uibzst/15min';
const calUrl = `https://cal.com/${calLink}`;

// CTA's href — used as both the visible link and a graceful fallback
// for visitors with JS disabled (or before embed.js finishes loading).
const bookingUrl = provider === 'cal' ? calUrl : calendlyUrl;
const bookingIsExternal = bookingUrl.startsWith('http');
---

<BaseLayout>
  {/* Page-level JSON-LD: Service + FAQPage. Service describes the
      Growth Assessment Call as a bookable offering (with the Cal.com
      URL as a potentialAction). FAQPage marks up each stat card as
      a Question/Answer pair so answer engines can quote them with
      attribution. */}
  <Fragment slot="head-extra">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Growth Assessment Call",
      "description": "Free 15-minute growth assessment call. We walk through your storefront together and point out the biggest revenue leaks at the search, product page, and checkout stages.",
      "provider": { "@type": "Organization", "name": "GroLabs", "url": "https://grolabs.ai" },
      "areaServed": "Worldwide",
      "serviceType": "E-commerce growth consultation",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
      "potentialAction": {
        "@type": "ReserveAction",
        "target": "https://cal.com/tuncho-granados-uibzst/15min",
        "result": { "@type": "Reservation", "name": "Growth Assessment Call" }
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does site search lift conversion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Users who search on a storefront convert 2–3× more often than visitors who don't search — but only if they find what they want. Site search drives a measurable conversion uplift when paired with rich catalog data and a search engine that understands shopper intent."
          }
        },
        {
          "@type": "Question",
          "name": "How much revenue do product pages lose to drop-off?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "14–23% of product page visits end without an add-to-cart on mid-market e-commerce stores. The most common causes are missing product details (sizing, materials, compatibility) and unclear primary imagery — both of which can be addressed at the catalog layer."
          }
        },
        {
          "@type": "Question",
          "name": "How many returns are caused by mismatched expectations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "19–24% of returns on mid-market e-commerce stores trace to mismatched expectations — the product itself was fine, but the shopper expected something different than what arrived. The root cause is usually incomplete product data and discovery issues that surface the wrong product to the wrong shopper."
          }
        }
      ]
    })} />
  </Fragment>

  {/* Header-anchored CTAs. Hidden by default; an IntersectionObserver
      at the bottom of this page reveals them when the hero CTA row
      scrolls out of view. Same Book primary + Contact ghost pair as
      the hero. */}
  <Fragment slot="header-ctas">
    <div id="header-ctas" class="header-ctas" hidden>
      <a
        href="https://cal.com/tuncho-granados-uibzst/15min"
        class="header-cta header-cta--primary cta-button-style"
        target="_blank"
        rel="noopener noreferrer"
        data-booking-cta
      >
        <span class="hidden md:inline">Book growth assessment call</span>
        <span class="md:hidden">Book call</span>
      </a>
      <a
        href="mailto:growth@grolabs.ai"
        class="header-cta header-cta--ghost"
      >
        Contact
      </a>
    </div>
  </Fragment>

  <!-- ============================================================
       Audit hero — headline / tagline / lede / CTAs on the left;
       the audit prompt + URL/email input on the right. (The original
       stat-card hero was removed; this is now the only hero.)
       ============================================================ -->
  <section class="hero-v2 relative px-margin-mobile md:px-margin-desktop pt-xl pb-xl md:pt-3xl md:pb-3xl overflow-hidden" data-hero-audit>
    <div id="particles-container"></div>

    <div class="hero-v2-grid max-w-page mx-auto relative z-10 reveal active">
      <div class="hero-v2-copy">
        <h1 class="hero-v2-headline">
          <span class="hero-v2-line">Recover <span style="color: #fae194">lost revenue</span></span>
          <span class="hero-v2-line"><span class="hero-v2-amp">&amp;</span> grow your business</span>
        </h1>
        <p class="hero-v2-tagline">Without paying for more traffic</p>
        <div class="hero-v2-ctas" data-hero-ctas>
          <div class="hero-v2-cta-stack">
            <a
              href={bookingUrl}
              class="hero-v2-btn hero-v2-btn--primary cta-button-style"
              target="_blank"
              rel="noopener noreferrer"
              data-booking-cta
            >
              Book growth assessment call
            </a>
            <span class="hero-v2-cta-note">Free 15-minute call</span>
          </div>
          <a href="mailto:growth@grolabs.ai" class="hero-v2-btn hero-v2-btn--ghost">Contact</a>
        </div>
      </div>

      <div class="hero-v2-stage-col">
        <div class="hero-v2-stat-box">
          <div class="hero-v2-stat-row">
            <span class="hero-v2-stat-99">99%</span>
            <p class="hero-v2-stat-text">of visitors never become customers<br />in many online stores.</p>
          </div>
          <div class="hero-v2-stat-row">
            <span class="hero-v2-stat-99">1%</span>
            <p class="hero-v2-stat-text">conversion uplift<br />would result in</p>
          </div>
          <div class="hero-v2-stat-row">
            <span class="hero-v2-stat-99 hero-v2-stat-accent">2x</span>
            <p class="hero-v2-stat-sales hero-v2-stat-accent">sales!</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Booking embed — Calendly's inline widget themed yellow + dark to
       match the inverted footer. Hidden by default; revealed when the
       hero CTA is clicked (see the inline script at the bottom of this
       page). The hero CTA also still carries an `href` + target="_blank"
       so the page degrades to "open Calendly in a new tab" if JS fails.
       Placed directly BELOW the hero so booking opens right under the CTA. -->
  <section id="booking-embed" hidden class="bg-primary pt-xl pb-md md:pt-2xl px-margin-mobile md:px-margin-desktop">
    <div class="max-w-page mx-auto">
      <p class="text-zinc-900 text-body-lg leading-relaxed mb-lg text-center">
        Select the most convenient date and time for our call.
      </p>
      {/* Mount shared by both providers. Cal.com's embed.js auto-resizes
          the iframe to its content, so it just needs a starting
          min-height; Calendly's iframe requires an explicit fixed
          height + overflow:hidden so trailing whitespace gets clipped. */}
      <div
        id="booking-mount"
        style={
          provider === 'cal'
            ? 'min-width:320px; min-height:600px; width:100%;'
            : 'min-width:320px; height:760px; width:100%; overflow:hidden;'
        }
      ></div>
    </div>
  </section>

  {/* ============================================================
       GRO Framework — scroll-scrubbed "handwritten" revenue formula.
       The stage (1080×520 design units) sits in a box on the right;
       the section pins (sticky) inside a tall track and scroll
       progress 0→1 draws the annotation layer one stroke at a time
       (see design_handoff_revenue_formula_animation README).
       ============================================================ */}
  <section class="rf-section" data-rf data-screen-label="GRO Framework">
    <div class="rf-track" data-rf-track>
      <div class="rf-pin">
        <div class="rf-inner max-w-page mx-auto">
          <header class="rf-head">
            <span class="rf-eyebrow">How?</span>
            <h2 class="rf-title">GRO Framework</h2>
          </header>

          <div class="rf-grid">
            <div class="rf-copy">
              {/* One concept sentence, broken so each G/R/O verb owns a line. */}
              <p>
                The GRO Framework frees you to<br />
                <span class="rf-cap">G</span>row the business while we<br />
                <span class="rf-cap">R</span>ecover lost revenue and<br />
                <span class="rf-cap">O</span>ptimize the product discovery and conversion engine.
              </p>
            </div>

            <div class="rf-box">
              <div class="rf-stage-wrap" data-rf-wrap>
                <div class="rf-stage" data-rf-stage>
                  <svg class="rf-marks" viewBox="0 0 1080 520" preserveAspectRatio="none" aria-hidden="true">
                    <path id="rfRule1" class="rf-ruleln" pathLength="1" d="M 300 246 C 430 244 560 248 680 245 C 730 244 770 247 800 246" />
                    <path id="rfRule2" class="rf-ruleln" pathLength="1" d="M 300 398 C 430 401 560 396 680 399 C 730 400 770 398 800 398" />
                    <path id="rfArA"   pathLength="1" d="M 230 136 C 150 132 140 200 152 268 C 162 322 196 344 238 352" />
                    <path id="rfArAh1" pathLength="1" d="M 238 352 L 214 346" />
                    <path id="rfArAh2" pathLength="1" d="M 238 352 L 228 330" />
                    <path id="rfArB"   pathLength="1" d="M 230 206 C 128 204 106 262 124 314 C 140 350 196 366 234 360" />
                    <path id="rfArBh1" pathLength="1" d="M 234 360 L 210 355" />
                    <path id="rfArBh2" pathLength="1" d="M 234 360 L 224 338" />
                    <path id="rfArD"   pathLength="1" d="M 248 372 C 214 384 210 410 230 428 C 236 433 243 436 250 436" />
                    <path id="rfArDh1" pathLength="1" d="M 250 436 L 232 431" />
                    <path id="rfArDh2" pathLength="1" d="M 250 436 L 240 419" />
                    <path id="rfCirc1" class="rf-circle" pathLength="1" d="M 250 448 C 244 414 440 402 560 404 C 700 406 802 412 798 442 C 802 470 700 478 560 476 C 420 474 250 472 248 446 C 247 432 268 422 296 418" />
                    <path id="rfCirc2" class="rf-circle" pathLength="1" d="M 242 454 C 236 412 440 396 566 398 C 712 400 812 408 808 444 C 812 474 704 484 560 482 C 412 480 244 478 242 450 C 241 434 266 422 296 414" />
                  </svg>

                  <div class="rf-op rf-row rf-auto" id="rfOpConv" style="top:136px;">&times;</div>
                  <div class="rf-op rf-row rf-auto" id="rfOpAov"  style="top:206px;">&times;</div>
                  <div class="rf-op rf-row rf-auto" id="rfOpAct"  style="top:288px;">=</div>
                  <div class="rf-op rf-row rf-marker rf-hidden" id="rfOpRec" style="top:358px;">+</div>
                  <div class="rf-op rf-row rf-marker rf-hidden" id="rfOpPot" style="top:442px;">=</div>

                  <div class="rf-word rf-row" style="top:66px;">Traffic</div>
                  <div class="rf-word rf-row" style="top:136px;">Conversion</div>
                  <div class="rf-word rf-row" style="top:206px;">Average order value</div>
                  <div class="rf-word rf-row" style="top:288px;">Actual revenue</div>
                  <div class="rf-word rf-row rf-hand rf-marker" id="rfWRec" style="top:358px;">Recovered revenue</div>
                  <div class="rf-word rf-row rf-hand rf-marker" id="rfWPot" style="top:442px;">Potential revenue</div>

                  <div class="rf-sym rf-row" style="top:66px;">
                    <svg viewBox="0 0 64 64" aria-label="traffic"><circle cx="32" cy="21" r="11" fill="currentColor"/><path d="M11 56 C11 38 53 38 53 56 Z" fill="currentColor"/></svg>
                  </div>
                  <div class="rf-sym rf-row" style="top:136px;">%</div>
                  <div class="rf-sym rf-row" style="top:206px;">$</div>
                  <div class="rf-sym rf-row" style="top:288px;">$</div>
                  <div class="rf-sym rf-row rf-marker rf-hidden" id="rfSRec" style="top:358px;">$</div>
                  <div class="rf-sym rf-row rf-marker rf-hidden" id="rfSPot" style="top:442px;">$$</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    /* ─────────── GRO Framework (scroll-scrubbed revenue formula) ─────────── */
    .rf-section {
      background: #0c0c0f;
      font-family: "Hanken Grotesk", -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .rf-track { position: relative; height: 240vh; }
    @media (max-width: 767px) { .rf-track { height: 170vh; } }   /* shorter thumb-scrub */
    /* Generous padding on the pinned content (plus extra space after the
       track) so the framework never reads as mixed into the neighboring
       sections. */
    .rf-section { padding-bottom: 60px; }
    .rf-pin {
      position: sticky; top: 0;
      padding: 100px 24px;
    }
    @media (max-width: 767px) { .rf-section { padding-bottom: 24px; } .rf-pin { padding: 40px 16px; } }
    .rf-inner { width: 100%; }
    .rf-head { margin: 0 0 36px; }
    .rf-eyebrow {
      display: block;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase;
      color: #fae194; margin-bottom: 16px;
    }
    .rf-title {
      font-family: "Permanent Marker", cursive; font-weight: 400;
      color: #EDEAE0; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.1; margin: 0;
    }
    .rf-grid {
      display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center;
    }
    @media (min-width: 1024px) { .rf-grid { grid-template-columns: 2fr 3fr; gap: 56px; } }
    .rf-copy p {
      font-size: 23px; line-height: 1.65; color: rgba(237, 234, 224, 0.7);
      margin: 0 0 22px;
    }
    .rf-copy p:last-child { margin-bottom: 0; }
    /* Mobile tightens the type and the box. */
    @media (max-width: 767px) {
      .rf-copy p { font-size: 20.5px; line-height: 1.55; }
      .rf-box { padding: 16px 10px; }
      .rf-grid { gap: 24px; }
    }
    .rf-cap {
      font-family: "Permanent Marker", cursive;
      color: #fae194; font-size: 1.35em; line-height: 1;
    }
    .rf-box {
      background: #131316;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 28px 20px;
      overflow: hidden;
    }

    /* Stage: fixed 1080×520 design space, uniformly scaled to the box width */
    .rf-stage-wrap { position: relative; width: 100%; overflow: hidden; }
    .rf-stage {
      position: absolute; top: 0; left: 0;
      width: 1080px; height: 520px;
      transform-origin: top left;
      color: #fff;
    }
    .rf-row { position: absolute; transform: translateY(-50%); white-space: nowrap; }
    .rf-op {
      left: 222px; width: 64px; text-align: right;
      font-family: "Permanent Marker", cursive; font-size: 44px; line-height: 1;
      opacity: 0; color: #fff;
    }
    /* Phase-1 operators write in once the section is on screen (.rf-go) */
    @keyframes rfOpIn {
      from { opacity: 0; transform: translateY(-50%) translateX(-7px); }
      to   { opacity: 1; transform: translateY(-50%) translateX(0); }
    }
    .rf-go #rfOpConv { animation: rfOpIn .26s cubic-bezier(.5,.05,.3,1) .22s both; }
    .rf-go #rfOpAov  { animation: rfOpIn .26s cubic-bezier(.5,.05,.3,1) .50s both; }
    .rf-go #rfOpAct  { animation: rfOpIn .26s cubic-bezier(.5,.05,.3,1) .78s both; }
    .rf-word { left: 300px; font-size: 44px; font-weight: 500; letter-spacing: -0.01em; color: #fff; }
    .rf-sym  { left: 712px; text-align: left; width: 240px; font-size: 44px; font-weight: 600; color: #fff; }
    .rf-sym svg { width: 38px; height: 38px; vertical-align: -5px; }
    .rf-hand { font-family: "Permanent Marker", cursive; font-weight: 400; letter-spacing: 0.005em; }
    .rf-ltr { display: inline-block; opacity: 0; }
    .rf-marker { color: #fae194; }
    .rf-hidden { opacity: 0; }
    .rf-marks { position: absolute; inset: 0; width: 1080px; height: 520px; pointer-events: none; overflow: visible; }
    .rf-marks path {
      fill: none; stroke: #fae194; stroke-width: 4.5;      /* arrows = yellow */
      stroke-linecap: round; stroke-linejoin: round;
      /* gap (2) longer than the dash (1): hidden state parks mid-gap at
         offset 1.5 — at a dash boundary (offset 1) the round cap paints a
         stray dot on the path even though the stroke is "hidden" */
      stroke-dasharray: 1 2; stroke-dashoffset: 1.5;
    }
    .rf-marks .rf-ruleln { stroke: #fff; stroke-width: 3; }   /* dividers = white */
    .rf-marks .rf-circle { stroke: #34d399; stroke-width: 4; }/* green = answer circle only */
    @keyframes rfDrawln { to { stroke-dashoffset: 0; } }
    .rf-go #rfRule1 { animation: rfDrawln .5s ease 1.06s both; }
  </style>

  <script is:inline>
    // GRO Framework — scroll-scrubbed annotation timeline ("one pen": a single
    // stroke draws at any moment; arrowheads only after their shaft; signs
    // complete before their word writes letter-by-letter).
    (function () {
      var section = document.querySelector('[data-rf]');
      if (!section) return;
      var track = section.querySelector('[data-rf-track]');
      var wrap = section.querySelector('[data-rf-wrap]');
      var stage = section.querySelector('[data-rf-stage]');

      // Uniformly scale the 1080×520 stage to the box width. On mobile,
      // crop to the drawn composition's bounding box instead of the full
      // design canvas — otherwise the canvas margins leave the box mostly
      // empty and the formula unreadably small.
      var CONTENT = { x: 96, y: 30, w: 724, h: 462 };
      function fit() {
        var w = wrap.clientWidth;
        if (window.matchMedia('(max-width: 767px)').matches) {
          var s = w / CONTENT.w;
          stage.style.transform = 'translate(' + (-CONTENT.x * s) + 'px,' + (-CONTENT.y * s) + 'px) scale(' + s + ')';
          wrap.style.height = Math.round(CONTENT.h * s) + 'px';
        } else {
          var s2 = w / 1080;
          stage.style.transform = 'scale(' + s2 + ')';
          wrap.style.height = Math.round(520 * s2) + 'px';
        }
      }
      window.addEventListener('resize', fit);
      fit();

      function splitLetters(el) {
        var text = el.textContent; el.textContent = '';
        var spans = [];
        for (var i = 0; i < text.length; i++) {
          var s = document.createElement('span');
          s.className = 'rf-ltr';
          s.textContent = text[i] === ' ' ? ' ' : text[i];
          el.appendChild(s); spans.push(s);
        }
        return spans;
      }
      var recLetters = splitLetters(document.getElementById('rfWRec'));
      var potLetters = splitLetters(document.getElementById('rfWPot'));

      function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
      function seg(t, a, b) { return clamp((t - a) / (b - a), 0, 1); }
      function P(id) { return document.getElementById(id); }

      var arA = [P('rfArA'), P('rfArAh1'), P('rfArAh2')];
      var arB = [P('rfArB'), P('rfArBh1'), P('rfArBh2')];
      var arD = [P('rfArD'), P('rfArDh1'), P('rfArDh2')];
      var rule2 = P('rfRule2'), c1 = P('rfCirc1'), c2 = P('rfCirc2');

      // Reduced motion (or no scrub): render the fully-drawn final frame.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        ['rfOpConv','rfOpAov','rfOpAct','rfOpRec','rfOpPot','rfSRec','rfSPot'].forEach(function (id) {
          var e = P(id); e.style.animation = 'none'; e.style.opacity = '1';
        });
        ['rfRule1','rfRule2','rfArA','rfArAh1','rfArAh2','rfArB','rfArBh1','rfArBh2','rfArD','rfArDh1','rfArDh2','rfCirc1','rfCirc2'].forEach(function (id) {
          P(id).style.strokeDashoffset = 0;
        });
        recLetters.concat(potLetters).forEach(function (s) { s.style.opacity = '1'; });
        return;
      }

      // Phase 1 (printed-statement operators + divider 1) plays once on sight.
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { section.classList.add('rf-go'); io.disconnect(); }
          });
        }, { threshold: 0.2 });
        io.observe(track);
      } else {
        section.classList.add('rf-go');
      }

      // p=0 parks the offset mid-gap (1.5) — at a dash boundary the round
      // cap paints a stray dot even though the stroke is "hidden".
      function dash(el, p) { el.style.strokeDashoffset = p <= 0 ? 1.5 : 1 - p; }
      function arrow(g, t, a, b, c) {
        dash(g[0], seg(t, a, b));
        var h = seg(t, b, c);
        dash(g[1], h);
        dash(g[2], h);
      }
      function showEl(el, p) { el.style.opacity = p; }
      function writeLetters(letters, p) {
        var shown = p * letters.length;
        for (var i = 0; i < letters.length; i++) {
          letters[i].style.opacity = clamp(shown - i, 0, 1);
        }
      }

      // Phase 2 — scrubbed by progress through the pinned track (true scrub:
      // reverse scrolling un-draws).
      var pinEl = section.querySelector('.rf-pin');
      function update() {
        var r = track.getBoundingClientRect();
        // Mobile: the content is shorter than the viewport, so the pin
        // holds for (viewport - content) px after a viewport-based scrub
        // finishes — dead scroll over an empty gap. Time the scrub against
        // the pin's actual travel instead, finishing ~100px before release
        // so the completed drawing holds only briefly before moving on.
        var total = window.matchMedia('(max-width: 767px)').matches
          ? track.offsetHeight - pinEl.offsetHeight - 100
          : track.offsetHeight - window.innerHeight;
        if (total <= 0) return;
        var t = clamp(-r.top / total, 0, 1);

        arrow(arA, t, 0.00, 0.08, 0.11);
        arrow(arB, t, 0.13, 0.21, 0.24);
        showEl(P('rfOpRec'), seg(t, 0.26, 0.30));
        writeLetters(recLetters, seg(t, 0.31, 0.44));
        showEl(P('rfSRec'), seg(t, 0.45, 0.48));
        dash(rule2, seg(t, 0.50, 0.57));
        arrow(arD, t, 0.59, 0.68, 0.71);
        showEl(P('rfOpPot'), seg(t, 0.73, 0.77));
        writeLetters(potLetters, seg(t, 0.78, 0.90));
        showEl(P('rfSPot'), seg(t, 0.90, 0.93));
        dash(c1, seg(t, 0.93, 0.965));
        dash(c2, seg(t, 0.965, 1.0));
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>


  <script is:inline>
    (function () {
      // Live diagnostic driver — wires the v5 diagnostic API to the audit
      // Mock simulator — hardcoded outcomes that play through the animation
      // as if a real scan happened. Replaced by real API wiring on the
      // feat/backend-wiring branch once the backend is stable.
      var SAMPLE_URL = "wazu.com/products/merino-runner";
      var SEQ = {
        search: { api: "SearchAudit", steps: [
          { label: "Search box present", outcome: "pass", text: "Found" },
          { label: "Typo tolerance",     outcome: "fail", text: "Misspelling → 0 results" },
          { label: "Synonyms",           outcome: "fail", text: "No coverage" },
          { label: "Autocomplete",       outcome: "pass", text: "Present" },
          { label: "No-results screen",  region: "empty_state",     outcome: "fail", text: "34 / 100" },
          { label: "Brand relevance",    region: "brand_relevance", outcome: "pass", text: "72 / 100" },
          { label: "Facets present",     region: "facet_present",   outcome: "pass", text: "Yes" },
          { label: "Facet depth",        region: "facet_depth",     outcome: "fail", text: "45 / 100" },
        ] },
        pdp: { api: "PDPAudit", steps: [
          { label: "Breadcrumbs",      region: "breadcrumbs", outcome: "pass", text: "Present" },
          { label: "Product images",   region: "images",      outcome: "pass", text: "6 images · alt OK" },
          { label: "Variants",         region: "variants",    outcome: "fail", text: "No variant selector" },
          { label: "Attributes",       region: "attributes",  outcome: "pass", text: "8 / 10" },
          { label: "Description",      region: "description", outcome: "fail", text: "Thin · 38 words" },
          { label: "Tags",             region: "tags",        outcome: "pass", text: "Tagged" },
          { label: "Reviews",          outcome: "fail", text: "None found" },
          { label: "Stock & delivery", outcome: "pass", text: "Clear" },
          { label: "Upsell",           region: "upsell",      outcome: "fail", text: "Not configured" },
          { label: "Cross-sell",       region: "crosssell",   outcome: "pass", text: "4 linked" },
        ] },
      };
      var sleep = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };

      function buildList(ul, steps) {
        ul.innerHTML = "";
        return steps.map(function (s) {
          var li = document.createElement("li");
          li.className = "audit-row";
          li.innerHTML = '<span class="ck-ico"></span><span class="name"></span><span class="value"></span>';
          li.querySelector(".name").textContent = s.label;
          ul.appendChild(li);
          return li;
        });
      }
      function setCk(li, state, val) {
        li.className = "audit-row " + state;
        if (val != null) li.querySelector(".value").textContent = val;
      }

      async function runBlock(block, url) {
        var cfg = SEQ[block.dataset.block];
        if (!cfg) return;
        var iframe = block.querySelector(".audit-frame");
        var ul = block.querySelector("[data-checklist]");
        var lis = buildList(ul, cfg.steps);
        block.classList.add("is-live");   // real (pending) checklist replaces the ghost rows

        await new Promise(function (res) {
          var done = false;
          function finish() { if (!done) { done = true; res(); } }
          iframe.onload = finish;
          iframe.src = iframe.dataset.loader + "?demo=0&url=" + encodeURIComponent(url);
          var poll = setInterval(function () {
            if (iframe.contentWindow && iframe.contentWindow[cfg.api]) { clearInterval(poll); finish(); }
          }, 120);
          setTimeout(function () { clearInterval(poll); finish(); }, 10000);
        });
        block.classList.add("is-loaded");  // loader iframe ready → drop the ghost frame
        var api = iframe.contentWindow && iframe.contentWindow[cfg.api];
        if (!api) return;
        try { api.resetAll(); api.setUrl(url); } catch (e) {}

        await sleep(500);
        // Paced to fill ~28 s so the score overlay appears right at 30 s.
        // PDP (10 steps) × 2800 ms + 500 ms ≈ 28.5 s.
        for (var i = 0; i < cfg.steps.length; i++) {
          var s = cfg.steps[i], li = lis[i], ok = s.outcome === "pass";
          setCk(li, "scanning");
          try { if (s.region) api.scan(s.region); if (api.status) api.status("Checking " + s.label + "…"); } catch (e) {}
          await sleep(2000);
          try { if (s.region) { ok ? api.pass(s.region, s.text) : api.fail(s.region, s.text); } } catch (e) {}
          setCk(li, ok ? "pass" : "fail", s.text);
          await sleep(800);
        }
        try { if (api.complete) api.complete(); } catch (e) {}
      }

      function calcLeakScore() {
        var total = 0, fails = 0;
        var blocks = Object.keys(SEQ);
        for (var b = 0; b < blocks.length; b++) {
          var steps = SEQ[blocks[b]].steps;
          for (var i = 0; i < steps.length; i++) {
            total++;
            if (steps[i].outcome === "fail") fails++;
          }
        }
        return Math.round((fails / total) * 100);
      }

      function showScore() {
        var overlay = document.querySelector("[data-score-overlay]");
        var card    = document.querySelector("[data-score-card]");
        var numEl   = document.querySelector("[data-score-num]");
        if (!overlay || !card || !numEl) return;

        var score = calcLeakScore();
        numEl.textContent = score;

        // Palette is yellow / red / green only (no orange). Anything not
        // clearly healthy reads red; thresholds can be refined later.
        var tier = score >= 35 ? "is-red" : "is-green";
        card.classList.add(tier);
        overlay.hidden = false;
      }

      function runAll(url) {
        document.querySelectorAll("[data-audit-carousel] .audit-block").forEach(function (b) { runBlock(b, url); });
        // Show score overlay exactly at 30 s
        setTimeout(showScore, 30000);
      }

      function init() {
        var carousel = document.querySelector("[data-audit-carousel]");
        if (!carousel) return;
        var form = document.querySelector("[data-audit-form]");
        if (!form) return;
        // "Start Diagnostic Scan" reveals the (hidden) carousel like the
        // booking section: unhide → open animation → smooth-scroll → run.
        var err = form.querySelector("[data-audit-err]");
        var errMsg = form.querySelector("[data-audit-err-msg]");
        var urlInput = form.querySelector('input[name="url"]');
        var emailInput = form.querySelector('input[name="email"]');

        // The red error pill is MOVED next to the offending field so its
        // pointer arrow points at the input that's actually wrong.
        function showErr(input, msg) {
          if (!err) return;
          var field = input && input.closest(".hero-v2-audit-field");
          if (field) field.appendChild(err);
          if (errMsg) errMsg.textContent = msg;
          err.classList.add("is-shown");
        }
        function clearErr() { if (err) err.classList.remove("is-shown"); }

        function normalizeUrl(raw) {
          var v = (raw || "").trim();
          if (!v) return null;
          if (!/^https?:\/\//i.test(v)) v = "https://" + v;
          try {
            var u = new URL(v);
            if (!u.hostname || u.hostname.indexOf(".") === -1) return null;
            return u.href;
          } catch (e) { return null; }
        }
        function urlError() {
          var url = normalizeUrl(urlInput && urlInput.value);
          if (!url) return "That doesn't look like a valid store URL — check for a typo (e.g. your-store.com/product).";
          var path = ""; try { path = new URL(url).pathname.replace(/\/+$/, ""); } catch (e) {}
          if (!path) return "Please paste complete URL for a product page.";
          return null;
        }
        function emailError() {
          if (emailInput && !emailInput.checkValidity()) return "Please enter a valid email so we can send your results.";
          return null;
        }

        // Validate on blur (lost focus); a valid blur normalizes + clears.
        function wireField(input, getError) {
          if (!input) return;
          var field = input.closest(".hero-v2-audit-field");
          input.addEventListener("blur", function () {
            var msg = input.value.trim() ? getError() : null;
            if (msg) { showErr(input, msg); return; }
            if (err && err.parentElement === field) clearErr();
            if (input === urlInput && input.value.trim()) { var u = normalizeUrl(input.value); if (u) input.value = u; }
          });
        }
        wireField(urlInput, urlError);
        wireField(emailInput, emailError);

        // URL focus → the right-side hint turns yellow; blur → grey again.
        var hintEl = form.querySelector(".hero-v2-audit-hint");
        if (urlInput && hintEl) {
          urlInput.addEventListener("focus", function () { hintEl.classList.add("is-active"); });
          urlInput.addEventListener("blur", function () { hintEl.classList.remove("is-active"); });
        }

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var ue = urlError();
          if (ue) return showErr(urlInput, ue);
          var u = normalizeUrl(urlInput.value); if (u) urlInput.value = u;
          var ee = emailError();
          if (ee) return showErr(emailInput, ee);
          clearErr();
          carousel.hidden = false;
          carousel.classList.add("is-open");
          requestAnimationFrame(function () { carousel.scrollIntoView({ behavior: "smooth", block: "start" }); });
          runAll(normalizeUrl(urlInput.value));
        });

        // The scan does NOT auto-start. Until the visitor submits "Start
        // Diagnostic Scan", the frames stay as grey ghost loaders. On scroll
        // into view we only play the section's entrance fade.
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting) { io.disconnect(); carousel.classList.add("is-open"); }
          }, { threshold: 0.15 });
          io.observe(carousel);
        } else { carousel.classList.add("is-open"); }
      }
      if (document.readyState !== "loading") init();
      else document.addEventListener("DOMContentLoaded", init);
    })();
  </script>

