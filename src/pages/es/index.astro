---
/**
 * SPANISH MIRROR of src/pages/index.astro (v2 layout).
 *
 * ⚠️ Design tokens (colors, fonts, sizes, spacing, components) come
 * from docs/STYLEGUIDE.md. Read it before introducing any new visual
 * choice. Visual mirror: docs/style-guide.html.
 *
 * Structure-for-structure copy with localized strings. When the English
 * homepage's content evolves, this file needs to be updated in lockstep
 * — keep them paired. Components that accept a `locale` prop (SearchDemo,
 * SearchCopyHelper) receive `locale="es"` here so their internal copy
 * switches with the page; the funnel script reads `data-locale="es"`
 * from #funnel-root for the same purpose.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchDemo from '../../components/SearchDemo.astro';
import SearchCopyHelper from '../../components/SearchCopyHelper.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * Booking provider toggle. Flip `provider` between 'cal' and 'calendly'
 * to swap embeds without removing either's code path. The unused
 * provider's script + click handler are gated behind a conditional
 * below, so only one is shipped to the browser at a time.
 */
const provider = 'cal' as 'cal' | 'calendly';

// Calendly config — preserved intact for easy revert (set provider above).
const calendlyUrl =
  import.meta.env.PUBLIC_BOOKING_URL ||
  'https://calendly.com/grolabs-15min-free-growth-assesment/30min';

// Cal.com config.
const calLink = 'tuncho-granados-uibzst/15min';
const calUrl = `https://cal.com/${calLink}`;

const bookingUrl = provider === 'cal' ? calUrl : calendlyUrl;
const bookingIsExternal = bookingUrl.startsWith('http');
---

<BaseLayout>
  {/* JSON-LD: Service + FAQPage in Spanish so answer engines that
      reply in Spanish (or that need a localized version) can quote
      the page with attribution. */}
  <Fragment slot="head-extra">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Llamada de evaluación de crecimiento",
      "description": "Llamada gratuita de 15 minutos. Recorremos juntos tu tienda y señalamos las mayores fugas de ingresos en búsqueda, página de producto y checkout.",
      "provider": { "@type": "Organization", "name": "GroLabs", "url": "https://grolabs.ai" },
      "areaServed": "Worldwide",
      "serviceType": "Consultoría de crecimiento e-commerce",
      "inLanguage": "es",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
      "potentialAction": {
        "@type": "ReserveAction",
        "target": "https://cal.com/tuncho-granados-uibzst/15min",
        "result": { "@type": "Reservation", "name": "Llamada de evaluación de crecimiento" }
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "inLanguage": "es",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto aumenta la conversión la búsqueda interna del sitio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los usuarios que buscan en una tienda convierten 2–3× más que quienes no buscan — pero solo si encuentran lo que quieren. La búsqueda del sitio genera un aumento medible en la conversión cuando se combina con datos de catálogo ricos y un motor de búsqueda que entiende la intención del comprador."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos ingresos se pierden por abandono en la página de producto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre el 14% y el 23% de las visitas a páginas de producto terminan sin agregar al carrito en tiendas e-commerce de mercado medio. Las causas más comunes son la falta de detalles de producto (tallas, materiales, compatibilidad) y una imagen principal poco clara — ambas se pueden resolver en la capa de catálogo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas devoluciones se deben a expectativas no coincidentes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Entre el 19% y el 24% de las devoluciones en tiendas e-commerce de mercado medio se deben a expectativas no coincidentes — el producto en sí estaba bien, pero el comprador esperaba algo diferente. La causa raíz suele ser datos de producto incompletos y problemas de descubrimiento que muestran el producto equivocado al comprador equivocado."
          }
        }
      ]
    })} />
  </Fragment>

  {/* Header-anchored CTAs. Hidden by default; an IntersectionObserver
      at the bottom of this page reveals them when the hero CTA row
      scrolls out of view. */}
  <Fragment slot="header-ctas">
    <div id="header-ctas" class="header-ctas" hidden>
      <a
        href="https://cal.com/tuncho-granados-uibzst/15min"
        class="header-cta header-cta--primary cta-button-style"
        target="_blank"
        rel="noopener noreferrer"
        data-booking-cta
      >
        Agenda una llamada de evaluación
      </a>
      <a
        href="mailto:growth@grolabs.ai"
        class="header-cta header-cta--ghost"
      >
        Contacto
      </a>
    </div>
  </Fragment>

  <!-- Hero + Stats (v2) — merged into one viewport. -->
  <section class="hero-v2 relative px-margin-mobile md:px-margin-desktop pt-2xl pb-2xl md:pt-3xl md:pb-3xl overflow-hidden">
    <div id="particles-container"></div>

    <div class="hero-v2-grid max-w-page mx-auto relative z-10 reveal active">
      <div class="hero-v2-copy">
        <h1 class="hero-v2-headline">
          <span class="hero-v2-line">Recupera ingresos perdidos</span>
          <span class="hero-v2-line"><span class="hero-v2-amp">&amp;</span> haz crecer tu negocio</span>
        </h1>
        <p class="hero-v2-tagline">Sin pagar por más tráfico</p>
        <p class="hero-v2-lede">
          ¡Sí, es posible!<br />
          Te ayudamos a recuperar ingresos perdidos y aumentar las ventas sin pagar por más tráfico.
        </p>
        <div class="hero-v2-ctas" data-hero-ctas>
          <a
            href={bookingUrl}
            class="hero-v2-btn hero-v2-btn--primary cta-button-style"
            target="_blank"
            rel="noopener noreferrer"
            data-booking-cta
          >
            Agenda una llamada de evaluación
          </a>
          <a href="mailto:growth@grolabs.ai" class="hero-v2-btn hero-v2-btn--ghost">
            Contacto
          </a>
        </div>
      </div>

      <div class="hero-v2-stage">
        <article class="hero-v2-card hero-v2-card--featured">
          <div class="hero-v2-stat">2&ndash;3&times;</div>
          <h3 class="hero-v2-card-title">Aumento en conversión de búsqueda con optimización de catálogo y motor</h3>
          <p class="hero-v2-card-body">
            Quienes buscan convierten 2&ndash;3&times; más que quienes no lo hacen&mdash;<br>
            <span class="hero-v2-highlight">si encuentran lo que buscan</span>.
          </p>
          <cite class="hero-v2-card-source">Referencia de industria — e-commerce de mercado medio.</cite>
        </article>
        <article class="hero-v2-card">
          <div class="hero-v2-stat">14&ndash;23%</div>
          <h3 class="hero-v2-card-title">Abandono en página de producto</h3>
          <p class="hero-v2-card-body">Los compradores abandonan las páginas de producto sin agregar al carrito por falta de detalles e información poco clara.</p>
          <cite class="hero-v2-card-source">Referencia de industria — e-commerce de mercado medio.</cite>
        </article>
        <article class="hero-v2-card">
          <div class="hero-v2-stat">19&ndash;24%</div>
          <h3 class="hero-v2-card-title">Devoluciones de productos perfectos</h3>
          <p class="hero-v2-card-body">Devoluciones por expectativas no coincidentes causadas por datos de producto incompletos y problemas de descubrimiento.</p>
          <cite class="hero-v2-card-source">Referencia de industria — e-commerce de mercado medio.</cite>
        </article>
      </div>
    </div>
  </section>

  <!-- Booking embed -->
  <section id="booking-embed" hidden class="bg-primary pt-xl pb-md md:pt-2xl px-margin-mobile md:px-margin-desktop">
    <div class="max-w-page mx-auto">
      <p class="text-zinc-900 text-body-lg leading-relaxed mb-lg text-center">
        Selecciona la fecha y hora más conveniente para nuestra llamada.
      </p>
      <div
        id="booking-mount"
        style={
          provider === 'cal'
            ? 'min-width:320px; min-height:600px; width:100%;'
            : 'min-width:320px; height:760px; width:100%; overflow:hidden;'
        }
      ></div>
    </div>
  </section>

  <!-- Funnel Benchmark / Revenue leaks (dark section per the v2 alternation). -->
  <section class="relative py-2xl md:py-3xl px-margin-mobile md:px-margin-desktop bg-canvas-deeper overflow-hidden reveal">
    <div class="max-w-page mx-auto">
    <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
      Embudo de conversión
    </span>
    <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-lg md:mb-[48px]">Fugas de ingresos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-xl mb-xl">
      <div>
        <p class="text-body-lg text-secondary-fixed-dim">
          La fuga de ingresos es la brecha entre los ingresos que un negocio ha
          generado y los que realmente capta, causada por fricciones evitables,
          procesos rotos y oportunidades perdidas.
        </p>
        <p class="text-body-lg text-secondary-fixed-dim mt-md">
          Pérdidas causadas por nuestros errores, no por la competencia o las condiciones del mercado.
        </p>
        <p class="text-body-lg mt-md">
          <span class="text-white">Errores no forzados del negocio&nbsp;&mdash;</span>
          <span class="text-primary">Tres-putts, bases por bolas, dobles faltas, pérdidas ...</span>
        </p>
      </div>

      <div class="leak-equation-card">
        <div class="leak-equation">
          <span class="leak-equation-lhs" style="white-space: nowrap;">Fugas de ingresos (%)&nbsp;=</span>
          <span class="leak-equation-fraction">
            <span class="leak-equation-num">IPT&nbsp;−&nbsp;IRC</span>
            <span class="leak-equation-den">IPT</span>
          </span>
          <span class="leak-equation-rhs">×&nbsp;100</span>
        </div>
        <dl class="leak-equation-key">
          <div class="leak-equation-row">
            <dt>IPT</dt>
            <dd>Ingresos Potenciales Totales</dd>
          </div>
          <div class="leak-equation-row">
            <dt>IRC</dt>
            <dd>Ingresos Realmente Captados</dd>
          </div>
        </dl>
      </div>
    </div>
    <div class="p-md md:p-xl mb-xl flex flex-col">
      <div id="funnel-root" data-locale="es" class="w-full overflow-x-auto"></div>
    </div>
    </div>
  </section>

  <!-- Try it out / Search Demo (light section). -->
  <section class="relative py-xl md:py-2xl px-margin-mobile md:px-margin-desktop bg-canvas overflow-hidden reveal">
    <div class="max-w-page mx-auto">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Pruébalo
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-lg md:mb-[48px]">
        Demo de búsqueda
      </h2>

      <SearchCopyHelper locale="es" />

      <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-xl items-start">
        <SearchDemo locale="es" />

        <ul class="grid grid-cols-2 gap-md lg:grid-cols-1">
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">bolt</span>
            <div class="text-white text-body-md leading-relaxed">
              Resultados ultrarrápidos
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">check_box</span>
            <div class="text-body-md leading-relaxed">
              <div class="text-white">Visibilidad de coincidencia de atributos</div>
              <div class="text-primary font-mono text-xs uppercase tracking-[0.18em] mt-1">Reduce devoluciones</div>
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">person</span>
            <div class="text-white text-body-md leading-relaxed">
              Resultados personalizados
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">record_voice_over</span>
            <div class="text-white text-body-md leading-relaxed">
              Búsqueda semántica
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">location_on</span>
            <div class="text-white text-body-md leading-relaxed">
              Geo-búsqueda
            </div>
          </li>
          <li class="flex items-start gap-md">
            <span class="material-symbols-outlined text-primary text-2xl flex-shrink-0 leading-none mt-1" aria-hidden="true">spellcheck</span>
            <div class="text-white text-body-md leading-relaxed">
              Tolerancia a errores y sinónimos
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Entrepreneurs' Priority / Grow a Company (yellow section). -->
  <section class="relative py-2xl md:py-3xl px-margin-mobile md:px-margin-desktop bg-primary overflow-hidden reveal">
    <div class="max-w-page mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-lg items-end">
        <div>
          <span class="font-mono tracking-[0.2em] text-xs uppercase mb-4 block text-black font-bold">
            Prioridad del emprendedor
          </span>
          <h2 class="font-marker uppercase text-black text-4xl md:text-5xl mb-lg md:mb-[48px]">
            Hacer crecer una empresa
          </h2>

          <div class="bg-canvas rounded-xl p-lg md:p-xl text-secondary-fixed-dim text-body-md leading-relaxed">
            <blockquote class="border-l border-primary/30 pl-md mb-xl">
              <p class="text-white text-body-lg italic leading-snug mb-sm">
                &ldquo;La mayoría de los emprendedores fracasan porque están trabajando
                <span class="text-primary font-medium not-italic">en su negocio</span>
                en lugar de trabajar
                <span class="text-primary font-medium not-italic">sobre su negocio</span>.&rdquo;
              </p>
              <footer class="text-body-sm text-zinc-500 not-italic">
                — Michael Gerber, <cite class="not-italic">El Mito del Emprendedor</cite>
              </footer>
            </blockquote>

            <p class="mb-md">
              Monitorear embudos. Cazar fugas. Leer GA4 a medianoche. Cada hora
              que pasas en el dashboard es una hora que no estás invirtiendo en
              la compañía — en la estrategia, el equipo, el siguiente producto,
              las alianzas que solo tú puedes construir.
            </p>

            <p>
              <span class="text-primary font-medium">Sin noticias = buenas noticias.</span>
              <span class="text-white">Si algo requiere tu atención, te avisaremos.</span>
            </p>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <img
            src={`${base}/agent-notification.svg`}
            alt="Notificación push de GroLabs: Hola Peter, me temo que el tráfico bajó 6% ayer. Con un enlace de Más información."
            class="w-full max-w-[180px] h-auto block"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  {provider === 'calendly' && (
    <>
      <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
      <script async src="https://assets.calendly.com/assets/external/widget.js"></script>
      <script is:inline define:vars={{ bookingUrl }}>
        (function() {
        let mounted = false;

        function buildEmbedUrl(base) {
          const d = new Date();
          const yyyy = d.getFullYear();
          const mm = String(d.getMonth() + 1).padStart(2, '0');
          const dd = String(d.getDate()).padStart(2, '0');
          const sep = base.includes('?') ? '&' : '?';
          return base
            + sep
            + 'background_color=131316'
            + '&text_color=EDEAE0'
            + '&primary_color=fae194'
            + '&hide_event_type_details=1'
            + '&hide_landing_page_details=1'
            + '&hide_gdpr_banner=1'
            + `&month=${yyyy}-${mm}`
            + `&date=${yyyy}-${mm}-${dd}`;
        }

        function mountWidget() {
          const section = document.getElementById('booking-embed');
          const mount = document.getElementById('booking-mount');
          if (!section || !mount) return;
          section.hidden = false;
          if (!mounted && window.Calendly && Calendly.initInlineWidget) {
            Calendly.initInlineWidget({
              url: buildEmbedUrl(bookingUrl),
              parentElement: mount,
            });
            mounted = true;
          }
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.addEventListener('click', function (e) {
          const link = e.target.closest('[data-booking-cta]');
          if (!link) return;
          if (!window.Calendly || !Calendly.initInlineWidget) return;
          e.preventDefault();
          mountWidget();
        });

        window.addEventListener('message', function (e) {
          if (!e || !e.data || typeof e.origin !== 'string') return;
          if (!e.origin.endsWith('.calendly.com') && e.origin !== 'https://calendly.com') return;
          const data = e.data;
          const evt = (data && data.event) || '';
          const height =
            (data.payload && (data.payload.height || data.payload.iframeHeight)) ||
            data.height ||
            data.iframeHeight;
          if (!height || typeof height !== 'number') return;
          if (!/iframe.?height|page_height|resize/i.test(evt) && !data.height) return;
          const mount = document.getElementById('booking-mount');
          if (!mount) return;
          const MAX_EMBED_HEIGHT = 760;
          mount.style.height = Math.min(height, MAX_EMBED_HEIGHT) + 'px';
        });
        })();
      </script>
    </>
  )}

  {provider === 'cal' && (
    <script is:inline define:vars={{ calLink }}>
      (function() {
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else {
              p(cal, ar);
            }
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      Cal("init", "booking", { origin: "https://cal.com" });

      let mounted = false;

      function mountWidget() {
        const section = document.getElementById('booking-embed');
        if (!section) return;
        section.hidden = false;
        if (!mounted) {
          const d = new Date();
          const yyyy = d.getFullYear();
          const mm = String(d.getMonth() + 1).padStart(2, '0');
          const dd = String(d.getDate()).padStart(2, '0');
          Cal.ns.booking("inline", {
            elementOrSelector: "#booking-mount",
            calLink: `${calLink}?date=${yyyy}-${mm}-${dd}`,
            config: { layout: "month_view" },
          });
          Cal.ns.booking("ui", {
            theme: "dark",
            hideEventTypeDetails: true,
            layout: "month_view",
            styles: { branding: { brandColor: "#fae194" } },
          });
          mounted = true;
        }
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      document.addEventListener('click', function (e) {
        const link = e.target.closest('[data-booking-cta]');
        if (!link) return;
        if (!window.Cal) return;
        e.preventDefault();
        mountWidget();
      });
      })();
    </script>
  )}

  {/* Reveal the header CTAs as soon as the hero CTA row scrolls past
      the top of the viewport, and hide them again when it scrolls back in. */}
  <script is:inline>
    (function () {
      const heroCtas = document.querySelector('[data-hero-ctas]');
      const headerCtas = document.getElementById('header-ctas');
      if (!heroCtas || !headerCtas) return;
      const observer = new IntersectionObserver(
        function (entries) {
          headerCtas.hidden = entries[0].isIntersecting;
        },
        { threshold: 0 }
      );
      observer.observe(heroCtas);
    })();
  </script>
</BaseLayout>

<style is:global>
  /* Hero v2 — merged hero + stats. Duplicated from index.astro because
     Astro's <style is:global> only loads on pages that include the file. */
  .hero-v2-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 96px;
    align-items: center;
  }
  @media (max-width: 1100px) {
    .hero-v2-grid { grid-template-columns: 1fr; gap: 56px; }
  }

  .hero-v2-headline {
    margin: 0 0 14px;
    display: flex; flex-direction: column; gap: 4px;
  }
  .hero-v2-line {
    font-family: "Permanent Marker", cursive;
    font-weight: 400;
    color: #fff;
    font-size: clamp(36px, 3.9vw, 54px);
    line-height: 1;
    letter-spacing: 0.005em;
    white-space: nowrap;
  }
  .hero-v2-amp {
    font-size: 0.75em;
    margin-right: 0.08em;
    position: relative; top: -0.02em;
  }

  .hero-v2-tagline {
    font-family: monospace;
    color: #fae194;
    font-size: clamp(12px, 1.4vw, 18px);
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 14px 0 56px;
    white-space: nowrap;
  }

  .hero-v2-lede {
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 20px;
    line-height: 1.55;
    color: rgba(237, 234, 224, 0.6);
    margin: 0 0 32px;
    max-width: 580px;
  }

  .hero-v2-ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .hero-v2-btn {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 600; font-size: 15px;
    padding: 14px 28px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 8px;
    transition: transform .15s, box-shadow .2s, background .2s, color .2s, border-color .2s;
  }
  .hero-v2-btn--primary {
    color: #1A1A1A;
