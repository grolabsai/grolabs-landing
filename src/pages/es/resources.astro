---
/**
 * /es/resources — versión en español. Mirror de /resources con título +
 * eyebrow + CTAs traducidos. Los datos vienen del mismo fetch
 * compartido en src/lib/resources-data.ts; cuando un artículo tiene
 * title_es lo usa, si no, cae al title_en.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  fetchResourceGroups,
  localizedTitle,
  ctaForCategory,
} from '../../lib/resources-data';

const groups = await fetchResourceGroups();
const locale = 'es' as const;
---

<BaseLayout>
  {/* No `reveal` here: see EN resources.astro — a tall single-column
      mobile grid never crosses the reveal observer's 0.15 threshold, so
      the section would stay at opacity 0 and render blank. */}
  <section class="relative pt-md pb-2xl md:mt-2xl md:py-2xl bg-canvas overflow-hidden">
    <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="text-primary font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Recursos
      </span>
      <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-xl">
        La lista de lectura
      </h2>

      {
        groups.length === 0 ? (
          <p class="text-secondary-fixed-dim italic">
            Pronto habrá nuevos recursos — vuelve a revisar.
          </p>
        ) : (
          groups.map(({ category, items }) => (
            <div class="mb-lg">
              <div class="resource-grid">
                {items.map((item) => (
                  <article class="resource-card">
                    {item.featured_image ? (
                      <a
                        href={item.external_url ?? '#'}
                        target={item.external_url ? '_blank' : undefined}
                        rel={item.external_url ? 'noopener noreferrer sponsored' : undefined}
                        class="resource-card-image-link"
                      >
                        <img
                          src={item.featured_image}
                          alt={localizedTitle(item, locale)}
                          class="resource-card-image"
                          loading="lazy"
                        />
                      </a>
                    ) : (
                      <div class="resource-card-image resource-card-image--placeholder" aria-hidden="true">
                        <span>{category.icon ?? '·'}</span>
                      </div>
                    )}
                    <div class="resource-card-body">
                      <h4 class="resource-card-title">{localizedTitle(item, locale)}</h4>
                      <p class="resource-card-sub">
                        {item.author && <span>{item.author}</span>}
                        {item.year && <span>{item.year}</span>}
                        {item.rating != null && (
                          <span class="resource-card-rating">★ {Number(item.rating).toFixed(1)}</span>
                        )}
                      </p>
                    </div>
                    {item.external_url && (
                      <a
                        href={item.external_url}
                        target="_blank"
                        rel="noopener noreferrer sponsored"
                        class="resource-card-link"
                      >
                        <span class="resource-card-link-text">{ctaForCategory(category.slug, locale)}</span> →
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </div>
          ))
        )
      }
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Compact list — every resource is one row (small cover thumbnail +
     title/author + CTA), read like a Spotify track list rather than a
     wall of large book covers. */
  .resource-grid {
    display: flex;
    flex-direction: column;
  }

  .resource-card {
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    padding: 9px 8px;
    transition: background 180ms ease;
  }
  .resource-card:hover {
    background: rgba(255, 255, 255, 0.035);
  }

  .resource-card-image-link {
    display: block;
    line-height: 0;
    flex: 0 0 auto;
  }
  .resource-card-image {
    width: 44px;
    height: 60px;
    object-fit: cover;
    background: #0e0e11;
    border-radius: 5px;
    display: block;
  }
  .resource-card-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(250, 225, 148, 0.35);
    font-size: 22px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .resource-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .resource-card-title {
    color: #EDEAE0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .resource-card-sub {
    display: flex;
    align-items: center;
    min-width: 0;
    margin: 0;
    font-size: 12.5px;
    color: rgba(237, 234, 224, 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .resource-card-sub > span {
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
  }
  .resource-card-sub > span:first-child {
    flex-shrink: 1;
  }
  .resource-card-sub > span:not(:first-child)::before {
    content: '·';
    margin: 0 7px;
    color: rgba(237, 234, 224, 0.3);
  }
  .resource-card-rating {
    color: rgba(250, 225, 148, 0.7);
  }
  .resource-card-link {
    flex: 0 0 auto;
    color: #fae194;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms;
  }
  .resource-card-link:hover {
    color: #ffffff;
  }
  @media (max-width: 479px) {
    .resource-card-link-text {
      display: none;
    }
  }
</style>
