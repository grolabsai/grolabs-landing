---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title="Journal | GroLabs"
  description="Notes from the GroLabs team on AI search, funnel diagnostics, AEO, and the economics of small e-commerce."
>
  <section class="max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop pt-xl pb-xl">
    <header class="mb-xl reveal active">
      <span class="text-[#fae194] font-mono tracking-[0.2em] text-xs uppercase mb-4 block">
        Journal
      </span>
      <h1 class="font-page-title text-4xl md:text-6xl text-white mb-md">Field notes</h1>
      <p class="text-body-lg text-secondary-fixed-dim">
        Build notes, diagnostics, and opinions on AI search and conversion for small e-commerce.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-secondary-fixed-dim italic">No posts yet — check back soon.</p>
      ) : (
        <ul class="space-y-md">
          {posts.map((post) => (
            <li class="glass-card p-xl rounded-xl reveal active">
              <a href={`/blog/${post.id}`} class="block group">
                <div class="flex items-baseline gap-md mb-sm">
                  <span class="font-mono text-primary text-xs tracking-tighter">
                    {dateFmt.format(post.data.pubDate)}
                  </span>
                  {post.data.tags.length > 0 && (
                    <span class="font-mono text-zinc-500 text-xs tracking-tighter">
                      {post.data.tags.slice(0, 3).join(' · ')}
                    </span>
                  )}
                </div>
                <h2 class="font-page-title-mobile text-2xl text-white group-hover:text-primary transition-colors mb-sm">
                  {post.data.title}
                </h2>
                <p class="text-body-md text-secondary-fixed-dim leading-relaxed">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
