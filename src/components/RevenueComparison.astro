---
// RevenueComparison.astro — "Two ways to double your revenue" (equation style, PRIMARY)
// Plan A (ads) vs Plan B (conversion) as annotated equations. Animates once on scroll-in.
// Fonts required (already loaded in BaseLayout): Hanken Grotesk, Permanent Marker, Caveat.
---
<section class="sec rv-eq" data-rv data-screen-label="Equation style">
  <div class="eyebrow">Best way to double revenue?</div>
  <h2>Increase ad spend, or conversion?</h2>
  <div class="cards">
    <article class="card a">
      <div class="plan">Plan A: spend more on ads</div>
      <div class="eq">
        <span class="op"></span><span class="lb">Traffic</span><span class="old x" style="--d:.9s">100K</span><span class="new" style="--d:.9s">200K</span>
        <span class="op">×</span><span class="lb">Conversion</span><span class="old">1%</span><span class="new"></span>
        <span class="op">×</span><span class="lb">Average order value</span><span class="old">$100</span><span class="new"></span>
        <span class="op"></span><span class="rule"><svg viewBox="0 0 100 6" preserveAspectRatio="none"><path d="M0 3 C 30 2, 60 4.5, 100 2.6"/></svg></span>
        <span class="op">=</span><span class="lb">Revenue</span><span class="old x" style="--d:.2s">$100K</span><span class="new" style="--d:.2s">$200K</span>
        <span class="sp"></span>
        <span class="op">−</span><span class="lb">Cost of goods</span><span class="old x" style="--d:1.5s">$60K</span><span class="new" style="--d:1.5s">$120K</span>
        <span class="op">−</span><span class="lb">Ad spend</span><span class="old x" style="--d:1.9s">$28K</span><span class="new" style="--d:1.9s">$66K</span>
        <span class="op"></span><span class="rule"><svg viewBox="0 0 100 6" preserveAspectRatio="none"><path d="M0 3.2 C 35 4.4, 65 2, 100 3"/></svg></span>
        <span class="op">=</span><span class="lb total">Net profit</span><span class="old total x" style="--d:2.4s">$12K</span><span class="new total" style="--d:2.4s">$14K</span>
      </div>
      <div class="verdict" style="--d:3s"><strong>+17%</strong><span>profit, after +136% ad spend.</span></div>
    </article>
    <article class="card b">
      <div class="plan">Plan B: convert more visitors</div>
      <div class="eq">
        <span class="op"></span><span class="lb">Traffic</span><span class="old">100K</span><span class="new same" style="--d:.9s">same</span>
        <span class="op">×</span><span class="lb">Conversion</span><span class="old x" style="--d:.9s">1%</span><span class="new" style="--d:.9s">2%</span>
        <span class="op">×</span><span class="lb">Average order value</span><span class="old">$100</span><span class="new"></span>
        <span class="op"></span><span class="rule"><svg viewBox="0 0 100 6" preserveAspectRatio="none"><path d="M0 3 C 30 2, 60 4.5, 100 2.6"/></svg></span>
        <span class="op">=</span><span class="lb">Revenue</span><span class="old x" style="--d:.2s">$100K</span><span class="new" style="--d:.2s">$200K</span>
        <span class="sp"></span>
        <span class="op">−</span><span class="lb">Cost of goods</span><span class="old x" style="--d:1.5s">$60K</span><span class="new" style="--d:1.5s">$120K</span>
        <span class="op">−</span><span class="lb">Ad spend</span><span class="old">$28K</span><span class="new same" style="--d:1.9s">same</span>
        <span class="op"></span><span class="rule"><svg viewBox="0 0 100 6" preserveAspectRatio="none"><path d="M0 3.2 C 35 4.4, 65 2, 100 3"/></svg></span>
        <span class="op">=</span><span class="lb total">Net profit</span><span class="old total x" style="--d:2.4s">$12K</span><span class="hlw total" style="--d:2.4s"><span class="new total" style="--d:2.4s">$52K</span></span>
      </div>
      <div class="verdict" style="--d:3s"><strong>+333%</strong><span>profit, with the same ad spend.</span></div>
    </article>
  </div>
</section>

<style>

.rv-eq{--y:#fae194;--txt:#EDEAE0;--t2:rgba(237,234,224,.55);--t3:rgba(237,234,224,.32);--red:#ef8f8f;--green:#5ec98f}
.rv-eq{box-sizing:border-box;background:#131316;color:#EDEAE0;font-family:"Hanken Grotesk",sans-serif}
/* box-sizing only. A `.rv-eq *` reset is rewritten by Astro to
   `.rv-eq[data-astro-cid-…] [data-astro-cid-…]` — a descendant selector
   carrying TWO attributes, specificity (0,3,0) — which outranks every
   single-class rule in this file (0,2,0) and silently zeroes their
   margins and padding. Default margins are zeroed by Tailwind's
   preflight in the page, and by the reset in the standalone mockup's
   own <head>. Never put margin/padding back in here. */
.rv-eq,.rv-eq *{box-sizing:border-box}
.sec{max-width:1280px;margin:0 auto;padding:96px 32px}
.eyebrow{font-family:ui-monospace,Menlo,monospace;font-size:13px;letter-spacing:.24em;text-transform:uppercase;color:var(--y);margin-bottom:18px}
/* Scoped to the section on purpose: Astro rewrites the `*` reset above to
   `.rv-eq *[data-astro-cid-…]` (0,2,0), which outranks a bare `h2` (0,1,1) and
   silently zeroes this margin in the page. Keep the class prefix. */
.rv-eq h2{font-family:"Permanent Marker",cursive;font-weight:400;font-size:clamp(38px,5vw,68px);line-height:1.02;margin-bottom:64px;text-wrap:balance}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
@media(max-width:980px){.cards{grid-template-columns:1fr;max-width:620px;margin:0 auto}}
.card{position:relative;border-radius:22px;padding:44px 44px 40px;background:linear-gradient(180deg,#2d2e33 0%,#1b1c20 100%);box-shadow:0 2px 4px rgba(0,0,0,.5),0 30px 60px -12px rgba(0,0,0,.55)}
@media(max-width:600px){.card{padding:32px 20px 30px}}
.plan{font-family:"Permanent Marker",cursive;font-size:clamp(24px,2.4vw,32px);line-height:1.05;margin-bottom:30px}
.a .plan{color:var(--red)}.b .plan{color:var(--green)}
.eq{display:grid;grid-template-columns:34px minmax(0,1fr) auto auto;column-gap:10px;align-items:center}
.op{font-family:"Permanent Marker",cursive;font-size:26px;line-height:1;color:var(--txt);text-align:right;padding-right:2px}
.lb{font-size:clamp(19px,1.9vw,26px);font-weight:500;line-height:1.2;padding:9px 0}
.old,.new,.hlw{justify-self:end;white-space:nowrap}
.old{font-size:clamp(19px,1.9vw,26px);font-weight:500;font-variant-numeric:tabular-nums}
.new,.hlw{margin-left:14px}
.hlw .new{margin-left:0}
.old{position:relative;color:var(--txt)}
.old.x{color:var(--t2)}
.old.x::after{content:"";position:absolute;left:-4px;right:-4px;top:52%;height:1.8px;border-radius:1px;transform:rotate(-5deg) scaleX(0);transform-origin:left;transition:transform .35s ease var(--d)}
.a .old.x::after{background:var(--red)}.b .old.x::after{background:var(--green)}
.go .old.x::after{transform:rotate(-5deg) scaleX(1)}
.new{font-family:"Permanent Marker",cursive;font-size:clamp(22px,2.1vw,29px);line-height:1;opacity:0;transform:translateY(4px) rotate(-3deg);transition:opacity .35s ease calc(var(--d) + .3s),transform .35s ease calc(var(--d) + .3s)}
.a .new{color:var(--red)}.b .new{color:var(--green)}
.go .new{opacity:1;transform:rotate(-3deg)}
.new.same{font-family:"Caveat",cursive;font-weight:700;font-size:clamp(24px,2.3vw,30px)}
.rule{grid-column:2/5;height:0;margin:8px 0 4px}
.rule svg{display:block;width:100%;height:6px;overflow:visible}
.rule path{fill:none;stroke:var(--txt);stroke-width:2;stroke-linecap:round;vector-effect:non-scaling-stroke}
.sp{grid-column:1/-1;height:14px}
.lb.total,.old.total,.new.total,.hlw.total{font-weight:600}
.verdict{margin-top:30px;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;opacity:0;transition:opacity .5s ease var(--d)}
.go .verdict{opacity:1}
.verdict strong{font-family:"Permanent Marker",cursive;font-weight:400;font-size:clamp(40px,4vw,54px);line-height:1}
.a .verdict strong{color:var(--red)}.b .verdict strong{color:var(--green)}
.verdict span{font-size:17px;color:var(--t2)}
.hlw{position:relative;isolation:isolate;display:inline-block}
.hlw::before{content:"";position:absolute;left:-8px;right:-8px;top:12%;bottom:4%;background:rgba(94,201,143,.22);border-radius:3px;transform:skew(-8deg) scaleX(0);transform-origin:left;transition:transform .45s ease calc(var(--d) + .15s);z-index:-1}
.go .hlw::before{transform:skew(-8deg) scaleX(1)}
/* Narrow phones: the op + two value columns were starving the label track,
   wrapping "Average order value" onto four lines. Step everything down so the
   label keeps a usable measure; the two value columns stay right-aligned. */
@media(max-width:600px){
.sec{padding:64px 20px}
.eq{grid-template-columns:18px minmax(0,1fr) auto auto;column-gap:7px}
.op{font-size:20px}
.lb{font-size:15px;padding:7px 0}
.old{font-size:15px}
.new{font-size:17px}
.new.same{font-size:19px}
.new,.hlw{margin-left:9px}
}
@media (prefers-reduced-motion:reduce){.rv-eq *{transition:none!important}}

</style>

<script>
document.querySelectorAll('[data-rv]').forEach(function(s){
  var go=function(){s.classList.add('go');};
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){go();return;}
  var target=s.querySelector('.cards, .sheets')||s;
  var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){go();io.disconnect();}},{threshold:.25});
  io.observe(target);
});
</script>
