---
/**
 * Cards in the Revenue equation row: Traffic, Conversion, Revenue.
 *
 * Built on .glass-card so the hover treatment (scale + lift + yellow
 * border + mouse-tracked glow) matches the LeakCard surface used in the
 * stats section. The only variation here is layout/width:
 *
 *   - size="expand" (default): flex-1, fills the available row space
 *   - size="compact": fixed narrow width (Revenue, ~320 px so its body
 *     copy still fits in 3-4 readable lines)
 *
 * All cards stretch to the tallest sibling's height via the parent flex
 * row's default items-stretch. The hairline divider + body slot render
 * the same way regardless of size.
 */
export interface Props {
  icon: string;
  label: string;
  size?: 'expand' | 'compact';
}

const { icon, label, size = 'expand' } = Astro.props;
const isCompact = size === 'compact';
---

<div
  class:list={[
    'glass-card group rounded-xl p-xl flex flex-col gap-md transition-all reveal relative',
    isCompact ? 'equation-card--compact' : 'flex-1',
  ]}
>
  <span class="material-symbols-outlined text-4xl text-primary self-center">{icon}</span>
  <h3 class="text-white text-2xl font-bold tracking-tighter uppercase text-center">{label}</h3>
  <hr class="equation-card-divider" />
  <div class="equation-card-body">
    <slot />
  </div>
</div>
