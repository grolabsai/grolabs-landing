---
/**
 * Cards in the Revenue equation row: Traffic, Conversion, Revenue.
 *
 * Two sizes:
 *   - "expand" (default): flexes to fill available width, has a slot
 *     for bullets / body content under a hairline divider below the
 *     label. Used by Traffic + Conversion.
 *   - "compact": fixed narrow width (matches "REVENUE" with breathing
 *     room), no body content, just icon + label. Used by Revenue.
 *
 * All cards stretch to the tallest sibling's height (via the parent
 * flex container's default items-stretch) so the row always reads as
 * one aligned unit, regardless of how much bullet copy any one card has.
 */
export interface Props {
  icon: string;
  label: string;
  size?: 'expand' | 'compact';
}

const { icon, label, size = 'expand' } = Astro.props;
const isCompact = size === 'compact';
---

<div
  class:list={[
    'equation-card',
    isCompact ? 'equation-card--compact' : 'flex-1',
  ]}
>
  <span class="material-symbols-outlined text-4xl text-primary self-center">{icon}</span>
  <h3 class="text-white text-2xl font-bold tracking-tighter uppercase text-center">{label}</h3>
  {
    !isCompact && (
      <>
        <hr class="equation-card-divider" />
        <div class="equation-card-body">
          <slot />
        </div>
      </>
    )
  }
</div>
