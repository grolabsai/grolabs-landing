---
/**
 * Copy-to-clipboard helper that sits above the SearchDemo panel.
 *
 * The bone-coloured pill carries the three dietary keywords as both a
 * label AND the clipboard payload. Clicking it copies the text and the
 * adjacent CTA swaps to a "Copied — now paste it into the search box ↓"
 * confirmation that points down at the search panel below.
 *
 * No auto-fill — the visitor performs the paste themselves so the
 * moment the box receives the text and the pills light up green reads
 * as their action, not ours.
 */

const TRIO = 'gluten-free, sugar-free, dairy-free';
---

<div class="copy-helper" data-copy-helper>
  <button
    type="button"
    class="copy-helper-pill"
    data-copy-button
    data-copy-text={TRIO}
    aria-label={`Copy: ${TRIO}`}
  >
    <span class="material-symbols-outlined copy-helper-pill-icon">content_copy</span>
    <span class="copy-helper-pill-text">{TRIO}</span>
  </button>
  <span class="copy-helper-cta" data-copy-cta>
    Click to copy, then paste into the search box below.
  </span>
  <span class="copy-helper-feedback" data-copy-feedback hidden>
    <span class="material-symbols-outlined copy-helper-feedback-icon">check_circle</span>
    Copied — now paste it into the search box <span aria-hidden="true">↓</span>
  </span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy-helper]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-button]');
    const cta = root.querySelector<HTMLElement>('[data-copy-cta]');
    const feedback = root.querySelector<HTMLElement>('[data-copy-feedback]');
    if (!button || !cta || !feedback) return;

    let restoreTimer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      const text = button.dataset.copyText ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch (err) {
        // Older browsers / insecure contexts: fall back silently.
        console.warn('[copy-helper] clipboard write failed', err);
        return;
      }
      cta.hidden = true;
      feedback.hidden = false;
      if (restoreTimer) clearTimeout(restoreTimer);
      restoreTimer = setTimeout(() => {
        cta.hidden = false;
        feedback.hidden = true;
      }, 4000);
    });
  });
</script>

<style is:global>
  .copy-helper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
  }

  .copy-helper-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #EDEAE0;
    color: #0e0e11;
    border: 0;
    border-radius: 9999px;
    padding: 8px 16px 8px 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: transform 120ms ease, box-shadow 200ms ease, background 200ms ease;
  }
  .copy-helper-pill:hover {
    transform: translateY(-1px);
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(250, 225, 148, 0.2);
  }
  .copy-helper-pill:active {
    transform: translateY(0);
  }
  .copy-helper-pill-icon {
    font-size: 16px;
    flex-shrink: 0;
  }
  .copy-helper-pill-text {
    white-space: nowrap;
  }

  .copy-helper-cta {
    color: rgba(237, 234, 224, 0.5);
    font-size: 14px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }

  .copy-helper-feedback {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #10b981;
    font-size: 14px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-weight: 500;
  }
  .copy-helper-feedback-icon {
    font-size: 18px;
  }
</style>
