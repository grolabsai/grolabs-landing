---
/**
 * Copy-to-clipboard helper that sits above the SearchDemo panel.
 *
 * Layout: a gray CTA on the left, a yellow pill carrying the dietary
 * trio on the right. Clicking the pill writes the trio to the
 * clipboard and the left-hand message swaps from the CTA to a green
 * "Copied — now paste it into the search box ↓" confirmation. After
 * 4 s the confirmation reverts so the same helper works for the next
 * click.
 *
 * No auto-fill — the visitor performs the paste themselves so the
 * pills-light-up-green moment in the panel below reads as their
 * action, not the page's.
 */

const TRIO = 'gluten-free, sugar-free, dairy-free';
---

<div class="copy-helper" data-copy-helper>
  <div class="copy-helper-message">
    <span class="copy-helper-cta" data-copy-cta>
      Click to copy, then paste into the search box below.
    </span>
    <span class="copy-helper-feedback" data-copy-feedback hidden>
      <span class="material-symbols-outlined copy-helper-feedback-icon">check_circle</span>
      Copied — now paste it into the search box <span aria-hidden="true">↓</span>
    </span>
  </div>
  <button
    type="button"
    class="copy-helper-pill"
    data-copy-button
    data-copy-text={TRIO}
    aria-label={`Copy: ${TRIO}`}
  >
    <span class="material-symbols-outlined copy-helper-pill-icon">content_copy</span>
    <span class="copy-helper-pill-text">{TRIO}</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy-helper]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-button]');
    const cta = root.querySelector<HTMLElement>('[data-copy-cta]');
    const feedback = root.querySelector<HTMLElement>('[data-copy-feedback]');
    if (!button || !cta || !feedback) return;

    let restoreTimer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      const text = button.dataset.copyText ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch (err) {
        // Older browsers / insecure contexts: fall back silently.
        console.warn('[copy-helper] clipboard write failed', err);
        return;
      }
      // Permanently retire the attention pulse — the visitor has now
      // discovered the button, so further looping animation just adds
      // visual noise.
      button.classList.add('copy-helper-pill--engaged');
      cta.hidden = true;
      feedback.hidden = false;
      if (restoreTimer) clearTimeout(restoreTimer);
      restoreTimer = setTimeout(() => {
        cta.hidden = false;
        feedback.hidden = true;
      }, 4000);
    });
  });
</script>

<style is:global>
  .copy-helper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
  }

  /* Message slot — holds the CTA OR the confirmation. Whichever isn't
     hidden takes its natural width and the pill follows on the right. */
  .copy-helper-message {
    display: inline-flex;
    align-items: center;
  }

  .copy-helper-cta {
    color: rgba(237, 234, 224, 0.5);
    font-size: 14px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }

  .copy-helper-feedback {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #10b981;
    font-size: 14px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-weight: 500;
  }
  /* Beat the .copy-helper-feedback display:inline-flex declaration so
     the [hidden] attribute actually hides on first render. */
  .copy-helper-cta[hidden],
  .copy-helper-feedback[hidden] {
    display: none;
  }
  .copy-helper-feedback-icon {
    font-size: 18px;
  }

  /* Yellow pill */
  .copy-helper-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fae194;
    color: #0e0e11;
    border: 0;
    border-radius: 9999px;
    padding: 8px 16px 8px 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: transform 120ms ease, box-shadow 200ms ease, background 200ms ease;

    /* Attention pulse — a soft yellow ring expanding outward, drawing
       the eye to the CTA. Stops on hover, on focus, and permanently
       after the visitor clicks (.copy-helper-pill--engaged). */
    animation: copy-helper-pulse 2s ease-in-out infinite;
  }
  .copy-helper-pill:hover,
  .copy-helper-pill:focus-visible {
    animation: none;
    transform: translateY(-1px);
    background: #fce8a8;
    box-shadow: 0 4px 16px rgba(250, 225, 148, 0.32);
  }
  .copy-helper-pill:active {
    transform: translateY(0);
  }
  .copy-helper-pill--engaged,
  .copy-helper-pill--engaged:hover,
  .copy-helper-pill--engaged:focus-visible {
    animation: none;
    box-shadow: none;
  }
  .copy-helper-pill-icon {
    font-size: 16px;
    flex-shrink: 0;
  }
  .copy-helper-pill-text {
    white-space: nowrap;
  }

  @keyframes copy-helper-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 0 rgba(250, 225, 148, 0.55),
        0 0 18px 0 rgba(250, 225, 148, 0.35);
    }
    50% {
      box-shadow:
        0 0 0 10px rgba(250, 225, 148, 0),
        0 0 22px 4px rgba(250, 225, 148, 0.55);
    }
  }

  /* Users who've opted out of motion get a static, glow-only pill. */
  @media (prefers-reduced-motion: reduce) {
    .copy-helper-pill {
      animation: none;
      box-shadow: 0 0 18px 0 rgba(250, 225, 148, 0.3);
    }
  }
</style>
