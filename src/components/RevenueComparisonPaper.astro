---
// RevenueComparisonPaper.astro — same content, printed P&L sheet style (ALTERNATIVE)
// Use this OR RevenueComparison.astro, not both.
// Fonts required (already loaded in BaseLayout): Hanken Grotesk, Permanent Marker, Caveat, Special Elite.
---
<section class="rv-paper py-2xl md:py-3xl px-margin-mobile md:px-margin-desktop" data-rv data-screen-label="P&L annotated">
  <div class="max-w-page mx-auto">
  <div class="font-mono tracking-[0.2em] text-xs uppercase text-primary mb-2 md:mb-4 block">Best way to double revenue?</div>
  <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-lg md:mb-[48px]">Increase ad spend?</h2>

  <div class="sheets">
    <!-- PLAN A -->
    <article class="sheet a">
      <div class="plan">Plan A: spend more on ads</div>
      <div class="ph"><span class="s">Your store &middot; per month</span></div>
      <div class="row"><span class="lab">Visitors<span class="note" style="--d:1.3s">need 2&times; &rarr;</span></span><span class="v x" style="--d:1s">100K</span><span class="n"><span class="hw" style="--d:1s">200K</span></span></div>
      <div class="row"><span>Conversion rate</span><span class="v">1.0%</span><span class="n"><span class="carry">1.0%</span></span></div>
      <div class="row"><span>Average order value</span><span class="v">$100</span><span class="n"><span class="carry">$100</span></span></div>
      <div class="row subtotal"><span class="lab">Revenue<span class="note" style="--d:0.5s">goal: 2&times; &rarr;</span></span><span class="v x" style="--d:0.2s">$100K</span><span class="n"><span class="hw" style="--d:0.2s">$200K</span></span></div>
      <div class="row"><span>Cost of goods</span><span class="v x" style="--d:2s">$60K</span><span class="n"><span class="hw" style="--d:2s">$120K</span></span></div>
      <div class="row"><span class="lab">Ad spend<span class="note" style="--d:1.8s">clicks get pricier &rarr;</span></span><span class="v x" style="--d:1.5s">$28K</span><span class="n" style="--d:1.5s"><span class="circ"><span class="hw">$66K</span><svg class="loop" viewBox="0 0 100 40" preserveAspectRatio="none"><path pathLength="1" vector-effect="non-scaling-stroke" d="M8 22 C 6 8, 40 3, 62 4 C 86 5, 97 13, 95 23 C 92 34, 60 38, 38 37 C 16 36, 3 30, 9 18 C 12 12, 22 8, 30 7"/></svg></span></span></div>
      <div class="row total"><span>Profit</span><span class="v x" style="--d:2.4s">$12K</span><span class="n"><span class="hw big" style="--d:2.4s">$14K</span></span></div>
      <div class="verdict" style="--d:3s"><strong>+17%</strong><span>profit, after +136% ad spend.</span></div>
    </article>

    <!-- PLAN B -->
    <article class="sheet b">
      <div class="plan">Plan B: convert more, increase average order value</div>
      <div class="ph"><span class="s">Your store &middot; per month</span></div>
      <div class="row"><span>Visitors</span><span class="v"><span class="tag" style="--d:1s">same!</span>100K</span><span class="n"><span class="carry">100K</span></span></div>
      <div class="row"><span class="lab">Conversion rate<span class="note" style="--d:1.3s">half the lift &rarr;</span></span><span class="v x" style="--d:1s">1.0%</span><span class="n"><span class="hw" style="--d:1s">1.4%</span></span></div>
      <div class="row"><span class="lab">Average order value<span class="note" style="--d:1.8s">the other half &rarr;</span></span><span class="v x" style="--d:1.5s">$100</span><span class="n"><span class="hw" style="--d:1.5s">$143</span></span></div>
      <div class="row subtotal"><span class="lab">Revenue<span class="note" style="--d:0.5s">goal: 2&times; &rarr;</span></span><span class="v x" style="--d:0.2s">$100K</span><span class="n"><span class="hw" style="--d:0.2s">$200K</span></span></div>
      <div class="row"><span>Cost of goods</span><span class="v x" style="--d:2s">$60K</span><span class="n"><span class="hw" style="--d:2s">$120K</span></span></div>
      <div class="row"><span>Ad spend</span><span class="v"><span class="tag" style="--d:2.2s">same!</span>$28K</span><span class="n"><span class="carry">$28K</span></span></div>
      <div class="row total"><span>Profit</span><span class="v x" style="--d:2.4s">$12K</span><span class="n" style="position:relative;isolation:isolate"><span class="hl" style="--d:2.4s"></span><span class="hw big" style="--d:2.4s">$52K</span></span></div>
      <div class="verdict" style="--d:3s"><strong>+333%</strong><span>profit, with the same ad spend.</span></div>
      <p class="engine" style="--d:3.4s">Our Revenue Recovery Engine increases both conversion rate and average order value to increase profit without increasing ad spend.</p>
    </article>
  </div>
  </div>
</section>

<style>

.rv-paper{--y:#fae194;--ink:#131316;--paper:#f7f4ec;--print:#2b2a27;--print2:#77736a;--red:#c8372d;--green:#1f8a4c;--hl:rgba(250,225,148,.85)}
/* canvas-deeper, not canvas: this section sits between the hero and the
   leak-score section, which are both on canvas. Alternating is what keeps
   them reading as separate blocks. Token from docs/STYLEGUIDE.md. */
.rv-paper{box-sizing:border-box;background:#0E0E11;color:#EDEAE0;font-family:"Hanken Grotesk",sans-serif}
/* box-sizing only. A `.rv-paper *` reset is rewritten by Astro to
   `.rv-paper[data-astro-cid-…] [data-astro-cid-…]` — a descendant selector
   carrying TWO attributes, specificity (0,3,0) — which outranks every
   single-class rule in this file (0,2,0) and silently zeroes their
   margins and padding. Default margins are zeroed by Tailwind's
   preflight in the page, and by the reset in the standalone mockup's
   own <head>. Never put margin/padding back in here. */
.rv-paper,.rv-paper *{box-sizing:border-box}

/* The section heading is the site-wide one — font-marker/uppercase/text-4xl
   md:text-5xl, per docs/STYLEGUIDE.md — set as classes on the element, not
   redefined here. This component previously carried its own larger scale,
   which is why its title did not match the sections around it. */
.rv-paper h2{text-wrap:balance}
.sub{font-size:clamp(17px,1.5vw,21px);line-height:1.55;color:rgba(237,234,224,.7);max-width:620px;text-wrap:pretty;margin-bottom:64px}
.sheets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px;align-items:start}
@media(max-width:980px){.sheets{grid-template-columns:1fr;gap:48px;max-width:600px;margin:0 auto}}
/* paper */
.sheet{position:relative;background:var(--paper);color:var(--print);padding:40px 40px 34px;border-radius:3px;font-family:"Special Elite",monospace;
  box-shadow:0 1px 2px rgba(0,0,0,.4),0 30px 60px -18px rgba(0,0,0,.8)}
.sheet.a{transform:rotate(-1.1deg)}
.sheet.b{transform:rotate(.9deg);margin-top:26px}
@media(max-width:980px){.sheet.a,.sheet.b{transform:none;margin-top:0}}
.sheet::before{content:"";position:absolute;inset:0;border-radius:3px;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.018) 0 1px,transparent 1px 3px)}
.plan{position:absolute;top:-24px;right:22px;font-family:"Permanent Marker",cursive;font-size:25px;line-height:1;transform:rotate(-3deg);padding:6px 12px;border-radius:4px;background:var(--paper);box-shadow:0 6px 14px -6px rgba(0,0,0,.3)}
.a .plan{color:var(--red)} .b .plan{color:var(--green)}
.ph{display:flex;justify-content:flex-end;align-items:baseline;border-bottom:1.5px solid var(--print);padding-bottom:10px;margin-bottom:6px}
.ph .t{font-size:19px;letter-spacing:.08em}
.ph .s{font-size:14px;color:var(--print2)}
.row{display:grid;grid-template-columns:minmax(0,1fr) auto 132px;align-items:center;gap:12px;min-height:46px;border-bottom:1px dotted rgba(43,42,39,.28);font-size:17.5px}
.row.total{border-bottom:0;border-top:1.5px solid var(--print);margin-top:4px;min-height:64px;font-size:19px}
/* `subtotal`, not `sub`: this file already has a `.sub` section-paragraph
   style (bone text, 64px bottom margin) and the row inherited both. */
.row.subtotal{border-top:1.5px solid var(--print);border-bottom:1px dotted rgba(43,42,39,.28);margin-top:4px}
.row .v{text-align:right;font-variant-numeric:tabular-nums;position:relative;justify-self:end}
.row .n{justify-self:end;position:relative;margin-right:14px}
/* strike */
.x::after{content:"";position:absolute;left:-4px;right:-4px;top:50%;height:1.6px;border-radius:1px;background:currentColor;transform:scaleX(0) rotate(-4deg);transform-origin:left;transition:transform .35s ease var(--d)}
.a .x::after{background:var(--red)} .b .x::after{background:var(--green)}
.x{transition:color .3s var(--d)}
.go .x{color:var(--print)}
.go .x::after{transform:scaleX(1) rotate(-4deg)}
/* handwritten new values */
.hw{font-family:"Permanent Marker",cursive;font-size:24px;line-height:1;white-space:nowrap;display:inline-block;opacity:0;transform:translateY(4px) rotate(-3deg);transition:opacity .35s ease calc(var(--d) + .3s),transform .35s ease calc(var(--d) + .3s)}
.a .hw{color:var(--red)} .b .hw{color:var(--green)}
.go .hw{opacity:1;transform:rotate(-3deg)}
/* An untouched line still prints its figure in the right-hand column, in
   the sheet's own typeface, so the column reads as a complete statement
   you can multiply and subtract straight down. */
.carry{font-variant-numeric:tabular-nums;color:var(--print)}
/* "same!" sits to the LEFT of the original figure, not in the new column. */
.tag{font-family:"Caveat",cursive;font-weight:700;font-size:27px;line-height:1;margin-right:10px;
  opacity:0;transition:opacity .35s ease calc(var(--d) + .3s)}
.a .tag{color:var(--red)} .b .tag{color:var(--green)}
.go .tag{opacity:1}
.hw.big{font-size:32px}
/* circle + highlighter */
.circ{position:relative;display:inline-block}
.loop{position:absolute;left:-12px;right:-12px;top:-10px;bottom:-10px;width:calc(100% + 24px);height:calc(100% + 20px);overflow:visible;pointer-events:none}
.loop path{fill:none;stroke-width:2.4;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .6s ease calc(var(--d) + .55s)}
.a .loop path{stroke:var(--red)} .b .loop path{stroke:var(--green)}
.go .loop path{stroke-dashoffset:0}
.hl{position:absolute;left:-8px;right:-8px;top:18%;bottom:10%;background:var(--hl);transform:skew(-8deg) scaleX(0);transform-origin:left;transition:transform .45s ease calc(var(--d) + .2s);z-index:-1;border-radius:2px}
.go .hl{transform:skew(-8deg) scaleX(1)}
/* margin notes */
.lab{display:flex;justify-content:space-between;align-items:center;gap:8px;min-width:0}
.note{position:static;transform:rotate(-4deg);font-size:23px!important;font-family:"Caveat",cursive;font-weight:700;font-size:24px;line-height:1.05;opacity:0;transition:opacity .4s ease var(--d);white-space:nowrap}
.a .note{color:var(--red)} .b .note{color:var(--green)}
.go .note{opacity:1}
.verdict{margin-top:22px;display:flex;align-items:baseline;gap:14px;font-family:"Caveat",cursive;font-weight:700;font-size:30px;line-height:1.1;opacity:0;transition:opacity .5s ease var(--d)}
.verdict strong{font-family:"Permanent Marker",cursive;font-weight:400;font-size:44px}
.a .verdict{color:var(--red)} .b .verdict{color:var(--green)}
.go .verdict{opacity:1}
/* Not part of the printed sheet: our claim, so it takes the brand yellow
   and the site's regular sans rather than the typewriter face. */
.engine{margin-top:22px;background:var(--y);color:#18181b;font-family:"Hanken Grotesk",sans-serif;
  font-size:16px;line-height:1.5;padding:16px 18px;border-radius:6px;text-wrap:pretty;
  opacity:0;transition:opacity .5s ease var(--d)}
.go .engine{opacity:1}
.foot{font-size:12.5px;color:rgba(237,234,224,.45);margin-top:40px;line-height:1.5;max-width:900px}
.close{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:32px;align-items:center;margin-top:64px}
@media(max-width:900px){.close{grid-template-columns:1fr}}
.close p{font-family:"Permanent Marker",cursive;font-size:clamp(26px,2.8vw,38px);line-height:1.2;text-wrap:balance;color:#EDEAE0}
.btn{display:inline-flex;font-weight:600;font-size:16px;padding:16px 30px;border-radius:9px;background:linear-gradient(180deg,#fbe9a8 0%,#fae194 55%,#f0d770 100%);color:#1a1a1a;text-decoration:none;white-space:nowrap;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 8px 24px -4px rgba(250,225,148,.35)}
.btn:hover{color:#1a1a1a;transform:translateY(-1px)}
/* Narrow phones: the fixed 118px annotation column plus the inline margin
   notes left the label nothing, so labels ran into the values and the
   absolutely-positioned plan tag sat on top of the sheet header. Step down,
   let the annotation column size to its content, drop the notes below their
   label, and put the plan tag back in the flow. Both value columns stay
   right-aligned. */
@media(max-width:600px){
.sheet{padding:26px 18px 24px}
.plan{position:static;display:inline-block;margin-bottom:14px;font-size:21px;box-shadow:none;padding:0}
.ph{padding-bottom:8px}
.ph .t{font-size:16px}
.ph .s{font-size:13px}
/* the annotation column stays a FIXED width: each .row is its own grid, so a
   content-sized track here would give every row a different value column. */
.row{grid-template-columns:minmax(0,1fr) auto 92px;gap:8px;font-size:15.5px;min-height:44px}
.row.total{font-size:17px;min-height:56px}
.lab{flex-direction:column;align-items:flex-start;gap:1px}
.note{font-size:18px!important;line-height:1}
.hw{font-size:20px}
.hw.big{font-size:25px}
.tag{font-size:22px;margin-right:8px}
.verdict{font-size:21px;gap:10px}
.engine{font-size:14.5px;padding:14px 15px;margin-top:18px}
.verdict strong{font-size:32px}
}
@media (prefers-reduced-motion:reduce){.rv-paper *{transition:none!important}}

</style>

<script>
document.querySelectorAll('[data-rv]').forEach(function(s){
  var go=function(){s.classList.add('go');};
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){go();return;}
  var target=s.querySelector('.cards, .sheets')||s;
  var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){go();io.disconnect();}},{threshold:.25});
  io.observe(target);
});
</script>
