---
// RevenueComparisonPaper.astro — same content, printed P&L sheet style (ALTERNATIVE)
// Use this OR RevenueComparison.astro, not both.
// Fonts required (already loaded in BaseLayout): Hanken Grotesk, Permanent Marker, Caveat, Special Elite.
---
<section class="rv-paper py-2xl md:py-3xl px-margin-mobile md:px-margin-desktop" data-rv data-screen-label="P&L annotated">
  <div class="max-w-page mx-auto">
  <div class="font-mono tracking-[0.2em] text-xs uppercase text-primary mb-2 md:mb-4 block">Growth strategies</div>
  <h2 class="font-marker uppercase text-white text-4xl md:text-5xl mb-md md:mb-lg">Traffic &rarr; Conversion</h2>
  <div class="sub">
    <p>Many companies believe traffic increase is the only way to drive sales, ignoring the science of conversion funnels.</p>
    <p>However, a 40% boost in conversion and order value far outweighs the high cost of doubling your ad spend.</p>
  </div>

  <div class="sheets">
    <!-- PLAN A -->
    <article class="sheet a">
      <div class="plan" style="--d:.1s">Plan A: spend more on ads</div>
      <div class="ph"><span class="s">Your store &middot; per month</span></div>
      <div class="row"><span class="lab">Visitors<span class="note" style="--d:1.3s">need 2&times; &rarr;</span></span><span class="v x" style="--d:1s">100K</span><span class="n"><span class="hw" style="--d:1s">200K</span></span></div>
      <div class="row"><span>Conversion</span><span class="v">1.0%</span><span class="n"><span class="carry">1.0%</span></span></div>
      <div class="row"><span>Order value</span><span class="v">$100</span><span class="n"><span class="carry">$100</span></span></div>
      <div class="row subtotal"><span class="lab">Revenue<span class="note" style="--d:0.5s">goal: 2&times; &rarr;</span></span><span class="v x" style="--d:0.2s">$100K</span><span class="n"><span class="hw" style="--d:0.2s">$200K</span></span></div>
      <div class="row"><span>Margin</span><span class="v">40%</span><span class="n"><span class="carry">40%</span></span></div>
      <div class="row"><span>Ad spend</span><span class="v x" style="--d:1.5s">$28K</span><span class="n" style="--d:1.5s"><span class="circ"><span class="hw">$56K</span><svg class="loop" viewBox="0 0 100 40" preserveAspectRatio="none"><path pathLength="1" vector-effect="non-scaling-stroke" d="M8 22 C 6 8, 40 3, 62 4 C 86 5, 97 13, 95 23 C 92 34, 60 38, 38 37 C 16 36, 3 30, 9 18 C 12 12, 22 8, 30 7"/></svg></span></span></div>
      <div class="row total"><span>Profit</span><span class="v x" style="--d:2.4s">$12K</span><span class="n"><span class="hw big" style="--d:2.4s">$24K</span></span></div>
      <div class="maths" style="--d:3s">
        <div class="msteps">
          <div class="mrow">$200K &times; 40% = $80K</div>
          <div class="mrow">$80K &minus; $56K = $24K</div>
          <div class="mrow">$24K &divide; $12K</div>
        </div>
        <div class="mans">
          <svg class="marrow" viewBox="0 0 100 40" aria-hidden="true">
            <path class="mshaft" pathLength="1" d="M6 32 C 28 33, 52 26, 80 16"/>
            <path class="mbarb" pathLength="1" d="M80 16 l -14 -2"/>
            <path class="mbarb" pathLength="1" d="M80 16 l -9 10"/>
        </svg>
          <div class="mres">2&times;</div>
        </div>
      </div>
    </article>

    <!-- PLAN B -->
    <article class="sheet b">
      <div class="plan" style="--d:.1s">Plan B: convert more, increase average order value</div>
      <div class="ph"><span class="s">Your store &middot; per month</span></div>
      <div class="row"><span>Visitors</span><span class="v"><span class="tag" style="--d:1s">same!</span>100K</span><span class="n"><span class="carry">100K</span></span></div>
      <div class="row"><span class="lab">Conversion<span class="note" style="--d:1.3s">+40% &rarr;</span></span><span class="v x" style="--d:1s">1.0%</span><span class="n"><span class="hw" style="--d:1s">1.4%</span></span></div>
      <div class="row"><span class="lab">Order value<span class="note" style="--d:1.8s">+43% &rarr;</span></span><span class="v x" style="--d:1.5s">$100</span><span class="n"><span class="hw" style="--d:1.5s">$143</span></span></div>
      <div class="row subtotal"><span class="lab">Revenue<span class="note" style="--d:0.5s">goal: 2&times; &rarr;</span></span><span class="v x" style="--d:0.2s">$100K</span><span class="n"><span class="hw" style="--d:0.2s">$200K</span></span></div>
      <div class="row"><span>Margin</span><span class="v">40%</span><span class="n"><span class="carry">40%</span></span></div>
      <div class="row"><span>Ad spend</span><span class="v"><span class="tag" style="--d:2.2s">same!</span>$28K</span><span class="n"><span class="carry">$28K</span></span></div>
      <div class="row"><span>Growth services</span><span class="v">&mdash;</span><span class="n"><span class="hw" style="--d:2.3s">$4K</span></span></div>
      <div class="row total"><span>Profit</span><span class="v x" style="--d:2.4s">$12K</span><span class="n" style="position:relative;isolation:isolate"><span class="hl" style="--d:2.4s"></span><span class="hw big" style="--d:2.4s">$48K</span></span></div>
      <div class="maths" style="--d:3s">
        <div class="msteps">
          <div class="mrow">$200K &times; 40% = $80K</div>
          <div class="mrow">$80K &minus; $28K &minus; $4K = $48K</div>
          <div class="mrow">$48K &divide; $12K</div>
        </div>
        <div class="mans">
          <svg class="marrow" viewBox="0 0 100 40" aria-hidden="true">
            <path class="mshaft" pathLength="1" d="M6 32 C 28 33, 52 26, 80 16"/>
            <path class="mbarb" pathLength="1" d="M80 16 l -14 -2"/>
            <path class="mbarb" pathLength="1" d="M80 16 l -9 10"/>
        </svg>
          <div class="mres">4&times;</div>
        </div>
      </div>
    </article>
  </div>

  <div class="summary">
    <article class="sheet c">
      <div class="plan" style="--d:.15s">Side by side</div>
      <div class="ph"><span class="s">Same revenue &middot; per month</span></div>
      <div class="crow chead"><span></span><span class="ca">Plan A</span><span class="cb">Plan B</span></div>
      <div class="crow"><span>Revenue uplift</span><span class="ca">+$100K</span><span class="cb">+$100K</span></div>
      <div class="crow"><span>Ad spend increase</span><span class="ca neg">+$28K</span><span class="cb">$0</span></div>
      <div class="crow"><span>Growth services</span><span class="ca">$0</span><span class="cb pos">$4K</span></div>
      <div class="crow"><span>Profit increase</span><span class="ca">+$12K</span><span class="cb">+$36K</span></div>
      <div class="crow"><span>Profit difference</span><span class="ca"></span><span class="cb pos">+$24K</span></div>
      <div class="crow ctotal"><span>Profit multiple</span><span class="ca" style="--d:.7s">2&times;</span><span class="cb" style="--d:1s">4&times;</span></div>
      <div class="engine" style="--d:1.5s">
        <p>Unlike risky upfront ad spend that offers no guarantees, our growth services are completely <span class="eng-hi">risk-free</span>&mdash;we bill at the end of the month after you clear the profit, <span class="eng-hi">protecting your monthly cash flow</span>.</p>
        <p>Marketing and ad spend are indispensable tools for growth. However, your existing investment holds massive, untapped revenue potential. We don&rsquo;t replace your marketing; we simply stop the leaks to extract maximum value from the traffic you&rsquo;ve already paid for.</p>
      </div>
    </article>
  </div>
  </div>
</section>

<style>

.rv-paper{--y:#fae194;--ink:#131316;--paper:#f7f4ec;--print:#2b2a27;--print2:#77736a;--red:#c8372d;--green:#1f8a4c;--hl:rgba(250,225,148,.85)}
/* canvas-deeper, not canvas: this section sits between the hero and the
   leak-score section, which are both on canvas. Alternating is what keeps
   them reading as separate blocks. Token from docs/STYLEGUIDE.md. */
.rv-paper{box-sizing:border-box;background:#0E0E11;color:#EDEAE0;font-family:"Hanken Grotesk",sans-serif}
/* box-sizing only. A `.rv-paper *` reset is rewritten by Astro to
   `.rv-paper[data-astro-cid-…] [data-astro-cid-…]` — a descendant selector
   carrying TWO attributes, specificity (0,3,0) — which outranks every
   single-class rule in this file (0,2,0) and silently zeroes their
   margins and padding. Default margins are zeroed by Tailwind's
   preflight in the page, and by the reset in the standalone mockup's
   own <head>. Never put margin/padding back in here. */
.rv-paper,.rv-paper *{box-sizing:border-box}

/* The section heading is the site-wide one — font-marker/uppercase/text-4xl
   md:text-5xl, per docs/STYLEGUIDE.md — set as classes on the element, not
   redefined here. This component previously carried its own larger scale,
   which is why its title did not match the sections around it. */
.rv-paper h2{text-wrap:balance}
.sub{font-size:clamp(17px,1.5vw,21px);line-height:1.55;color:rgba(237,234,224,.7);max-width:620px;text-wrap:pretty;margin-bottom:56px}
.sub p+p{margin-top:16px}
.sheets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px;align-items:start}
@media(max-width:980px){.sheets{grid-template-columns:1fr;gap:48px;max-width:600px;margin:0 auto}}
/* paper */
.sheet{position:relative;background:var(--paper);color:var(--print);padding:40px 40px 34px;border-radius:3px;font-family:"Special Elite",monospace;
  box-shadow:0 1px 2px rgba(0,0,0,.4),0 30px 60px -18px rgba(0,0,0,.8)}
.sheet.a{transform:rotate(-1.1deg)}
.sheet.b{transform:rotate(.9deg);margin-top:26px}
@media(max-width:980px){.sheet.a,.sheet.b{transform:none;margin-top:0}}
.sheet::before{content:"";position:absolute;inset:0;border-radius:3px;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.018) 0 1px,transparent 1px 3px)}
.plan{position:absolute;top:-24px;right:22px;font-family:"Permanent Marker",cursive;font-size:25px;line-height:1;transform:rotate(-3deg);padding:6px 12px;border-radius:4px;background:var(--paper);box-shadow:0 6px 14px -6px rgba(0,0,0,.3)}
.a .plan{color:var(--red)} .b .plan{color:var(--green)} .c .plan{color:var(--print)}
/* Marker is a pen mark, so it is written in; Special Elite is printed and
   is already on the sheet when it arrives. */
.plan{opacity:0;transition:opacity .3s ease var(--d),transform .3s ease var(--d)}
.go .plan{opacity:1}
.ph{display:flex;justify-content:flex-end;align-items:baseline;border-bottom:1.5px solid var(--print);padding-bottom:10px;margin-bottom:6px}
.ph .t{font-size:19px;letter-spacing:.08em}
.ph .s{font-size:14px;color:var(--print2)}
.row{display:grid;grid-template-columns:minmax(0,1fr) auto 132px;align-items:center;gap:12px;min-height:46px;border-bottom:1px dotted rgba(43,42,39,.28);font-size:17.5px}
.row.total{border-bottom:0;border-top:1.5px solid var(--print);margin-top:4px;min-height:64px;font-size:19px}
/* `subtotal`, not `sub`: this file already has a `.sub` section-paragraph
   style (bone text, 64px bottom margin) and the row inherited both. */
.row.subtotal{border-top:1.5px solid var(--print);border-bottom:1px dotted rgba(43,42,39,.28);margin-top:4px}
.row .v{text-align:right;font-variant-numeric:tabular-nums;position:relative;justify-self:end}
.row .n{justify-self:end;position:relative;margin-right:14px}
/* strike */
.x::after{content:"";position:absolute;left:-4px;right:-4px;top:50%;height:1.6px;border-radius:1px;background:currentColor;transform:scaleX(0) rotate(-4deg);transform-origin:left;transition:transform .35s ease var(--d)}
.a .x::after{background:var(--red)} .b .x::after{background:var(--green)}
.x{transition:color .3s var(--d)}
.go .x{color:var(--print)}
.go .x::after{transform:scaleX(1) rotate(-4deg)}
/* handwritten new values */
.hw{font-family:"Permanent Marker",cursive;font-size:24px;line-height:1;white-space:nowrap;display:inline-block;opacity:0;transform:translateY(4px) rotate(-3deg);transition:opacity .35s ease calc(var(--d) + .3s),transform .35s ease calc(var(--d) + .3s)}
.a .hw{color:var(--red)} .b .hw{color:var(--green)}
.go .hw{opacity:1;transform:rotate(-3deg)}
/* An untouched line still prints its figure in the right-hand column, in
   the sheet's own typeface, so the column reads as a complete statement
   you can multiply and subtract straight down. */
.carry{font-variant-numeric:tabular-nums;color:var(--print)}
/* "same!" sits to the LEFT of the original figure, not in the new column. */
.tag{font-family:"Caveat",cursive;font-weight:700;font-size:27px;line-height:1;margin-right:10px;
  opacity:0;transition:opacity .35s ease calc(var(--d) + .3s)}
.a .tag{color:var(--red)} .b .tag{color:var(--green)}
.go .tag{opacity:1}
.hw.big{font-size:32px}
/* circle + highlighter */
.circ{position:relative;display:inline-block}
.loop{position:absolute;left:-12px;right:-12px;top:-10px;bottom:-10px;width:calc(100% + 24px);height:calc(100% + 20px);overflow:visible;pointer-events:none}
.loop path{fill:none;stroke-width:2.4;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .6s ease calc(var(--d) + .55s)}
.a .loop path{stroke:var(--red)} .b .loop path{stroke:var(--green)}
.go .loop path{stroke-dashoffset:0}
.hl{position:absolute;left:-8px;right:-8px;top:18%;bottom:10%;background:var(--hl);transform:skew(-8deg) scaleX(0);transform-origin:left;transition:transform .45s ease calc(var(--d) + .2s);z-index:-1;border-radius:2px}
.go .hl{transform:skew(-8deg) scaleX(1)}
/* margin notes */
.lab{display:flex;justify-content:space-between;align-items:center;gap:8px;min-width:0}
.note{position:static;transform:rotate(-4deg);font-size:23px!important;font-family:"Caveat",cursive;font-weight:700;font-size:24px;line-height:1.05;opacity:0;transition:opacity .4s ease var(--d);white-space:nowrap}
.a .note{color:var(--red)} .b .note{color:var(--green)}
.go .note{opacity:1}
/* The bottom of each sheet shows how the figure was reached and nothing else. */
/* The rule is printed, so it is already there; the working is written a line
   at a time, then the arrow, then the answer it arrives at. */
.maths{margin-top:22px;padding-top:16px;border-top:1.5px solid var(--print);
  display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
.mrow{opacity:0;transition:opacity .25s ease var(--md)}
.go .mrow{opacity:1}
.msteps .mrow:nth-child(1){--md:calc(var(--d) - .4s)}
.msteps .mrow:nth-child(2){--md:calc(var(--d) - .2s)}
.msteps .mrow:nth-child(3){--md:var(--d)}
.mrow{font-family:"Caveat",cursive;font-weight:600;font-size:23px;line-height:1.25;white-space:nowrap}
/* The answer is set to the height of the three working lines beside it —
   3 lines x 1.25 line-height = 3.75x the working's own size — so the block
   reads as one square of ink rather than a line with a tail. */
.mans{display:flex;align-items:center;gap:18px;flex-shrink:0}
.mres{font-family:"Permanent Marker",cursive;font-size:calc(23px * 3.75);line-height:1;flex-shrink:0;
  opacity:0;transform:translateY(4px);
  transition:opacity .3s ease calc(var(--d) + .95s),transform .3s ease calc(var(--d) + .95s)}
.go .mres{opacity:1;transform:none}
/* hand stroke from the division to the answer it produces */
.marrow{flex:0 0 95px;height:38px;align-self:flex-end;margin-bottom:6px;overflow:visible}
.marrow path{fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;
  vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1}
.a .marrow path{stroke:var(--red)} .b .marrow path{stroke:var(--green)}
.go .marrow .mshaft{stroke-dashoffset:0;transition:stroke-dashoffset .5s ease-out calc(var(--d) + .25s)}
.go .marrow .mbarb{stroke-dashoffset:0;transition:stroke-dashoffset .18s ease-out calc(var(--d) + .78s)}
.a .mrow,.a .mres{color:var(--red)} .b .mrow,.b .mres{color:var(--green)}

/* Summary sheet: the two plans beside each other, nothing but the deltas. */
.summary{display:flex;justify-content:center;margin-top:64px}
.sheet.c{max-width:620px;transform:rotate(.6deg)}
.crow{display:grid;grid-template-columns:minmax(0,1fr) 110px 110px;align-items:baseline;gap:12px;
  min-height:48px;border-bottom:1px dotted rgba(43,42,39,.28);font-size:17.5px}
.crow .ca,.crow .cb{text-align:right;font-variant-numeric:tabular-nums}
.chead{border-bottom:1.5px solid var(--print);font-size:14px;letter-spacing:.06em}
.chead .ca{color:var(--red)} .chead .cb{color:var(--green)}
.crow .neg{color:var(--red)} .crow .pos{color:var(--green)}
.ctotal{border-bottom:0;border-top:1.5px solid var(--print);margin-top:4px;min-height:62px}
.ctotal .ca,.ctotal .cb{font-family:"Permanent Marker",cursive;font-size:28px;
  opacity:0;transform:translateY(4px) rotate(-3deg);
  transition:opacity .3s ease var(--d),transform .3s ease var(--d)}
.go .ctotal .ca,.go .ctotal .cb{opacity:1;transform:rotate(-3deg)}
.ctotal .ca{color:var(--red)} .ctotal .cb{color:var(--green)}

.verdict{margin-top:22px;display:flex;align-items:baseline;gap:14px;font-family:"Caveat",cursive;font-weight:700;font-size:30px;line-height:1.1;opacity:0;transition:opacity .5s ease var(--d)}
.verdict strong{font-family:"Permanent Marker",cursive;font-weight:400;font-size:44px}
.a .verdict{color:var(--red)} .b .verdict{color:var(--green)}
.go .verdict{opacity:1}
/* Not part of the printed sheet: our claim, so it takes the brand yellow
   and the site's regular sans rather than the typewriter face. */
.engine{margin-top:22px;background:#131316;color:#EDEAE0;font-family:"Hanken Grotesk",sans-serif;
  font-size:15.5px;line-height:1.55;padding:18px 20px;border-radius:6px;text-wrap:pretty;
  opacity:0;transition:opacity .5s ease var(--d)}
.engine p+p{margin-top:12px}
.eng-hi{color:var(--y);font-weight:600}
.go .engine{opacity:1}
.foot{font-size:12.5px;color:rgba(237,234,224,.45);margin-top:40px;line-height:1.5;max-width:900px}
.close{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:32px;align-items:center;margin-top:64px}
@media(max-width:900px){.close{grid-template-columns:1fr}}
.close p{font-family:"Permanent Marker",cursive;font-size:clamp(26px,2.8vw,38px);line-height:1.2;text-wrap:balance;color:#EDEAE0}
.btn{display:inline-flex;font-weight:600;font-size:16px;padding:16px 30px;border-radius:9px;background:linear-gradient(180deg,#fbe9a8 0%,#fae194 55%,#f0d770 100%);color:#1a1a1a;text-decoration:none;white-space:nowrap;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 8px 24px -4px rgba(250,225,148,.35)}
.btn:hover{color:#1a1a1a;transform:translateY(-1px)}
/* Narrow phones: the fixed 118px annotation column plus the inline margin
   notes left the label nothing, so labels ran into the values and the
   absolutely-positioned plan tag sat on top of the sheet header. Step down,
   let the annotation column size to its content, drop the notes below their
   label, and put the plan tag back in the flow. Both value columns stay
   right-aligned. */
@media(max-width:600px){
.sheet{padding:26px 18px 24px}
.plan{position:static;display:inline-block;margin-bottom:14px;font-size:21px;box-shadow:none;padding:0}
.ph{padding-bottom:8px}
.ph .t{font-size:16px}
.ph .s{font-size:13px}
/* the annotation column stays a FIXED width: each .row is its own grid, so a
   content-sized track here would give every row a different value column. */
.row{grid-template-columns:minmax(0,1fr) auto 84px;gap:8px;font-size:15.5px;min-height:44px}
.row.total{font-size:17px;min-height:56px}
/* the note stays on the label's line; the label text wraps if it must */
.lab{gap:6px}
.note{white-space:nowrap}
.note{font-size:16px!important;line-height:1}
.hw{font-size:20px}
.hw.big{font-size:25px}
.tag{font-size:22px;margin-right:8px}
.verdict{font-size:21px;gap:10px}
.engine{font-size:14px;padding:15px 16px;margin-top:18px}
.sub{margin-bottom:36px}
.mrow{font-size:19px}
.mres{font-size:calc(19px * 3.75)}
.maths{gap:6px}
/* back in line with the working: a 71px answer is 75px wide, which fits
   the 116px left beside it once the arrow is trimmed. */
.mans{gap:8px}
.marrow{flex:0 0 30px;height:16px;margin-bottom:6px}
.summary{margin-top:44px}
.sheet.c{transform:none}
.crow{grid-template-columns:minmax(0,1fr) 76px 76px;gap:8px;font-size:15px;min-height:44px}
.chead{font-size:12.5px}
.ctotal{min-height:56px}
.ctotal .ca,.ctotal .cb{font-size:23px}
.verdict strong{font-size:32px}
}
/* ── Scroll-driven: the pen follows the reader's thumb ─────────────────
   Every mark hangs off the SHEET's timeline, not its own. On its own
   timeline a mark low in the card is still early in its personal journey
   while the card is already fully on screen, so the bottom of the card sat
   blank — the answer worst of all, being last. Sharing the sheet's timeline
   means the whole card is written by the time the card has arrived.
   Ranges run over the sheet's entry phase and all finish by 62%, so nothing
   is still being written once the card is in view.
   Compositor-driven, so no scroll listener and no iOS momentum stutter.
   Browsers without view() keep the entry-triggered reveal above. */
@supports (animation-timeline: view()) {
  @keyframes penIn    { from { opacity: 0 } to { opacity: 1 } }
  @keyframes penWrite { from { opacity: 0; transform: translateY(4px) rotate(-3deg) }
                        to   { opacity: 1; transform: rotate(-3deg) } }
  @keyframes penStrike{ from { transform: scaleX(0) rotate(-4deg) }
                        to   { transform: scaleX(1) rotate(-4deg) } }
  @keyframes penSkew  { from { transform: skew(-8deg) scaleX(0) }
                        to   { transform: skew(-8deg) scaleX(1) } }
  @keyframes penWipe  { from { transform: scaleX(0) } to { transform: scaleX(1) } }
  @keyframes penDraw  { from { stroke-dashoffset: 1 } to { stroke-dashoffset: 0 } }

  .sheet { view-timeline-name: --sheet; }

  .sheet .plan, .sheet .note, .sheet .tag, .sheet .hw, .sheet .mrow, .sheet .mres,
  .sheet .engine, .sheet .ctotal .ca, .sheet .ctotal .cb, .sheet .hl,
  .sheet .x::after, .sheet .loop path, .sheet .marrow path, .sheet .rule.pen svg {
    animation-timeline: --sheet;
    animation-fill-mode: both;
    animation-timing-function: linear;
    transition: none;
  }
  .sheet .plan            { animation-name: penIn;     animation-range: entry 4%  entry 14%; }
  .sheet .x::after        { animation-name: penStrike; animation-range: entry 12% entry 24%; }
  .sheet .note,
  .sheet .tag             { animation-name: penIn;     animation-range: entry 18% entry 28%; }
  .sheet .hw              { animation-name: penWrite;  animation-range: entry 22% entry 34%; }
  .sheet .hl              { animation-name: penSkew;   animation-range: entry 30% entry 42%; }
  .sheet .loop path       { animation-name: penDraw;   animation-range: entry 32% entry 44%; }
  .sheet .rule.pen svg    { animation-name: penWipe;   animation-range: entry 20% entry 32%; }
  .sheet .mrow            { animation-name: penIn;     animation-range: entry 34% entry 46%; }
  .sheet .marrow .mshaft  { animation-name: penDraw;   animation-range: entry 44% entry 54%; }
  .sheet .marrow .mbarb   { animation-name: penDraw;   animation-range: entry 55% entry 59%; }
  .sheet .mres            { animation-name: penIn;     animation-range: entry 52% entry 62%; }
  .sheet .ctotal .ca,
  .sheet .ctotal .cb      { animation-name: penWrite;  animation-range: entry 30% entry 44%; }
  .sheet .engine          { animation-name: penIn;     animation-range: entry 44% entry 58%; }
}

@media (prefers-reduced-motion:reduce){.rv-paper *{transition:none!important;animation:none!important}}

</style>

<script>
// Each sheet writes itself when it arrives, so the three cards do not all
// play at once while two of them are still off screen. Every .go rule in this
// file targets a descendant of a sheet, so the class lives on the sheet.
document.querySelectorAll('[data-rv]').forEach(function (section) {
  var pending = [].slice.call(section.querySelectorAll('.sheet'));
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function write(sheet: Element) {
    sheet.classList.add('go');
    pending = pending.filter(function (s) { return s !== sheet; });
    if (!pending.length) removeEventListener('scroll', onScroll);
  }
  // A sheet is "reached" once any part of it has come up the screen, whether
  // or not an observer ever caught it mid-flight.
  function reached(sheet: Element) { return sheet.getBoundingClientRect().top < innerHeight; }

  if (reduce) { pending.slice().forEach(write); return; }

  var queued = false;
  function onScroll() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(function () {
      queued = false;
      pending.slice().forEach(function (s) { if (reached(s)) write(s); });
    });
  }
  // The observer handles the ordinary case. A fast flick can carry a sheet
  // from below the fold to above it inside one frame, crossing no threshold
  // at all, so a scroll backstop resolves anything it misses — otherwise the
  // card is left with its printed rows and none of its pen marks.
  addEventListener('scroll', onScroll, { passive: true });
  pending.slice().forEach(function (sheet) {
    if (reached(sheet)) { write(sheet); return; }
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) { write(sheet); io.disconnect(); }
    }, { threshold: 0.15 });
    io.observe(sheet);
  });
});
</script>
