---
// RevenueLeakPaper.astro — "Revenue Leak Score" in the printed-P&L metaphor.
// Paper counterpart of the rf-v2 section in index.astro. Same story: the
// printed statement stops at Actual revenue, and a pen adds the two lines
// the statement has no way to know about.
//
// Deliberate change from rf-v2: this is ENTRY-triggered, not scroll-scrubbed.
// A scrubbed timeline ties progress to scroll offset, and iOS throttles
// scroll events during momentum, so the pen stutters on exactly the device
// this page is designed for. IntersectionObserver fires once and the CSS
// transitions run on their own clock.
//
// Fonts (already loaded in BaseLayout): Hanken Grotesk, Permanent Marker,
// Caveat, Special Elite.

interface Props {
  /** Fallback target for the assessment-call link when Cal.js has not
   *  loaded. The page's document-level [data-booking-cta] handler
   *  intercepts the click first and opens the inline embed instead. */
  bookingUrl?: string;
}
const { bookingUrl = 'https://cal.com/tuncho-granados-uibzst/15min' } = Astro.props;
---
<section class="sec rl-paper" data-rl data-screen-label="Revenue leak score (paper)">
  <div class="grid">

    <span class="eyebrow">Ecommerce funnel</span>

    <div class="copy">
      <h2>Revenue Leak Score</h2>
      <p>Revenue Leaks occur when unnecessary friction prevents ready-to-buy
         customers from discovering, understanding, trusting, or purchasing
         the desired product.</p>
    </div>

    <aside class="askcard">
      <p class="ask">Do you know your revenue leak score?</p>
      <p class="ask-sub">We can help you find out in a <a
        href={bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-booking-cta
        class="asklink">free assessment call</a>.</p>
    </aside>

    <div class="sheetwrap">
      <article class="sheet">
        <div class="ph"><span class="t">REVENUE</span><span class="s">Your store · per month</span></div>

        <div class="eq">
          <div class="noteband">
            <span class="fixnote hwline" data-split style="--base:.15s">Fix revenue leaks</span>
          </div>

          <svg class="arrow" viewBox="0 0 74 262" preserveAspectRatio="none" aria-hidden="true">
            <path class="shaft" pathLength="1" d="M54 16 C 22 52, 12 142, 14 206 C 16 236, 18 247, 21 254"/>
            <path class="barb"  pathLength="1" d="M21 254 l 1.5 -11"/>
            <path class="barb"  pathLength="1" d="M21 254 l -8 -7"/>
          </svg>

          <div class="r"><span class="op"></span><span class="lb">Traffic</span><span class="sym"><svg viewBox="0 0 64 64" aria-label="traffic"><circle cx="32" cy="21" r="11" fill="currentColor"/><path d="M11 56 C11 38 53 38 53 56 Z" fill="currentColor"/></svg></span></div>

          <div class="r"><span class="op">&times;</span><span class="lb">Conversion</span><span class="sym">%</span></div>
          <div class="r"><span class="op">&times;</span><span class="lb">Average order value</span><span class="sym">$</span></div>

          <div class="rule printed"><svg viewBox="0 0 100 6" preserveAspectRatio="none"><path d="M0 3 C 30 2, 60 4.5, 100 2.6"/></svg></div>

          <div class="r"><span class="op">=</span><span class="lb">Actual revenue</span><span class="sym">$</span></div>

          <div class="r pen">
            <span class="op hw" style="--base:1.45s">+</span>
            <span class="lb hw hwline" data-split style="--base:1.6s">Recovered revenue</span>
            <span class="sym hw" style="--base:2.15s">$</span>
          </div>

          <div class="rule pen" style="--base:2.3s"><svg viewBox="0 0 100 6" preserveAspectRatio="none"><path class="ruleln" pathLength="1" d="M0 3.2 C 35 4.4, 65 2, 100 3"/></svg></div>

          <div class="r pen">
            <span class="op hw" style="--base:2.6s">=</span>
            <span class="lb hw hwline" data-split style="--base:2.72s">Potential revenue</span>
            <span class="sym hw big" style="--base:3.2s">$$</span>
          </div>
        </div>
      </article>
    </div>

  </div>
</section>

<style>
.rl-paper{--y:#fae194;--paper:#f7f4ec;--print:#2b2a27;--print2:#77736a;--green:#1f8a4c}
.rl-paper{box-sizing:border-box;background:#131316;color:#EDEAE0;font-family:"Hanken Grotesk",sans-serif}
/* box-sizing only. A `.rl-paper *` reset is rewritten by Astro to
   `.rl-paper[data-astro-cid-…] [data-astro-cid-…]` — a descendant selector
   carrying TWO attributes, specificity (0,3,0) — which outranks every
   single-class rule in this file (0,2,0) and silently zeroes their
   margins and padding. Default margins are zeroed by Tailwind's
   preflight in the page, and by the reset in the standalone mockup's
   own <head>. Never put margin/padding back in here. */
.rl-paper,.rl-paper *{box-sizing:border-box}
.sec{max-width:1280px;margin:0 auto;padding:96px 32px}

/* Stacked by default. From 860px the copy and the ask card share the top
   row — the card's top lines up with the title, not the eyebrow — and the
   sheet takes a full-width row beneath them. */
.grid{display:grid;grid-template-columns:1fr;gap:32px}
@media(min-width:860px){
  .grid{grid-template-columns:1.15fr 1fr;column-gap:56px;row-gap:0;align-items:start}
  .eyebrow{grid-column:1;grid-row:1}
  .copy{grid-column:1;grid-row:2}
  .askcard{grid-column:2;grid-row:2;align-self:start;justify-self:end}
  .sheetwrap{grid-column:1/-1;grid-row:3;margin-top:72px}
}

.eyebrow{display:block;font-family:ui-monospace,Menlo,monospace;font-size:13px;letter-spacing:.24em;text-transform:uppercase;color:var(--y);margin-bottom:18px}
/* Scoped to the section on purpose: Astro rewrites the `*` reset above to
   `.rl-paper *[data-astro-cid-…]` (0,2,0), which outranks a bare `h2` (0,1,1) and
   silently zeroes this margin in the page. Keep the class prefix. */
.rl-paper h2{font-family:"Permanent Marker",cursive;font-weight:400;font-size:clamp(34px,4.2vw,56px);line-height:1.06;margin-bottom:24px;text-wrap:balance}
.copy p{font-size:clamp(16px,1.5vw,19px);line-height:1.65;color:rgba(237,234,224,.7);max-width:46ch;text-wrap:pretty}

/* ── ask card (glass) ─────────────────────────────────────────────────── */
/* Same recipe as .lifted-glass on the page, minus the hover lift: the card
   itself is not a control, only the link inside it is. */
.askcard{width:100%;max-width:440px;padding:32px 34px;border:0;border-radius:18px;position:relative;isolation:isolate;
  background:linear-gradient(180deg,rgba(255,255,255,.13) 0%,rgba(255,255,255,.05) 36%,rgba(255,255,255,.012) 100%),rgba(28,29,36,.55);
  backdrop-filter:blur(18px) saturate(180%);-webkit-backdrop-filter:blur(18px) saturate(180%);
  box-shadow:0 18px 48px rgba(0,0,0,.5),inset 0 1px 1px rgba(255,255,255,.10)}
.askcard>*{position:relative;z-index:1}
.ask{color:#EDEAE0;font-size:clamp(20px,1.9vw,25px);line-height:1.3;font-weight:600;text-wrap:balance}
.ask-sub{margin-top:12px;color:#EDEAE0;font-size:clamp(15px,1.35vw,17px);line-height:1.55;text-wrap:pretty}
/* No underline at rest, as asked. The card text is white, so yellow already
   separates the link — but colour alone is not an affordance, so it also
   carries more weight than its sentence, underlines on hover, and keeps a
   focus ring for keyboard use. */
.asklink{color:var(--y);font-weight:700;text-decoration:none;cursor:pointer;border-radius:3px;
  text-underline-offset:3px;text-decoration-thickness:2px;transition:color .2s ease}
.asklink:hover{color:#fff1c2;text-decoration:underline}
.asklink:focus-visible{outline:2px solid var(--y);outline-offset:3px}
@media(max-width:768px){
  /* blur is the expensive part on phones */
  .askcard{backdrop-filter:none;-webkit-backdrop-filter:none;background:rgba(28,29,36,.92)}
}

/* ── the sheet ───────────────────────────────────────────────────────── */
.sheetwrap{display:flex;justify-content:center}
.sheet{position:relative;width:100%;max-width:440px;background:var(--paper);color:var(--print);
  padding:34px 40px 30px;border-radius:3px;font-family:"Special Elite",monospace;transform:rotate(-1deg);
  box-shadow:0 1px 2px rgba(0,0,0,.4),0 30px 60px -18px rgba(0,0,0,.8)}
@media(max-width:860px){.sheet{transform:none}}
.sheet::before{content:"";position:absolute;inset:0;border-radius:3px;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.018) 0 1px,transparent 1px 3px)}
.ph{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1.5px solid var(--print);padding-bottom:10px;margin-bottom:4px}
.ph .t{font-size:18px;letter-spacing:.1em}
.ph .s{font-size:12px;color:var(--print2)}

.eq{position:relative}
.noteband{min-height:56px;display:flex;align-items:center;padding-left:52px}
.fixnote{font-family:"Caveat",cursive;font-weight:700;font-size:26px;line-height:1;color:var(--green);transform:rotate(-3deg)}

/* op, then label and symbol side by side so each line reads as one phrase
   ("Conversion %"). The symbol stays a SIBLING of the label, never a child:
   the letter-splitting rewrites the label's contents and would eat it. */
.r{display:flex;align-items:center;min-height:50px;font-size:17px}
.op{flex:0 0 30px;margin-right:12px;font-size:19px;text-align:right}
.sym{margin-left:.35em;font-variant-numeric:tabular-nums}
.sym svg{width:19px;height:19px;display:inline-block;vertical-align:-3px}
.rule{height:0;margin:9px 0 7px}
.rule svg{display:block;width:100%;height:6px;overflow:visible}
.rule path{fill:none;stroke-width:1.8;stroke-linecap:round;vector-effect:non-scaling-stroke}
.rule.printed path{stroke:var(--print)}
.rule.pen path{stroke:var(--green);stroke-width:2.2}
/* wipe, not stroke-dash: these rules stretch with preserveAspectRatio="none"
   and already carry non-scaling-stroke, which renders a dash pattern in
   screen units and tears the line into pieces. */
.rule.pen svg{transform:scaleX(0);transform-origin:left;transition:transform .5s ease var(--base)}
.go .rule.pen svg{transform:scaleX(1)}

/* ── the pen ─────────────────────────────────────────────────────────── */
.hw{font-family:"Permanent Marker",cursive;color:var(--green)}
.r.pen .op,.r.pen .sym{font-size:22px}
.r.pen .lb{font-size:21px;transform:rotate(-1.2deg)}
.sym.big{font-size:26px}

.hw:not(.hwline){opacity:0;transform:translateY(4px) rotate(-3deg);
  transition:opacity .3s ease var(--base),transform .3s ease var(--base)}
.go .hw:not(.hwline){opacity:1;transform:rotate(-3deg)}
.r.pen .lb.hw{transform:none}
.go .r.pen .lb.hw{transform:none}

/* handwritten lines: letter by letter, so it reads as writing not fading */
.hwline .ltr{opacity:0;transition:opacity .16s ease calc(var(--base) + var(--i) * .03s)}
.go .hwline .ltr{opacity:1}

.arrow{position:absolute;left:-6px;top:34px;width:74px;height:262px;overflow:visible;pointer-events:none}
.arrow path{fill:none;stroke:var(--green);stroke-width:2.4;stroke-linecap:round;
  vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1}
.go .arrow .shaft{transition:stroke-dashoffset .62s ease .95s;stroke-dashoffset:0}
.go .arrow .barb{transition:stroke-dashoffset .16s ease 1.55s;stroke-dashoffset:0}

@media(max-width:600px){
.sec{padding:64px 20px}
.askcard{max-width:none;padding:26px 22px}
.sheet{padding:26px 20px 24px;max-width:none}
.ph .t{font-size:16px}
.noteband{min-height:48px;padding-left:44px}
.fixnote{font-size:22px}
.r{min-height:44px;font-size:14px}
.op{flex-basis:24px;margin-right:9px}
.op{font-size:17px}
.r.pen .op,.r.pen .sym{font-size:19px}
.r.pen .lb{font-size:17px}
.sym.big{font-size:22px}
.arrow{left:-4px;top:26px;width:56px;height:236px}
}

@media (prefers-reduced-motion:reduce){
.rl-paper *{transition:none!important}
.rl-paper .hw,.rl-paper .hwline .ltr{opacity:1;transform:none}
.rl-paper .arrow path{stroke-dashoffset:0}
.rl-paper .rule.pen svg{transform:scaleX(1)}
}
</style>

<script>
  document.querySelectorAll('[data-rl]').forEach(function (section) {
    // Split every handwritten line into letters so the pen writes across it
    // instead of the whole phrase fading in at once.
    section.querySelectorAll('[data-split]').forEach(function (el) {
      var text = el.textContent.trim();
      el.textContent = '';
      for (var i = 0; i < text.length; i++) {
        var s = document.createElement('span');
        s.className = 'ltr';
        s.style.setProperty('--i', String(i));
        s.textContent = text[i];
        if (text[i] === ' ') s.style.whiteSpace = 'pre';
        el.appendChild(s);
      }
    });

    var go = function () { section.classList.add('go'); };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { go(); return; }
    var io = new IntersectionObserver(function (e) {
      if (e[0].isIntersecting) { go(); io.disconnect(); }
    }, { threshold: .3 });
    io.observe(section.querySelector('.sheet') || section);
  });
</script>
