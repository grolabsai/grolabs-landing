---
/**
 * Cloudflare Stream video embed.
 *
 * ⚠️ Design tokens (colors, fonts, radius, shadow) come from
 * docs/STYLEGUIDE.md. The 16:9 container uses the same lifted-card
 * treatment as the hero stat cards (fill #1c1d24, hairline border,
 * 16px radius, floating-card shadow).
 *
 * Renders NOTHING unless PUBLIC_CF_STREAM_URL is set, so local dev and
 * any unconfigured environment stay clean — same graceful-fallback
 * pattern as PUBLIC_BOOKING_URL (booking CTA) and PUBLIC_GA4_ID
 * (Analytics). Never hardcode a video URL.
 *
 * The URL is the official Cloudflare Stream iframe src, copied from the
 * video's "Embed" tab — e.g.
 *   https://customer-<code>.cloudflarestream.com/<id>/iframe
 *
 * Swapping the video is a ONE-VARIABLE change: update PUBLIC_CF_STREAM_URL
 * and the poster thumbnail is re-derived from it automatically (no code or
 * per-page edits). Optional env knobs:
 *   PUBLIC_CF_STREAM_POSTER_TIME — frame to grab as the poster, e.g. "60s".
 *     Unset → Cloudflare uses the video's dashboard-configured thumbnail.
 */
interface Props {
  /** Accessible title for the iframe. */
  title?: string;
  /**
   * Optional poster (preview) image URL — an explicit override. Normally
   * LEAVE THIS UNSET: the poster is auto-derived from PUBLIC_CF_STREAM_URL
   * (+ PUBLIC_CF_STREAM_POSTER_TIME) so a video swap needs no code change.
   * Only pass this to point at a thumbnail that isn't this video's own.
   */
  poster?: string;
  /**
   * Player accent color (Cloudflare Stream `primaryColor` param) — recolors
   * the center play button and its ring, the progress bar, and other control
   * accents. The iframe is cross-origin, so this is the ONLY way to restyle
   * the play button; our own CSS can't reach inside. Defaults to the GroLabs
   * brand yellow (#fae194 — see docs/STYLEGUIDE.md).
   */
  primaryColor?: string;
  /**
   * Optional DOM id for the underlying <iframe>. Set this when an external
   * button needs to control playback via the Cloudflare Stream SDK
   * (`Stream(document.getElementById(id)).play()`). Omit for a plain embed.
   */
  iframeId?: string;
  /**
   * Poster frame to grab, e.g. "1.1s". Takes precedence over the
   * PUBLIC_CF_STREAM_POSTER_TIME env var — use it to pin the thumbnail
   * frame in code when the deploy env can't be changed. When omitted, the
   * env var (or the Cloudflare dashboard default) decides.
   */
  posterTime?: string;
}

const { title = 'GroLabs video', poster, primaryColor = '#fae194', iframeId, posterTime } = Astro.props;
const baseUrl = import.meta.env.PUBLIC_CF_STREAM_URL;
const effectivePosterTime = posterTime ?? import.meta.env.PUBLIC_CF_STREAM_POSTER_TIME;

// Derive the poster from the embed URL so swapping the video is a single
// env change. Strip `/iframe` (and any query) off the base to get the
// video root, then point at its thumbnail endpoint. An explicit `poster`
// prop still wins; PUBLIC_CF_STREAM_POSTER_TIME picks the frame.
const derivedPoster = baseUrl
  ? `${baseUrl.replace(/\/iframe.*$/, '')}/thumbnails/thumbnail.jpg${effectivePosterTime ? `?time=${encodeURIComponent(effectivePosterTime)}` : ''}`
  : undefined;
const effectivePoster = poster ?? derivedPoster;

// Append player params (poster, primaryColor, controls) — URLSearchParams
// handles encoding, including the `#` in the hex color and the `?` inside
// the poster's own thumbnail URL. Respects any query string already on the
// configured embed URL.
//
// controls=false hides the player's native UI — crucially the center play
// button, which would otherwise overlap our own pill (.video-play-pill).
// The cross-origin player exposes no way to hide just that button, so we
// suppress all native controls up front and turn them back on via the SDK
// (player.controls = true) the moment playback starts (see script below),
// so viewers still get the scrubber / pause / fullscreen while watching.
let streamUrl: string | undefined;
if (baseUrl) {
  const params = new URLSearchParams();
  if (effectivePoster) params.set('poster', effectivePoster);
  if (primaryColor) params.set('primaryColor', primaryColor);
  params.set('controls', 'false');
  const qs = params.toString();
  streamUrl = qs ? `${baseUrl}${baseUrl.includes('?') ? '&' : '?'}${qs}` : baseUrl;
}
---

{streamUrl && (
  <Fragment>
    <div class="video-embed max-w-page mx-auto">
      <div class="video-embed-frame">
        <iframe
          id={iframeId}
          src={streamUrl}
          title={title}
          loading="lazy"
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
          allowfullscreen
        ></iframe>
        {/* Play affordance over the iframe. The Cloudflare player is
            cross-origin so we can't restyle its native button; instead we
            layer our own — the same pulsing yellow pill as the search-demo
            copy button (SearchCopyHelper) — and start playback via the
            Stream SDK on click. Hidden once playback begins. Also covers a
            missing poster. */}
        <div class="video-play-overlay">
          <button type="button" class="video-play-pill" aria-label="Play video" data-video-play>
            <span class="material-symbols-outlined video-play-pill-icon" aria-hidden="true">play_arrow</span>
            <span class="video-play-pill-text">Play video</span>
          </button>
        </div>
      </div>
    </div>
    {/* Cloudflare Stream player SDK (no npm dep). Drives an optional
        external [data-watch-video] button and forwards player events to
        GA4, so all video stats live in Analytics — no need to read them
        from the Cloudflare dashboard. gtag is a no-op until it loads /
        consent is granted, so calls are always safe. */}
    <script is:inline src="https://embed.cloudflarestream.com/embed/sdk.latest.js"></script>
    <script is:inline>
      (function () {
        var iframe = document.querySelector('.video-embed-frame iframe');
        if (!iframe || !window.Stream) return;
        var player = window.Stream(iframe);

        // External "Watch video" buttons (hero + video section) scroll the
        // player into view and start it. querySelectorAll so every such
        // button is wired, not just the first.
        document.querySelectorAll('[data-watch-video]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            iframe.scrollIntoView({ behavior: 'smooth', block: 'center' });
            player.play().catch(function () {});
          });
        });

        // Our pill play button overlaying the iframe.
        var overlay = document.querySelector('.video-play-overlay');
        var playBtn = document.querySelector('[data-video-play]');
        if (playBtn) {
          playBtn.addEventListener('click', function () {
            player.play().catch(function () {});
          });
        }
        // Hide our pill once playback begins, and restore the player's
        // native controls (loaded with controls=false so its center play
        // button never overlaps the pill) so viewers get scrubber / pause /
        // fullscreen while watching.
        player.addEventListener('play', function () {
          if (overlay) overlay.hidden = true;
          player.controls = true;
        });

        // GA4 video analytics — single source of truth in Analytics.
        function track(name, params) {
          if (typeof window.gtag !== 'function') return;
          window.gtag('event', name, Object.assign({
            video_provider: 'cloudflare',
            video_title: iframe.title || 'GroLabs video',
          }, params));
        }
        var started = false;
        var completed = false;
        var dropSent = false;
        var lastTime = 0;
        var lastDuration = 0;
        // Finer milestones than GA's default so the progress histogram
        // doubles as a reliable (alive-page) aggregate drop-off curve.
        var milestones = [10, 25, 50, 75];
        player.addEventListener('play', function () {
          if (started) return;
          started = true;
          track('video_start', { video_percent: 0 });
        });
        player.addEventListener('timeupdate', function () {
          var d = player.duration, t = player.currentTime;
          if (!d) return;
          lastTime = t;
          lastDuration = d;
          var pct = (t / d) * 100;
          while (milestones.length && pct >= milestones[0]) {
            track('video_progress', { video_percent: milestones.shift() });
          }
        });
        player.addEventListener('ended', function () {
          completed = true;
          track('video_complete', {
            video_percent: 100,
            video_seconds: Math.round(lastDuration),
          });
        });

        // Best-effort exact drop-off point. Fires when the visitor truly
        // leaves the page (pagehide) after starting but before finishing.
        // gtag sends this via sendBeacon, so it's best-effort and may be
        // dropped (esp. on mobile) — the progress milestones above are the
        // reliable aggregate signal. pagehide (not visibilitychange) avoids
        // false positives from tab-switching where the visitor returns.
        window.addEventListener('pagehide', function () {
          if (!started || completed || dropSent) return;
          dropSent = true;
          var pct = lastDuration ? Math.round((lastTime / lastDuration) * 100) : 0;
          track('video_drop_off', {
            video_percent: pct,
            video_seconds: Math.round(lastTime),
            video_duration: Math.round(lastDuration),
          });
        });
      })();
    </script>
  </Fragment>
)}

<style>
  /* 16:9 responsive container. Borderless, but carries the same
     floating-card drop shadow as the hero stat cards (style guide
     "lifted-card treatment"). overflow:hidden so the iframe's corners
     follow the 16px radius. */
  .video-embed-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #1c1d24;
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 2px 4px rgba(0, 0, 0, 0.5),
      0 30px 60px -12px rgba(0, 0, 0, 0.65),
      0 60px 120px -24px rgba(0, 0, 0, 0.55);
  }
  .video-embed-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* Play affordance — the same pulsing yellow pill as the search-demo
     copy button (SearchCopyHelper). The overlay wrapper is a full-frame
     flex-center layer with pointer-events:none so only the pill itself is
     interactive and the rest of the poster stays clickable. */
  .video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .video-play-overlay[hidden] { display: none; }
  .video-play-pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fae194;
    color: #0e0e11;
    border: 0;
    border-radius: 9999px;
    padding: 10px 20px 10px 16px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: transform 120ms ease, box-shadow 200ms ease, background 200ms ease;
    /* Attention pulse — soft yellow ring expanding outward; stops on
       hover / focus (matches the search-demo pill). */
    animation: video-play-pulse 2s ease-in-out infinite;
  }
  .video-play-pill:hover,
  .video-play-pill:focus-visible {
    animation: none;
    transform: translateY(-1px);
    background: #fce8a8;
    box-shadow: 0 4px 16px rgba(250, 225, 148, 0.32);
  }
  .video-play-pill:active { transform: translateY(0); }
  .video-play-pill-icon { font-size: 20px; flex-shrink: 0; }
  .video-play-pill-text { white-space: nowrap; }

  @keyframes video-play-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 0 rgba(250, 225, 148, 0.55),
        0 0 18px 0 rgba(250, 225, 148, 0.35);
    }
    50% {
      box-shadow:
        0 0 0 12px rgba(250, 225, 148, 0),
        0 0 22px 4px rgba(250, 225, 148, 0.55);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-play-pill {
      animation: none;
      box-shadow: 0 0 18px 0 rgba(250, 225, 148, 0.3);
    }
  }
</style>
