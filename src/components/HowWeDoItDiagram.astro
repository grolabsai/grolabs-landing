---
/**
 * Architecture diagram for the "Optimize catalog & search engine"
 * section.
 *
 * Two-column layout: data sources on the left feed an AI agent on the
 * right — represented by the grow-dashboard SVG. The dashboard mockup
 * doubles as the visual story for the agent's role; no need for an
 * explicit "AI agent" panel here since the section title + the
 * dashboard imagery already say it.
 *
 * Left side: SEO and AEO are compressed to narrow title-only pills so
 * the Search box can claim the remaining width and split itself into
 * two text columns separated by a thin vertical hairline. Upward
 * arrows under each of SEO / AEO / Search signal that the catalog
 * below them feeds all three surfaces.
 *
 * Box surfaces match the rest of the page's inner-block recipe; the
 * eyebrow class on box titles mirrors the section eyebrows verbatim.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="how-diagram">
  <!-- LEFT: data sources -->
  <div class="how-diagram-col">
    <div class="how-diagram-trio">
      <div class="how-box how-box--narrow">
        <span class="how-box-eyebrow">SEO</span>
      </div>
      <div class="how-box how-box--narrow">
        <span class="how-box-eyebrow">AEO</span>
      </div>
      <div class="how-box how-box--search">
        <span class="how-box-eyebrow">Search</span>
        <div class="how-search-split">
          <div class="how-search-half">
            <p class="how-box-body">
              Typo tolerance, synonyms, and ranking that adapt to how your
              customers actually shop.
            </p>
          </div>
          <div class="how-search-half how-search-half--right">
            <p class="how-box-body how-search-placeholder">
              (right column content coming)
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Upward arrows — catalog feeds the SEO/AEO/Search trio above.
         Slot widths mirror the trio's flex layout so each arrow lands
         centred under the box it points at: narrow under SEO, narrow
         under AEO, then a wide slot that centres an arrow under the
         Search box regardless of viewport. -->
    <div class="how-diagram-trio-arrows" aria-hidden="true">
      <span class="how-trio-arrow-slot how-trio-arrow-slot--narrow">↑</span>
      <span class="how-trio-arrow-slot how-trio-arrow-slot--narrow">↑</span>
      <span class="how-trio-arrow-slot how-trio-arrow-slot--search">↑</span>
    </div>

    <div class="how-box">
      <span class="how-box-eyebrow">Product catalog</span>
      <p class="how-box-body">
        AI-assisted catalog management. No more Excel files. No more
        wrestling with the WooCommerce admin.
      </p>
    </div>

    <div class="how-box">
      <span class="how-box-eyebrow">User analytics &amp; conversion events</span>
      <p class="how-box-body">
        Every click, add-to-cart, and checkout step — captured and stitched
        to the products customers actually see.
      </p>
    </div>

    <div class="how-box">
      <span class="how-box-eyebrow">GA4 traffic</span>
      <p class="how-box-body">
        Traffic sources, sessions, and behavior pulled from your existing
        GA4 install — no re-instrumentation.
      </p>
    </div>
  </div>

  <!-- ARROWS: left-feeds-right. Three placements spread evenly. -->
  <div class="how-diagram-arrows" aria-hidden="true">
    <span class="how-arrow">→</span>
    <span class="how-arrow">→</span>
    <span class="how-arrow">→</span>
  </div>

  <!-- RIGHT: dashboard SVG carries the "AI agent watches this so you
       don't have to" story, sandwiched between two same-width bands:
         · Yellow positive band on top  — the agent's process cycle.
         · Red alert band below         — what triggers a heads-up. -->
  <div class="how-diagram-col how-diagram-col--right-image">
    <div class="how-right-stack">
      <div class="how-band how-band--positive">
        Measure → Fix → Verify uplift
      </div>

      <img
        src={`${base}/grow-dashboard.svg`}
        alt="An abstract analytics dashboard with KPI tiles, a line chart, and horizontal bars. A small yellow indicator in the top-right corner pulses to signal monitoring is live."
        class="how-diagram-image"
        loading="lazy"
      />

      <div class="how-band how-band--alert">
        <span class="material-symbols-outlined how-band-icon" aria-hidden="true">warning</span>
        <span>If a threshold is met, you will get a message in your preferred channel.</span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .how-diagram {
    display: grid;
    grid-template-columns: 1fr 56px 1fr;
    gap: 16px;
    align-items: stretch;
  }

  .how-diagram-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Trio row: SEO and AEO compressed to their content width, Search
     takes everything else and splits internally. */
  .how-diagram-trio {
    display: flex;
    gap: 8px;
  }
  /* Mirror the trio's flex layout so each arrow lands centred under
     the box it points at: SEO and AEO are narrow + min-width 64,
     Search takes the rest. */
  .how-diagram-trio-arrows {
    display: flex;
    gap: 8px;
    color: rgba(250, 225, 148, 0.5);
    font-size: 18px;
    line-height: 1;
    padding: 2px 0;
  }
  .how-trio-arrow-slot {
    text-align: center;
  }
  .how-trio-arrow-slot--narrow {
    flex: 0 0 auto;
    min-width: 64px;
  }
  .how-trio-arrow-slot--search {
    flex: 1;
  }

  .how-diagram-arrows {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
  }
  .how-arrow {
    color: rgba(250, 225, 148, 0.5);
    font-size: 26px;
    line-height: 1;
  }

  /* Base box surface — same recipe as funnel container + scenario +
     search panel. */
  .how-box {
    background: #131316;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 16px;
  }

  /* SEO / AEO: narrow title-only pills. Vertical layout means the
     title sits centred against the tall Search box next to it. */
  .how-box--narrow {
    flex: 0 0 auto;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
  }

  /* Search box takes the rest of the trio row. */
  .how-box--search {
    flex: 1;
    min-width: 0;
  }

  /* Two text columns inside Search, separated by a 1 px hairline. */
  .how-search-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 10px;
  }
  .how-search-half {
    min-width: 0;
  }
  .how-search-half--right {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    padding-left: 16px;
  }
  .how-search-placeholder {
    font-style: italic;
    color: rgba(237, 234, 224, 0.32);
  }

  /* Right column holds a vertical stack: yellow positive band →
     dashboard image → red alert band. The stack is centred vertically
     against the taller left column so the empty space splits above
     and below. */
  .how-diagram-col--right-image {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .how-right-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .how-diagram-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }

  /* Bands flanking the dashboard image — same width as the image,
     same rounded-xl corners. Yellow on top, red on bottom. */
  .how-band {
    border-radius: 12px;
    padding: 12px 16px;
  }
  .how-band--positive {
    background: #fae194;
    color: #0e0e11;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }
  .how-band--alert {
    /* leak-red token — see tailwind.config.js. Same red used in the
       funnel bar; the colour belongs to the page's red family. */
    background: #991B1B;
    color: #EDEAE0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }
  .how-band-icon {
    font-size: 22px;
    flex-shrink: 0;
  }

  /* Eyebrow — same Tailwind class string as every section eyebrow on
     the page (text-primary font-mono tracking-[0.2em] text-xs
     uppercase), inlined here so the diagram component is self-contained. */
  .how-box-eyebrow {
    display: block;
    color: #fae194;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.3;
    font-weight: 500;
  }

  .how-box-body {
    color: rgba(237, 234, 224, 0.62);
    font-size: 13px;
    line-height: 1.5;
    margin: 8px 0 0;
  }

  /* Mobile: collapse to a single column; arrows pivot to a horizontal
     row of down-pointing glyphs between the source and the agent. */
  @media (max-width: 900px) {
    .how-diagram {
      grid-template-columns: 1fr;
    }
    .how-diagram-arrows {
      flex-direction: row;
      justify-content: center;
      gap: 18px;
      padding: 4px 0;
    }
    .how-arrow {
      transform: rotate(90deg);
      display: inline-block;
    }
  }

  /* Tightest viewport: stack the trio row + the search split. The
     upward arrows disappear because they no longer point at anything
     spatially meaningful. */
  @media (max-width: 640px) {
    .how-diagram-trio {
      flex-direction: column;
    }
    .how-search-split {
      grid-template-columns: 1fr;
    }
    .how-search-half--right {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 12px;
    }
    .how-diagram-trio-arrows {
      display: none;
    }
  }
</style>
