---
/**
 * Live Meilisearch demo embedded in the landing page. Locale-aware
 * via the `locale` prop ('en' | 'es'). The search index data itself
 * stays English (snack-bar fixture in the demo Meilisearch index);
 * only the surrounding UI chrome localizes.
 */

interface Props {
  locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;

const STRINGS = {
  en: { placeholder: 'Search products…' },
  es: { placeholder: 'Busca productos…' },
}[locale];
---

<div class="search-demo lifted-glass" data-search-demo data-locale={locale}>
  <label class="search-demo-input-wrap">
    <span class="material-symbols-outlined search-demo-input-icon">search</span>
    <input
      type="search"
      data-search-input
      class="search-demo-input"
      placeholder={STRINGS.placeholder}
      autocomplete="off"
      spellcheck="false"
    />
  </label>

  <div class="search-demo-results" data-search-results aria-live="polite"></div>
</div>

<script>
  import { initSearchDemo } from '../scripts/search-demo.ts';

  document.querySelectorAll<HTMLElement>('[data-search-demo]').forEach((el) => {
    initSearchDemo(el);
  });
</script>

<style is:global>
  /* Panel — same surface treatment as the other inner blocks on the page
     (funnel container, scenario block). Now sits on the section's
     lighter bg-canvas — uses the same lifted-panel treatment as the
     hero cards: panel one tonal step ABOVE the page bg + a big soft
     drop shadow so the panel reads as floating above the surface. */
  .search-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    background: #1c1d24;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 16px;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.05) inset,
      0 2px 4px rgba(0,0,0,0.5),
      0 30px 60px -12px rgba(0,0,0,0.65),
      0 60px 120px -24px rgba(0,0,0,0.55);
  }

  /* Search input — sits one tone darker than the panel so it reads as
     an inset well. Rounded-xl corners match the panel + rows. */
  .search-demo-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    background: #0e0e11;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0 18px;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .search-demo-input-wrap:focus-within {
    border-color: rgba(250, 225, 148, 0.5);
    box-shadow: 0 0 0 3px rgba(250, 225, 148, 0.12);
  }
  .search-demo-input-icon {
    color: #fae194;
    font-size: 20px;
    margin-right: 10px;
    flex-shrink: 0;
  }
  .search-demo-input {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent;
    border: 0;
    outline: none;
    box-shadow: none;
    color: #EDEAE0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 16px;
    padding: 12px 0;
    width: 100%;
  }
  /* Be explicit across every focus state — some browsers paint a blue
     UA focus ring on inputs that the bare `outline:none` doesn't
     suppress, especially for type="search". The wrap already shows a
     yellow border + glow on :focus-within, which is the only focus
     affordance we want here. */
  .search-demo-input:focus,
  .search-demo-input:focus-visible,
  .search-demo-input:active {
    outline: none;
    box-shadow: none;
    border: 0;
  }
  .search-demo-input::-webkit-search-cancel-button,
  .search-demo-input::-webkit-search-decoration,
  .search-demo-input::-webkit-search-results-button,
  .search-demo-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
  }
  .search-demo-input::placeholder {
    color: rgba(237, 234, 224, 0.35);
  }

  /* Results column inside the panel. min-height reserves the space
     four populated rows will occupy (4×60 px row + 3×6 px gap +
     ~20 px status footer ≈ 280 px) so the panel doesn't visibly grow
     once a search runs. Empty state stays blank — no skeleton rows,
     no placeholder copy — but the slot is already there, balanced
     under the input and obvious that something belongs in it. */
  .search-demo-results {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 290px;
  }
  .search-demo-results[aria-busy='true'] {
    opacity: 0.55;
    transition: opacity 150ms ease;
  }
  .search-demo-empty {
    color: rgba(237, 234, 224, 0.5);
    font-style: italic;
    padding: 16px 4px;
    font-size: 14px;
  }

  /* Row — raised tile against the panel. Same rounded-xl corners. */
  .search-demo-row {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    background: #1f1f23;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    transition: border-color 180ms ease, background 180ms ease;
  }
  .search-demo-row:hover {
    border-color: rgba(250, 225, 148, 0.25);
    background: #232328;
  }
  .search-demo-row--hidden {
    border-style: dashed;
    border-color: rgba(239, 68, 68, 0.4);
    opacity: 0.85;
  }

  .search-demo-thumb {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 6px;
    background: #131316;
  }

  .search-demo-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .search-demo-name {
    color: #EDEAE0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-demo-brand {
    color: rgba(237, 234, 224, 0.5);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .search-demo-hidden-tag {
    color: rgba(239, 68, 68, 0.85);
    font-size: 9px;
  }

  /* Right cluster: pills + price inline */
  .search-demo-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .search-demo-pills {
    display: flex;
    gap: 4px;
  }
  .search-demo-pill {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
    line-height: 1;
  }
  .search-demo-pill--match {
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
  }
  /* the moment a pill TURNS green (added only on the gray→green
     transition, so already-green pills stay still): double grow/shrink
     flash that makes the state change unmissable */
  .search-demo-pill--pop { animation: sd-pill-pop 0.9s cubic-bezier(.3,0,.3,1); }
  @keyframes sd-pill-pop {
    0%, 100% { transform: scale(1); }
    18% { transform: scale(1.35); }
    38% { transform: scale(1); }
    58% { transform: scale(1.35); }
    78% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-demo-pill--pop { animation: none; }
  }
  .search-demo-pill--miss {
    color: rgba(237, 234, 224, 0.4);
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }
  /* the queried attribute the product does NOT have — red, not gray */
  .search-demo-pill--fail {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.35);
  }
  .search-demo-price {
    color: #EDEAE0;
    font-size: 14px;
    font-weight: 500;
    min-width: 52px;
    text-align: right;
  }

  /* Footer status — inside the panel, right-aligned, dim. */
  .search-demo-status {
    margin-top: 2px;
    padding: 0 6px;
    text-align: right;
    color: rgba(237, 234, 224, 0.4);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .search-demo-status-hidden {
    color: rgba(239, 68, 68, 0.75);
  }

  /* On narrow viewports the right cluster wraps under the info column —
     into COLUMN 2, so the pills stay left-aligned with the name/brand
     and the left column belongs to the image alone. */
  @media (max-width: 640px) {
    .search-demo-row {
      grid-template-columns: 40px 1fr;
      grid-template-rows: auto auto;
      row-gap: 6px;
      padding: 12px 14px;
    }
    .search-demo-right {
      grid-column: 2;
      justify-content: space-between;
    }
  }
</style>
