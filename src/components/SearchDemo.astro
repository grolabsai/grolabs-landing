---
/**
 * Live Meilisearch demo embedded in the landing page.
 *
 * Talks to the `demo` index over Meilisearch's REST API via a
 * search-only key (see src/scripts/search-demo.ts). The script wires
 * the input + results container after hydration. Styling lives in the
 * <style is:global> block — bespoke CSS reads cleaner here than the
 * equivalent Tailwind soup, and `is:global` means the classes survive
 * being injected by the runtime script.
 */
---

<div class="search-demo" data-search-demo>
  <label class="search-demo-input-wrap">
    <span class="material-symbols-outlined search-demo-input-icon">search</span>
    <input
      type="search"
      data-search-input
      class="search-demo-input"
      placeholder="Try: gluten-free sugar-free dairy-free"
      value="gluten-free sugar-free dairy-free"
      autocomplete="off"
      spellcheck="false"
    />
  </label>

  <div class="search-demo-results" data-search-results aria-live="polite"></div>
</div>

<script>
  import { initSearchDemo } from '../scripts/search-demo.ts';

  document.querySelectorAll<HTMLElement>('[data-search-demo]').forEach((el) => {
    initSearchDemo(el);
  });
</script>

<style is:global>
  .search-demo {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  /* Search input */
  .search-demo-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    background: #0e0e11;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 0 20px;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .search-demo-input-wrap:focus-within {
    border-color: rgba(250, 225, 148, 0.5);
    box-shadow: 0 0 0 3px rgba(250, 225, 148, 0.12);
  }
  .search-demo-input-icon {
    color: #fae194;
    font-size: 20px;
    margin-right: 10px;
    flex-shrink: 0;
  }
  .search-demo-input {
    appearance: none;
    background: transparent;
    border: 0;
    outline: 0;
    color: #EDEAE0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 16px;
    padding: 14px 0;
    width: 100%;
  }
  .search-demo-input::placeholder {
    color: rgba(237, 234, 224, 0.35);
  }

  /* Results */
  .search-demo-results {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .search-demo-results[aria-busy='true'] {
    opacity: 0.55;
    transition: opacity 150ms ease;
  }
  .search-demo-empty {
    color: rgba(237, 234, 224, 0.5);
    font-style: italic;
    padding: 16px 4px;
    font-size: 14px;
  }

  /* Row */
  .search-demo-row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    background: #1f1f23;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 9999px;
    transition: border-color 180ms ease, background 180ms ease;
  }
  .search-demo-row:hover {
    border-color: rgba(250, 225, 148, 0.25);
    background: #232328;
  }
  .search-demo-row--hidden {
    border-style: dashed;
    border-color: rgba(239, 68, 68, 0.4);
    opacity: 0.85;
  }

  .search-demo-thumb {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 8px;
    background: #131316;
  }

  .search-demo-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .search-demo-name {
    color: #EDEAE0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-demo-brand {
    color: rgba(237, 234, 224, 0.5);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .search-demo-hidden-tag {
    color: rgba(239, 68, 68, 0.85);
    font-size: 9px;
  }

  /* Right cluster: pills + price inline */
  .search-demo-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .search-demo-pills {
    display: flex;
    gap: 4px;
  }
  .search-demo-pill {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
    line-height: 1;
  }
  .search-demo-pill--match {
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
  }
  .search-demo-pill--miss {
    color: rgba(237, 234, 224, 0.4);
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .search-demo-price {
    color: #EDEAE0;
    font-size: 14px;
    font-weight: 500;
    min-width: 52px;
    text-align: right;
  }

  /* Footer status line */
  .search-demo-status {
    margin-top: 4px;
    padding: 0 20px;
    text-align: right;
    color: rgba(237, 234, 224, 0.4);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .search-demo-status-hidden {
    color: rgba(239, 68, 68, 0.75);
  }

  /* On narrow viewports the right cluster wraps under the info column
     so pills don't squeeze the name to a single character. */
  @media (max-width: 640px) {
    .search-demo-row {
      grid-template-columns: 44px 1fr;
      grid-template-rows: auto auto;
      row-gap: 6px;
      border-radius: 16px;
      padding: 12px 16px;
    }
    .search-demo-right {
      grid-column: 1 / -1;
      justify-content: space-between;
    }
  }
</style>
