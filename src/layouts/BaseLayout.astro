---
import '../styles/global.css';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const stripped = base ? path.replace(new RegExp(`^${base}`), '') : path;
const isSpanish = stripped === '/es' || stripped.startsWith('/es/');
const locale = isSpanish ? 'es' : 'en';

// Sensible defaults per locale; pages can override via props.
const defaults = {
  en: {
    title: 'GroLabs · Recover lost revenue & grow your business',
    description:
      'Recover lost revenue and grow your business without paying for more traffic. AI-assisted search, catalog, and conversion tooling for small e-commerce stores.',
    ogAlt:
      'GroLabs — recover lost revenue and grow your business without paying for more traffic.',
    nav: {
      resources: 'Resources',
      blog: 'Blog',
    },
    footer: {
      rights: 'All rights reserved.',
      privacy: 'Privacy Policy',
      terms: 'Terms of Use',
      security: 'Security',
      bookCtaNote: 'Free 15-minute call',
    },
  },
  es: {
    title: 'GroLabs · Recupera ingresos perdidos y haz crecer tu negocio',
    description:
      'Recupera los ingresos perdidos y haz crecer tu negocio sin pagar por más tráfico. Herramientas de búsqueda, catálogo y conversión asistidas por IA para tiendas pequeñas de e-commerce.',
    ogAlt:
      'GroLabs — recupera los ingresos perdidos y haz crecer tu negocio sin pagar por más tráfico.',
    nav: {
      resources: 'Recursos',
      blog: 'Blog',
    },
    footer: {
      rights: 'Todos los derechos reservados.',
      privacy: 'Política de Privacidad',
      terms: 'Términos de Uso',
      security: 'Seguridad',
      bookCtaNote: 'Llamada gratis de 15 minutos',
    },
  },
} as const;

const t = defaults[locale];

/**
 * Legal pages live on Scout (app.grolabs.ai) — same content shown
 * to authenticated customers, so a single source of truth. Scout's
 * default locale is `es` (no URL prefix), `en` is the secondary.
 * We point the EN landing at /en/legal/... and the ES landing at
 * /legal/... (default-locale path).
 */
const scoutLegalBase =
  locale === 'en'
    ? 'https://app.grolabs.ai/en/legal'
    : 'https://app.grolabs.ai/legal';
const legalUrls = {
  privacy: `${scoutLegalBase}/privacy`,
  terms: `${scoutLegalBase}/terms`,
  security: `${scoutLegalBase}/security`,
};
const {
  title = t.title,
  description = t.description,
} = Astro.props;

const home = isSpanish ? `${base}/es/` : (base || '/');
const resourcesHref = isSpanish ? `${base}/es/resources` : `${base}/resources`;
const blogHref = isSpanish ? `${base}/es/blog` : `${base}/blog`;
const siteUrl = 'https://grolabs.ai';
const ogImageUrl = `${siteUrl}${base}/og-image.png`;
const canonicalUrl = `${siteUrl}${path}`;
---

<!DOCTYPE html>
<html class="scroll-smooth" lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${base}/`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}${base}/es/`} />

    <!-- Open Graph + Twitter cards. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="GroLabs" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Organization JSON-LD — site-wide. Gives answer engines
        (ChatGPT, Claude, Gemini, Perplexity, etc.) a structured
        factual reference for "who is GroLabs?" so they don't have
        to scrape body text to compose an answer. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "GroLabs",
      "legalName": "GroLabs AI",
      "url": siteUrl,
      "logo": `${siteUrl}/grolabs-wordmark.svg`,
      "image": ogImageUrl,
      "description": "AI-agent-driven optimization layer for small e-commerce businesses. Recovers revenue lost to three failure modes: customers who can't find products, customers who aren't convinced, and customers who can't get through checkout.",
      "email": "growth@grolabs.ai",
      "sameAs": []
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Special+Elite&family=Caveat:wght@400;500;600;700&display=block"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Special+Elite&family=Caveat:wght@400;500;600;700&display=block"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    {/* Pages can inject page-specific <head> content here — typically
        JSON-LD blocks (Service, FAQPage, Article, etc.) that don't
        belong in the site-wide Organization markup above. */}
    <slot name="head-extra" />

    <Analytics />
  </head>
  <body class="font-body-md text-body-md selection:bg-primary selection:text-zinc-950 overflow-x-hidden">
    <div class="hidden md:block" id="scroll-progress">
      <div id="scroll-indicator"></div>
    </div>

    <!-- TopNavBar — on desktop, 3-column grid (logo left, nav centered,
         CTAs + LocaleSwitcher right). On mobile, flex-wrap: logo +
         right-group share row 1; Resources/Blog wrap to row 2 under
         the logo. Header height grows on mobile to fit two rows
         (h-auto py-3) and <main> compensates with pt-[120px] md:pt-20. -->
    <header
      class="fixed top-0 left-0 w-full backdrop-blur-md h-auto py-3 md:h-20 md:py-0 flex items-center px-margin-mobile md:px-margin-desktop border-b border-zinc-800 z-50 bg-canvas/80"
    >
      <div class="max-w-page mx-auto w-full flex flex-wrap items-center gap-md md:grid md:grid-cols-[1fr_auto_1fr]">
        <a href={home} class="group order-1 md:justify-self-start">
          <h1 class="font-marker text-3xl text-white leading-none group-hover:brightness-110 transition-all">GroLabs</h1>
        </a>
        {/* Right group: CTAs + LocaleSwitcher. ml-auto pushes it to
            the far right on mobile (where flex governs); md restores
            grid placement. */}
        <div class="order-2 ml-auto md:order-3 md:ml-0 md:justify-self-end flex items-center gap-md">
          <slot name="header-ctas" />
          <LocaleSwitcher />
        </div>
        {/* Nav: w-full forces it to wrap to row 2 on mobile;
            md restores inline centered placement. */}
        <nav class="order-3 w-full justify-center md:order-2 md:w-auto md:justify-self-center md:self-end flex items-center md:items-end gap-lg pt-1 md:pt-0">
          <a class="font-mono text-xs tracking-[0.2em] uppercase text-white hover:text-primary transition-colors leading-none" href={resourcesHref}>
            {t.nav.resources}
          </a>
          <a class="font-mono text-xs tracking-[0.2em] uppercase text-white hover:text-primary transition-colors leading-none" href={blogHref}>
            {t.nav.blog}
          </a>
        </nav>
      </div>
    </header>

    <main class="relative z-10 pt-[120px] md:pt-20 min-h-screen bg-transparent">
      <slot />

      <footer class="bg-canvas-deeper pt-2xl md:pt-[120px] pb-xl">
        <div class="max-w-page mx-auto px-margin-mobile md:px-margin-desktop">
          <div class="grid grid-cols-1 md:grid-cols-3 items-start gap-xl">
            {/* Left: cream/white wordmark + tagline eyebrow. The tight
                viewBox variant has no internal padding so the artwork
                fills its box edge-to-edge and aligns cleanly with the
                CTAs and links. */}
            <div class="flex flex-col gap-sm justify-self-start">
              <img
                src="/grolabs-wordmark-gray-tight.svg"
                alt="GroLabs"
                style="height: 30px; width: auto; display: block;"
              />
              <span class="font-mono tracking-[0.2em] text-xs uppercase text-zinc-500">
                Recover lost revenue
              </span>
            </div>

            {/* Center: yellow-gradient Book CTA + ghost Contact — same
                styling as the hero CTAs. The Book CTA carries an
                eyebrow-style "free 15-min call" caption directly
                below it.
                items-start so the Contact ghost pins to the TOP of the
                Book CTA instead of centering against (Book + caption),
                matching the hero treatment. */}
            <div class="flex flex-wrap md:flex-nowrap items-start justify-start md:justify-center gap-sm">
              <div class="flex flex-col items-start md:items-center gap-1">
                <a
                  href="https://cal.com/tuncho-granados-uibzst/15min"
                  class="footer-cta footer-cta--primary cta-button-style"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-booking-cta
                >
                  Book growth assessment call
                </a>
                <span class="font-mono tracking-[0.2em] text-[10px] uppercase text-zinc-500">
                  {t.footer.bookCtaNote}
                </span>
              </div>
              <a
                href="mailto:growth@grolabs.ai"
                class="footer-cta footer-cta--ghost self-start"
              >
                Contact
              </a>
            </div>

            {/* Right: nav links on top, copyright underneath — all gray.
                The three legal pages live on Scout; URLs are built per
                locale at the top of the frontmatter. */}
            <div class="flex flex-col items-start md:items-end gap-sm">
              <div class="flex flex-wrap gap-lg">
                <a class="font-body-sm text-body-sm text-zinc-500 hover:text-zinc-300 transition-colors" href={legalUrls.privacy}>{t.footer.privacy}</a>
                <a class="font-body-sm text-body-sm text-zinc-500 hover:text-zinc-300 transition-colors" href={legalUrls.terms}>{t.footer.terms}</a>
                <a class="font-body-sm text-body-sm text-zinc-500 hover:text-zinc-300 transition-colors" href={legalUrls.security}>{t.footer.security}</a>
              </div>
              <p class="font-body-sm text-body-sm text-zinc-500">
                © <span id="footer-year"></span> GroLabs AI. {t.footer.rights}
              </p>
            </div>
          </div>
        </div>
      </footer>
    </main>

    <ConsentBanner locale={locale} />

    <script>
      import '../scripts/main.ts';
    </script>

    <style is:global>
      /* ─────────── Primary CTA — reusable, hero-style ───────────
         Yellow gradient (lighter top → deeper bottom), dark text,
         soft yellow halo. Same look as the hero CTA so the footer
         and any other surface can reuse it via .cta-button-style
         + .footer-cta classes. */
      .cta-button-style {
        background: linear-gradient(180deg, #fbe9a8 0%, #fae194 55%, #f0d770 100%);
      }
      .footer-cta {
        font-family: "Hanken Grotesk", sans-serif;
        font-weight: 600;
        font-size: 15px;
        padding: 14px 28px;
        border-radius: 8px;
        border: 1px solid transparent;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: transform .15s, box-shadow .2s, background .2s, color .2s, border-color .2s;
      }
      .footer-cta--primary {
        color: #1A1A1A;
        box-shadow:
          inset 0 1px 0 rgba(255,255,255,0.35),
          0 8px 24px -4px rgba(250,225,148,0.35);
      }
      .footer-cta--primary:hover { transform: translateY(-1px); }
      .footer-cta--ghost {
        background: transparent;
        color: rgba(237, 234, 224, 0.55);
        border-color: rgba(237, 234, 224, 0.35);
      }
      .footer-cta--ghost:hover {
        color: rgba(237, 234, 224, 0.9);
        border-color: rgba(237, 234, 224, 0.6);
      }
    </style>
  </body>
</html>
