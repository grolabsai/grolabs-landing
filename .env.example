# GroLabs landing — environment configuration
# ----------------------------------------------------------------------
# Copy this file to `.env` (not committed) and fill in the values.
# Astro exposes any var prefixed with PUBLIC_ to client-side code at
# build time — fine for URLs that are meant to be public anyway.

# Booking URL for the hero's "Book a free 15-minute consultation call"
# button. Paste the hosted booking page URL from your provider here.
# Examples:
#   https://cal.com/grolabs/15min
#   https://calendly.com/grolabs/15min
#   https://savvycal.com/grolabs/intro
#
# If unset, the button falls back to mailto:growth@grolabs.ai so the
# page still works in development without a booking provider configured.
PUBLIC_BOOKING_URL=

# Scout base URL — where the free diagnostic widget POSTs to
# `/api/v1/diagnostic/runs` and where the report page lives at
# `/diagnostics/{run_id}`. Required for the diagnostic widget to be
# functional; when unset, the widget renders disabled with a
# "coming soon" label.
#
# Examples:
#   https://scout.grolabs.ai
#   https://app.grolabs.ai
#
# The Scout API allows CORS `*`, so any landing-page host can call it.
PUBLIC_SCOUT_API_URL=

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Found in
# the GA4 console under Admin → Data streams → your web stream. When set,
# the site loads GA4 with Consent Mode v2 (default-denied) and shows the
# cookie consent banner. When unset, no analytics or banner render at all.
PUBLIC_GA4_ID=

# Cloudflare Stream iframe URL for the homepage video (below the hero).
# Copy the iframe `src` from the video's "Embed" tab in the Cloudflare
# Stream dashboard — it looks like:
#   https://customer-<code>.cloudflarestream.com/<video-id>/iframe
# Use the iframe URL (the /iframe path), NOT the .m3u8/manifest URL.
#
# When unset, the video section renders nothing at all, so local dev and
# any unconfigured environment stay clean (same graceful-fallback pattern
# as PUBLIC_BOOKING_URL and PUBLIC_GA4_ID). PUBLIC_ vars are baked at
# BUILD time, so production needs a fresh deploy (no build cache) after
# this is set for the video to appear.
#
# Swapping the video is a ONE-VARIABLE change: just point this at the new
# video's /iframe URL. The poster thumbnail and the player are both
# derived from it — no code edit needed.
PUBLIC_CF_STREAM_URL=

# Poster frame for the video preview (optional). A timestamp like "60s"
# grabs that frame from the configured video as the thumbnail. Leave unset
# to use the thumbnail you set with the scrubber in the Cloudflare Stream
# dashboard. The thumbnail URL is derived from PUBLIC_CF_STREAM_URL, so you
# never hardcode a video ID here.
PUBLIC_CF_STREAM_POSTER_TIME=

# Video length shown in the "Play … video" button (optional). Just the
# number of minutes, e.g. "1.5" → button reads "Play 1.5 minute video"
# (ES: "Reproducir video de 1.5 minutos"). Leave unset for a generic
# "Play video" / "Ver video" label.
PUBLIC_CF_VIDEO_MINUTES=
