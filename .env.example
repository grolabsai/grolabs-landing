# GroLabs landing — environment configuration
# ----------------------------------------------------------------------
# Copy this file to `.env` (not committed) and fill in the values.
# Astro exposes any var prefixed with PUBLIC_ to client-side code at
# build time — fine for URLs that are meant to be public anyway.

# Booking URL for the hero's "Book a free 15-minute consultation call"
# button. Paste the hosted booking page URL from your provider here.
# Examples:
#   https://cal.com/grolabs/15min
#   https://calendly.com/grolabs/15min
#   https://savvycal.com/grolabs/intro
#
# If unset, the button falls back to mailto:growth@grolabs.ai so the
# page still works in development without a booking provider configured.
PUBLIC_BOOKING_URL=
